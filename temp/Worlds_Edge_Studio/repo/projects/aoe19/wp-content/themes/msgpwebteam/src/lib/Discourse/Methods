<?php

namespace Roots\Discourse;

class Methods {

    static public function postAPI($url, $data, $args = [], $headers = [], $reqType = 'POST'){
        $output = false;

        $ch = curl_init($url);
        $a = array_replace([
            CURLOPT_CUSTOMREQUEST => $reqType,
            CURLOPT_POSTFIELDS => $data,
            CURLOPT_RETURNTRANSFER => 1,
            CURLOPT_TIMEOUT => 30,
        ], $args);
        if(!empty($headers)){
            curl_setopt($ch, CURLOPT_HTTPHEADER, $headers);
        }
        curl_setopt_array($ch, $a);
        $result = curl_exec($ch);

        if(!(curl_getinfo($ch,CURLINFO_HTTP_CODE) == 200 || curl_getinfo($ch,CURLINFO_HTTP_CODE) == 201 || curl_getinfo($ch,CURLINFO_HTTP_CODE) == 204)){
            error_log('Discourse API ERROR:('.$reqType.') Code:' . curl_getinfo($ch,CURLINFO_HTTP_CODE) . ' URL: ' . $url . ' Description: ' . $result);
        }

        $output = [
            "code" => curl_getinfo($ch,CURLINFO_HTTP_CODE),
            "response" => $result
        ];

        curl_close($ch);

        return $output;
    }

}