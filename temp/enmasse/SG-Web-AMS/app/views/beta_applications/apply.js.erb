$('#beta-message').html("<%= @message %>");
<% if(@error) %>
  $('#beta-message').addClass('error');
<% else %>
  $('#beta-message').removeClass('error');
  $('.beta-details').remove();
  $('form#beta-code').remove();
<% end %>
$('#beta-message').show();
<% if @beta_app %>
$('#beta-status').html("<%= @beta_app.status %>");
<% end %>
