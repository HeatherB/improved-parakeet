<div class="payment-popup" id="payment-confirm" style="display: none;">
  <div class="heading">
    <h2><%= tslt('Server Transfer') %></h2>
  </div>

  <div class="purchase-info">
    <div class="purchase-image">
      <%= image_tag "character_transfer/server-transfer.jpg", :class => "double-border", :alt => tslt('Server Transfer') %> 
    </div>
    <div class="purchase-description">
      <p><%= tslt('server transfer description') %></p>
    </div>
  </div>

  <div class="payment-actions">
    <div class="payment-transfer-description">
      <div class="name">
        <%= tslt('transfer_character') %> <span class="character-name white"></span>
      </div>
      <div class="servers">
        <span><%= tslt('transfer_from') %> <span class="from-server white"></span> <%= image_tag "character_transfer/arrow.png", :class => "arrow" %> <%= tslt('transfer_to') %> <span class="to-server white"></span>
      </div>
    </div>

    <div class="price-description">
      <table>
        <tbody>
        <tr>
          <td><%= tslt('transfer_balance') %></td>
          <td>
            <span class="emp-icon"></span>
          </td>
          <td>
            <span class="balance"></span>
          </td>
        </tr>
        <tr>
          <td><%= tslt('transfer_price') %></td>
          <td>
            <span class="emp-icon"></span>
          </td>
          <td>
            <span class="normal-price"><%= purchase_info[:original_price] %></span>
          </td>
        </tr>
        <% if purchase_info[:discount] > 0 %>
        <tr>
          <td><%= tslt('transfer_discount') %></td>
          <td>
            <span class="emp-icon"></span>
          </td>
          <td>
            <span class="sale-amount"><%= "-#{purchase_info[:discount]}" %></span>
          </td>
        </tr>
        <% end %>
        </tbody>
      </table>
    </div>

    <hr />

    <div class="actions">
      <div class="pull-right">
        <a id="close-without-buying" href="javascript:void(0);"><%= tslt('close without buying') %></a>
        <a class="btn blue clickable" id='btn-confirm'>
          <%= tslt('transfer_buy_for') %><span class="emp-icon"></span><span class="purchase-amount"><%= purchase_info[:price] %></span>
        </a>
      </div>
    </div>
  </div>

  <div class="error-messages">
    <% emp_url = SECURE_CONFIG["enmasse"]["emp_purchase_url"] rescue SHOP_URL %>
    <span class="icon"></span>
    <span class="error-message">You don't have enough EMP to buy this item. Perhaps you would like to <a href="<%= emp_url %>">buy some EMP</a>?</span>
  </div>
</div>
