<div id='transfer-history'>
  <h2><%= tslt('transfer history') %></h2>
  <% @transfers.each do |transfer| %>
    <div class="transfer <%= cycle "even", "odd" %>" data-transfer-id="<%= transfer.id %>">
      <span class="date"><%= transfer.created_at.strftime("%b %d, %Y") %></span>
      <%= tslt('transferring') %>
      <span class="character-name"><%= transfer.character_name %></span>
      <%= tslt('from') %>
      <span class="from"><%= transfer.from_server_name %></span>
      <%= tslt('to') %>
      <span class="to"><%= transfer.to_server_name %></span>

      <% transfer[:status] = 1 if transfer.status == 0 %>

      <%= image_tag "character_transfer/transfer-#{CharacterTransfer::STATUS[transfer.status].downcase}-btn.png", :class => 'pull-right transfer-history-status' %>
    </div>
  <% end %>
</div>

<div id='transfer-history-popup-container' class='transfer-popup'>
</div>
