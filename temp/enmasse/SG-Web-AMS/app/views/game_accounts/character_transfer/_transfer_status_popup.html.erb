<script>
  $(document).bind('cbox_closed', function(){
    $.colorbox({ inline: true,
                 href: '#transfer-status-popup',
                 onOpen: function() {
                   $('#transfer-status-popup').show();
                 },
                 onCleanup: function() {
                   $('#transfer-status-popup').hide();
                   window.location.reload();
                 }
               });
    $(document).unbind('cbox_closed');
  });
</script>

<div id="transfer-status-popup" style="display: none;">
  <div class="heading">
    <h2><%= tslt('transfer a character') %></h2>
  </div>
  <div class="transfer-description">
    <span class="date white"><%= Time.now.strftime("%b %d, %Y") %></span>
    <%= tslt('transferring') %>
    <span class="character-name white"><%=h @character_transfer.character_name %></span>
    <%= tslt('from') %>
    <span class="from-server white"><%=h @character_transfer.from_server_name %></span>
    <%= tslt('to') %>
    <span class="to-server white"><%=h @character_transfer.to_server_name %></span>
  </div>

  <div class="transfer-status-description">
    <%= tslt('transfer received description') %>
  </div>
  <div class="transfer-actions">
    <a class="btn grey clickable" id='btn-close'><%= tslt('close window') %></a>
    <script>
      $('#btn-close').click(function() { $.colorbox.close(); });
    </script>
  </div>
</div>
