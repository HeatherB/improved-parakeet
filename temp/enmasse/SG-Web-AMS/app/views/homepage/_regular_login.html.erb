<% content_for :facebook do %>
  <%= render :partial => "shared/facebook" %>
<% end %>
<section id="open-signedin">
	<h2 class="heading">Log in to your En Masse account by Facebook Login or entering your credentails below.</h2>
	<div class="wrapper">
		<div class="leftCol">
			<button type="button" value="fb-login" class="fb-login login-facebook-link">Log in with Facebook</button>
			<p class="console-callout">To login with your XBOX or Playstation Network ID 
			<button type="button" class="console-callout">Click Here</button>.</p>
			<!--<p class="console-callout">To login with your XBOX or Playstation Network ID <%#= link_to 'Click Here', fetch_console_login_path(), :remote => true, :class => 'console-callout' %>.</p>-->
		</div>
		<div class="rightCol">
		<% newsletter = defined?(newsletter) && newsletter ? newsletter : false %>
	    <%  locals = { :url => signin_submit_url}
	      	locals[:return_to] = return_to if defined?(return_to)
	      	locals[:newsletter] = newsletter if newsletter
	      	locals[:fail_to] = fail_to if defined?(fail_to)
	  	%>

	  	<%= render :partial => "shared/default_login_form", :locals => locals %>
