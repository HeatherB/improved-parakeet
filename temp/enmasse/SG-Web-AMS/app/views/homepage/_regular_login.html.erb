				<div class="leftCol">
					<button type="submit" value="login" class="buttonYellow login_btn">LOGIN</button>
				</div>
				<div class="rightCol">
					<p>If you don't have an account, you can <a href="http://<%#= Rails.application.config.account_server %>">SIGNUP HERE.</a></p>
