<section id="open-signedout">
	<div class="wrapper">
	  <p>We work hard to find <strong>quality games</strong> that you can <strong>play for free.</strong></p>
	  <p>We've got a full team working hard to make your game experience as seamless and fun as possible.</p>
	  <div class="leftCol">
	    <div class="block">
	      <a href="http://<%= Rails.application.config.account_server %>/sign-up" class="buttonYellow">Create Account</a>
	      <p><strong>Signup today</strong> to get access to our <strong>entire game library.</strong></p>
	    </div>
	  </div>
	  <div class="rightCol">
	    <div class="block">
	   		<button type="button" class="buttonYellow showRegLogin">Log In</button>
	      <%#= button_to 'Log In', fetch_regular_login_path(), :remote => true, :class => 'buttonYellow' %>
	      <p>Log in to your existing<br />En Masse account.</p>
	    </div>
	  </div>
	</div>
</section>