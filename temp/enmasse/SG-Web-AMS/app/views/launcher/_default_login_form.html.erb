<% if @global_alerts && @global_alerts.size > 0 %>
  <%= render :partial => "shared/global_alerts" %>
<% else %>
  <div id="global-alerts"></div>
<% end %>
<%= form_for :user, :url => url, :html => { :id => "popup-login-form", :class => "login-form", :'data-io-bb' => "user_io_black_box", :name => "login" } do |f| %>
  <%= f.hidden_field :client_time %>
  <%= f.hidden_field :rt, :value => @requestId if @requestId.present? %>
  <%= f.hidden_field :rid, :value => params[:rid] if params[:rid].present? %>
  <%= f.hidden_field :io_black_box %>
  <%= hidden_field_tag :game_id, @game.id %>
  <div class="heading">
    <%= link_to "", "javascript:void(0);", :class => "launcher-facebook-link login-facebook-btn", :title => tslt("sign in with facebook") %>
  </div>
  <div class="or"><%= tslt("or") %></div>
  <div class='input-text'>
    <input id="user_email" class="field focus" type="text" size="30" name="user[email]" placeholder="E-mail Address">
  </div>

  <div class='input-text'>
    <input id="user_password" class="field" type="password" size="30" name="user[password]" placeholder="Password" autocomplete="off">
  </div>

  <div class='account-links'>
    <%= link_to('Create an account!', launcher_user_new_url(params[:launcher_id]) ) %> | <%= link_to('Problems logging in?', password_reset_users_url, :target => :blank ) %>
  </div>

  <div class="login-btn controls">
    <div id="remember_div">
      <input id="remember_username" type="checkbox">
        <label id="remember_label" class="unchecked" for="remember_username">
          <span id="remember_text">Remember my username</span>
        </label>
    </div>
    <a id="launcher-submit-link" class="submit-link login-submit-link btn-login" href="#" data-form="popup-login-form">
      <span><%= tslt("log in")%></span>
    </a>
  </div>
<% end %>

<script>
  $(function() {
    $('#user_client_time').val(Date(Date.UTC()));
  });

  // Hook the checkbox to tell the launcher if it should remember the user or not
  $('#remember_username').change(function() {
    parent.rememberMe = $('#remember_username').is(':checked');
    if($('#remember_username').is(':checked')) {$('#remember_label').css({'background-position':'0px 0px'})}
    else {$('#remember_label').css({'background-position':'0px -17px'})}
  });

  $(document).keypress(function(event) {
    if (event.which == 32) {
      if($('#user_email').is(":focus")) {/*alert("email has focus");*/}
      else if ($('#user_password').is(":focus")) {/*alert("password has focus");*/}
      else {$('#remember_username').trigger('click');}
    }
  });
</script>
