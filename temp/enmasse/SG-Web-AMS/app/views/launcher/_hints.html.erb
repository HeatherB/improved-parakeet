<div id="user_email-hint" class="hint-text">
  <%= tslt("youll use your email address to log in")%>
</div>
<div id="user_email-warning" class="hint-text">
  <p><%= tslt("the email address you entered is invalid")%></p>
  <p class="server-error"><%= "Email #{@user.errors[:email]}" if @user.errors[:email].present? %></p>
</div>

<div id="user_email_confirmation-warning" class="hint-text">
  <p>
    <% if @user.errors[:email_confirmation].present? %>
      <%= tslt("email confirmation")%> <%= @user.errors[:email_confirmation] %>
    <% else %>
      <%= tslt("your email confirmation will need to match your email address")%>
    <% end %>
  </p>
</div>

<div id="user_password-hint" class="hint-text">
  <ul>
    <li><%= tslt("greater than 8 characters")%></li>
    <li><%= tslt("fewer than 99 characters")%></li>
    <li><%= tslt("contains at least two of the following types")%></li>
    <li><%= tslt("does not contain your email name")%></li>
  </ul>
</div>

<div id="user_password-warning" class="hint-text">
  <p>The password you have provided does not meet the minimum requirements.</p>
</div>

<div id="user_password_confirmation-hint" class="hint-text">
  <p><%= tslt("please retype your password")%></p>
</div>

<div id="user_password_confirmation-warning" class="hint-text">
  <p>
    <% if @user.errors[:password_confirmation].present? %>
      <%= tslt("password confirmation")%> <%= @user.errors[:password_confirmation] %>
    <% else %>
      <%= tslt("the password confirmation will need to match your password")%>
    <% end %>
  </p>
</div>

<div id="user_secret_question_id-hint" class="hint-text">
  <p><%=tslt("be sure to remember the secret question")%></p>  
  <p>
    <%= tslt("please select a secret question from the list and provide your answer")%>
  </p>  
</div>
<div id="user_secret_question_id-warning" class="hint-text">
  <p>
    <%= tslt("please select a secret question from the list and provide your answer")%>
  </p>
</div>

<div id="user_secret_answer-hint" class="hint-text">
  <p><%= tslt("be sure to remember the secret question and answer that you provide")%></p>  
  <p><%= tslt("please select a secret question from the list and provide your answer")%></p>  
</div>
<div id="user_secret_answer-warning" class="hint-text">
  <p><%= tslt("please input a secret answer")%></p>  
</div>

<div id="user_date_of_birth_year-hint" class="hint-text">
  <p><%= tslt("you must be 13 years of age or older to register")%></p>  
</div>
<div id="user_date_of_birth_month-hint" class="hint-text">
  <p><%= tslt("you must be 13 years of age or older to register")%></p>  
</div>
<div id="user_date_of_birth_day-hint" class="hint-text">
  <p><%= tslt("you must be 13 years of age or older to register")%></p>  
</div>
<div id="user_date_of_birth_year-warning" class="hint-text">  
  <% if @user.errors[:age].present? %>
    <p><%=tslt("age")%> <%= @user.errors[:age] %></p>
  <% else %>
    <p><%= tslt("the date of birth entered is invalid")%></p>
  <% end %>
</div>
<div id="user_date_of_birth_month-warning" class="hint-text">  
  <% if @user.errors[:age].present? %>
    <p><%=tslt("age")%> <%= @user.errors[:age] %></p>
  <% else %>
    <p><%= tslt("the date of birth entered is invalid")%></p>
  <% end %>
</div>
<div id="user_date_of_birth_day-warning" class="hint-text">  
  <% if @user.errors[:age].present? %>
    <p><%=tslt("age")%> <%= @user.errors[:age] %></p>
  <% else %>
    <p><%= tslt("the date of birth entered is invalid")%></p>
  <% end %>
</div>