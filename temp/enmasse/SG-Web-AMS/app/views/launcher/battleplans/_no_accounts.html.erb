<% if @wait_for_account %>
<script type="text/javascript">
  GAME_ID = <%= @game.id %>;
  hasGameAccount(0);
</script>
<% end %>
<link href='https://fonts.googleapis.com/css?family=Amaranth' rel='stylesheet' type='text/css'>
<div id="content-launcher" class='content-launcher' data-id="#{params[:id]}">
  <%= render :partial => "shared/flash_notices" %>
  <div class='clear'></div>
  <p class="modalControl"><a href="#" id="close" class="close textReplacement" onClick="window.parent.CloseVerifyFrame();">Close Modal</a></p>
  <div class='listing no-accounts'>
    <div class='listing-head'></div>
    <div class='listing-body'>
      <p class='message'>You cannot create a game account without a beta key.</p>
      <p class='message'><%= link_to "Sign up for the Battleplans PC beta test today!", "http://play-battleplans.com", :target => "_blank" %></p>
      <% if @wait_for_account %>
      <p id="standByMsg" class="standByMsg"><%= tslt("message_creating_game_account_launcher_cont") %><span class="one">.</span><span class="two">.</span><span class="three">.</span></p>
      <div id="refreshBtn">
        <p class="standByMsg"><%= tslt("message_creating_game_account_launcher_error") %></p>
        <div class='options'>
          <p><%= link_to(tslt('refresh'), launcher_path(@game.id)) %></p>
        </div><!--.options-->
      </div>
      <% end %>
    </div><!--.listing-body-->
    <div class='listing-foot'></div>
  </div><!--.no-accounts-->
</div><!--#launcher-->

<script>
$(document).ready(function() {
    $('#app-launcher').addClass('openPop');
    var parent_washout = window.parent.document.getElementById('washOut');
    parent_washout.style.zIndex = '998';
    parent_washout.style.display = 'block';
});
</script>

<style type="text/css">
.modalControl {
  position: absolute;
  right:10px;
  margin-left: 0;
  top:10px;
}
.modalControl a#close {
  display:block;
  text-indent:-9999em;
  background: url('/assets/launcher/battleplans/windowControls.png') top right no-repeat;
  width:25px;
  height:20px;
}
/* open various messes in popup */
  .openPop {
    position:absolute;
    top:0;
    right:0;
    left:0;
    margin:0 auto;
    width:700px;
    height:520px;
    height:100%;
  }
  .openPop#app-launcher .content-launcher:before {
    display:none;
  }
  .openPop#app-launcher .content-launcher {
    background: rgb(0,0,0);
    background: rgba(0,0,0,0.8);
    color: #ffffff;
    font-size:18px;
    font-family: 'Amaranth', sans-serif;
    width:660px;
    height:100%;
    min-height:260px;
    border-radius: 10px;
  }
  .openPop#app-launcher .listing {
    max-width:600px;
    width:100%;
  }
  .openPop#app-launcher .listing .listing-head {
    background: none;
  }
  .openPop#app-launcher .listing .listing-body {
    color: #ffffff;
    background: none;
    font-size:18px;
    font-family: 'Amaranth', sans-serif;
    max-width:600px;
    width:100%;
  }
  .openPop#app-launcher .listing .listing-body .message a {
    color:#fc6f0c;
  }
  .openPop#app-launcher .listing .listing-foot {
    background: none;
  }
  .openPop#app-launcher h1,h2,h3,h4,h5,h6 {
    color:#fc6f0c;
    text-transform:uppercase;
    font-size:24px;
  }
</style>
