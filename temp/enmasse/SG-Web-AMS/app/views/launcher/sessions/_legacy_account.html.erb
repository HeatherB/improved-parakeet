<%= render :partial => "shared/flash_notices" %>
<div class='content-launcher'>
  <div class='clear'></div>
  <div class='listing no-accounts'>
    <div class='listing-head'></div>
    <div class='listing-body'>
      <p class='message'><%= tslt("please complete the setup of your new En Masse account") %></p>
      <div class='options'>
        <p>
          <%= link_to(tslt("continue"), complete_password_reset_user_url(@legacy_user.screen_name, :ticket => @legacy_user.forgot_password_key), :target => :blank) %>
          <p class='or'><%= tslt("then") %></p>
          <p><%= link_to(tslt("log in").titleize, launcher_signin_url(params[:launcher_id])) %></p>
        </p>
      </div><!--.options-->
    </div><!--.listing-body-->
    <div class='listing-foot'></div>
  </div><!--.no-accounts-->
</div><!--#launcher-->