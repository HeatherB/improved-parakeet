<% if @referrer.nil? || @referrer != "steam" %>
  <% content_for :facebook do %>
    <%= render :partial => "launcher/sessions/fb" %>
  <% end %>
<% end %>

<div class='content-launcher index'>
  <%= render :partial => "shared/flash_notices" %>
  <div id="login">
    <%= render :partial => "launcher/zmr_login_form", :locals => { :url => launcher_signin_submit_url(params[:launcher_id]) } %>
  </div>
  <div class='account-links'>
    <%= link_to('Create account', launcher_user_new_url(params[:launcher_id]) ) %> | <%= link_to('Login Problems?', password_reset_users_url, :target => :blank ) %>
  </div>
</div>
