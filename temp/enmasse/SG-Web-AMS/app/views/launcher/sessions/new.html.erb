<% content_for :facebook do %>
  <div id="fb-root"></div>
  <script type="text/javascript">
    window.fbAsyncInit = function() {
      FB.init({
        appId  : "<%= SECURE_CONFIG['facebook']['id'] %>",
        status : true,
        cookie : true,
        xfbml  : true,
        version: 'v2.6'
      });

      var permissions = 'email,user_birthday,user_friends';

      $('.launcher-facebook-link').click(function(e) {
        e.preventDefault();

        _gaq.push(['_trackEvent', 'Accounts', 'Start Facebook Connect Process', 'login']);

        if (FB_TOKEN.length) {
          var blackbox = $("#blackbox").val();

          if (blackbox) {
            var data = { blackbox: blackbox, in_launcher: true, encrypted_token: FB_TOKEN };

            if ($("#game_id").length > 0) {
              var gameId = $("#game_id").val();
              data['game_id'] = gameId;
            }

            var jqxhr = $.ajax({
              method: "GET",
              url: "/auth/facebook/signin",
              data: data
            }).done(function(data) {
              if (data.success) {
                if (data.encrypted_token) {
                  postToLauncher("fbToken:" + data.encrypted_token);
                }
              } else {
                postToLauncher("fbToken:");
              }
              window.location.href = data.redir;
            });
          } else {
            window.location.reload();
          }
        } else {
          var width = 440;
          var height = 390;
          var left = (screen.width/2)-(width/2);
          var top = (screen.height/2)-(height/2);
          var url = "https://www.facebook.com/v2.6/dialog/oauth?display=popup&client_id=<%= SECURE_CONFIG['facebook']['id'] %>&redirect_uri=<%= provider_redirect_url(:provider => 'facebook') %>&scope=" + permissions;
          var popup = window.open(url, "facebook_popup", "menubar=no,toolbar=no,status=no,width="+width+",height="+height+",toolbar=no,left="+left+",top="+top);
          popup.focus();
          var timer = setInterval(function() {
            if (popup.closed) {
              clearInterval(timer);
              handleFacebookLogin(true);
            }
          }, 500);
        }
      });

      $(document).trigger('fbInit');
    };

    (function(d) {
      var js, id = 'facebook-jssdk'; if (d.getElementById(id)) {return;}
      js = d.createElement('script'); js.id = id; js.async = true;
      js.src = "//connect.facebook.net/en_US/sdk.js";
      d.getElementsByTagName('head')[0].appendChild(js);
    }(document));
  </script>
<% end %>

<div class='content-launcher index'>
  <%= render :partial => "shared/flash_notices" %>
    <% if @game.name == "ZMR" %>
      <div id="login">
      <%= render :partial => "launcher/zmr_login_form", :locals => { :url => launcher_signin_submit_url(params[:launcher_id]) } %>
      </div>
      <div class='account-links'>
      <%= link_to('Create account', zmr_users_new_url, :target => :blank ) %> | <%= link_to('Login Problems?', password_reset_users_url, :target => :blank ) %>
      </div>
    <% elsif @game.name.downcase == "battleplans" %>
      <div id="login">
      <%= render :partial => "launcher/battleplans_login_form", :locals => { :url => launcher_signin_submit_url(params[:launcher_id]) } %>
      </div>
      <div class='account-links'>
      <%= link_to('Create an account!', users_new_url, :target => :blank ) %> | <%= link_to('Problems logging in?', password_reset_users_url, :target => :blank ) %>
      </div>
    <% else %>
      <div id="login">
      <%= render :partial => "launcher/default_login_form", :locals => { :url => launcher_signin_submit_url(params[:launcher_id]) } %>
      </div>
      <div class='account-links'>
      <%= link_to('Create an account!', users_new_url, :target => :blank ) %> | <%= link_to('Problems logging in?', password_reset_users_url, :target => :blank ) %>
      </div>
    <% end %>
</div>

