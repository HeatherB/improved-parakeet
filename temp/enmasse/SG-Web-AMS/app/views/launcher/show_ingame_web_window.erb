    <script type="text/javascript">
        var id = <%= @id %>;
        var GAME_SETTINGS_TABLE = {};

        try {
            _tera_client_proxy_
        }
        catch(err) {
            _tera_client_proxy_ = null;
        }

        if (_tera_client_proxy_) {
            if (id > 0) {
                _tera_client_proxy_.invoke_menu(id);
            }
        }
        else {
            <% @game_settings.each do |row| -%>
            GAME_SETTINGS_TABLE["<%= escape_javascript(row.key) %>"] = "<%= escape_javascript(row.value) %>";
            <% end -%>
            var popupUrl = GAME_SETTINGS_TABLE['url_' + id.toString()] || null;
            var GAME_ID = 1;
            var serverId = 9999;
            var characterId = 1;

            if (popupUrl) {
                var ticket = "";
                $.ajax({
                    type: "POST",
                    async: false,
                    data: {server_id: serverId, character_id: characterId},
                    dataType: 'json',
                    url: "/launcher/" + GAME_ID + "/sso_auth_ticket",
                    success: function (data) {
                        ticket = data.ticket;
                    }
                })
                window.location = location.protocol + "//"+ location.host + "/launcher/auth_forward_url?next=" + encodeURIComponent(popupUrl) + "&ticket=" + ticket;
            }
        }
    </script>

