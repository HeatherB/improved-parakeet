<%= render :partial => '/launcher/battleplans_launcher_style' %>
<link href='https://fonts.googleapis.com/css?family=Amaranth' rel='stylesheet' type='text/css'>
<div class='content-launcher index'>
  <div class="logo"></div>
  <%= render :partial => "shared/flash_notices" %>
  <div class="content">
    <p class="modalControl"><a href="#" id="close" class="close textReplacement" onClick="window.parent.CloseVerifyFrame();">Close Modal</a></p>
    <p class="flash">Please enter the verification code we sent to your email. (<%= link_to(tslt("resend e mail"), launcher_resend_activation_path(@game.id, @user.screen_name, :ticket => @user.resend_activation_ticket)) %>?)</p>
    
    <%= form_tag("/launcher/#{@game.id}/activate") do %>
      <input type="hidden" name="account_id" value="<%= @user.id %>">
      <ul>
        <li>
          <input type="text" name="activation_code" placeholder="verification code">
        </li>
        <li>
          <label for="secret_question_id">Select a Secret Question:</label>
          <%= select_tag :secret_question_id, options_for_select( SecretQuestion.active.collect { |q| [q.question, q.id] }) %>
        </li>
        <li>
          <input type="text" name="secret_question_answer" placeholder="Secret Answer">
        </li>
      </ul>
      <input id="activate" type="submit" value="Confirm">
    <% end %>
  </div>
</div>


<script type="text/javascript">
  if (typeof parent.OnUpdateGame === 'function') {
      // start updating game
      parent.OnUpdateGame();
  }
</script>

<script>
$(document).ready(function() {
    $('#app-launcher').addClass('openPop');
    var parent_washout = window.parent.document.getElementById('washOut');
    parent_washout.style.zIndex = '998';
    parent_washout.style.display = 'block';
});
</script>

<style type="text/css">
.modalControl {
  position: relative;
  right:0;
  margin-left: 590px;
  margin-top:-10px;
}
.modalControl a#close {
  display:block;
  text-indent:-9999em;
  background: url('/assets/launcher/battleplans/windowControls.png') top right no-repeat;
  width:25px;
  height:20px;
}
/* open various messes in popup */
  .openPop {
    position:absolute;
    top:0;
    right:0;
    left:0;
    margin:0 auto;
    width:700px;
    height:520px;
    height:100%;
  }
  .openPop#app-launcher .content-launcher:before {
    display:none;
  }
  .openPop#app-launcher .content-launcher {
    background: rgb(0,0,0);
    background: rgba(0,0,0,0.8);
    color: #ffffff;
    font-size:18px;
    font-family: 'Amaranth', sans-serif;
    width:660px;
    height:100%;
    min-height:260px;
    border-radius: 10px;
  }
  .openPop#app-launcher .listing {
    max-width:470px;
    width:100%;
  }
  .openPop#app-launcher .listing .listing-head {
    background: none;
  }
  .openPop#app-launcher .listing .listing-body {
    color: #ffffff;
    background: none;
    font-size:18px;
    font-family: 'Amaranth', sans-serif;
    max-width:470px;
    width:100%;
  }
  .openPop#app-launcher .listing .listing-foot {
    background: none;
  }
  .openPop#app-launcher h1,h2,h3,h4,h5,h6 {
    color:#fc6f0c;
    text-transform:uppercase;
    font-size:24px;
  }
</style>


