<%= render :partial => '/launcher/tera_launcher_style' %>
<div class='content-launcher index'>
  <div class="logo"></div>
  <%= render :partial => "shared/flash_notices" %>
  <div class="content">
    <p class="flash">Please enter the verification code we sent to your email. (<%= link_to(tslt("resend e mail"), launcher_resend_activation_path(@game.id, @user.screen_name, :ticket => @user.resend_activation_ticket)) %>?)</p>
    
    <%= form_tag("/launcher/#{@game.id}/activate") do %>
      <input type="hidden" name="account_id" value="<%= @user.id %>">
      <ul>
        <li>
          <input type="text" name="activation_code" placeholder="verification code">
        </li>
        <li>
          <label for="secret_question_id">Select a Secret Question:</label>
          <%= select_tag :secret_question_id, options_for_select( SecretQuestion.active.collect { |q| [q.question, q.id] }) %>
        </li>
        <li>
          <input type="text" name="secret_question_answer" placeholder="Secret Answer">
        </li>
      </ul>
      <input id="activate" type="submit" value="Confirm">
    <% end %>
  </div>
</div>


<script type="text/javascript">
  if (typeof parent.OnUpdateGame === 'function') {
      // start updating game
      parent.OnUpdateGame();
  }
</script>
