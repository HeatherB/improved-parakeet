<%= render :partial => '/launcher/zmr_launcher_style' %>
<div class='content-launcher index'>
  <%= render :partial => "shared/flash_notices" %>
  <div class="content">
    <h3>Account created.</h3>
    
    <%= form_tag("/launcher/#{@game.id}/activate") do %>
      <input type="hidden" name="account_id" value="<%= @user.id %>">
      <ul>
        <li class="class-name-here">
          <p class="class-name-here">You’re almost there! <br>Next, check your email.</p>
        </li>
        <li>
          <input type="text" name="activation_code" placeholder="verification code">
        </li>
        <li>
          <p class="class-name-here">Select a Secret Question:</p>
          <%= select_tag :secret_question_id, options_for_select( SecretQuestion.active.collect { |q| [q.question, q.id] }) %>
        </li>
        <li>
          <input type="text" name="secret_question_answer" placeholder="Secret Answer">
        </li>
      </ul>
      <input id="activate" type="submit" value="Activate Account">
    <% end %>

    <div class="account-links activate">
      <%= link_to('Back to Sign In', "/launcher/#{@game.id}/signin") %> | 
      <%= link_to(tslt("resend e mail"), launcher_resend_activation_path(@game.id, @user.screen_name, :ticket => @user.resend_activation_ticket)) %>
    </div>
  </div>
    
    
  
</div>


