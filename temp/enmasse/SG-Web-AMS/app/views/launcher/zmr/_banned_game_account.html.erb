<% store_redirect = SECURE_CONFIG["digital_river"]["game_purchase_redirect"] rescue SHOP_URL %>
<% subscription_redirect = SECURE_CONFIG["enmasse"]["subscription_setup_url"] rescue SHOP_URL %>

<style type="text/css">
  body, body#app-launcher {
    background: none;
    box-sizing: border-box;
  }
  body#app-launcher .content-launcher {
    background: none;
    width: 470px;
    height: 510px;
  }
  body#app-launcher .content-launcher p {
    background: #EAD6B9;
    color: #000000;
    padding: 10px;
    margin-top: 220px;
  }
</style>

<div class='content-launcher'>
  <%= render :partial => "shared/flash_notices" %>
  <div class='clear'></div>

  <p>This account has been banned. To resolve this issue, contact <a href="http://support.enmasse.com/zmr" target="blank">En Masse Customer Service</a>.</p>

</div><!--#launcher-->
<script>
  $(function() {
    $('.list').jScrollPane();
  });
</script>
