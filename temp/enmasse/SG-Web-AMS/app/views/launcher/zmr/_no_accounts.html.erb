<style type="text/css">
  body, body#app-launcher { background: none; color: #000000; }
  body#app-launcher .content-launcher { background: #EAD6B9; }
  #app-launcher .listing .listing-head,
  #app-launcher .listing .listing-body,
  #app-launcher .listing .listing-foot { background: none; }
</style>

<% if @wait_for_account %>
<script type="text/javascript">
  GAME_ID = <%= @game.id %>;
  hasGameAccount(0);
</script>
<% end %>

<div id="content-launcher" class='content-launcher' data-id="#{params[:id]}">
  <%= render :partial => "shared/flash_notices" %>
  <div class='clear'></div>
  <div class='listing no-accounts'>
    <div class='listing-head'></div>
    <div class='listing-body'>
      <p class='message'><%= @message %></p>
      <% if @wait_for_account %>
      <p id="standByMsg" class="standByMsg"><%= tslt("message_creating_game_account_launcher_cont") %><span class="one">.</span><span class="two">.</span><span class="three">.</span></p>
      <div id="refreshBtn">
        <p>ZMR page</p>
        <p class="standByMsg"><%= tslt("message_creating_game_account_launcher_error") %></p>
        <div class='options'>
          <p><%= link_to(tslt('refresh'), launcher_path(@game.id)) %></p>
        </div><!--.options-->
      </div>
      <% end %>
    </div><!--.listing-body-->
    <div class='listing-foot'></div>
  </div><!--.no-accounts-->
</div><!--#launcher-->
