<!doctype html>
<!--<html xmlns="http://www.w3.org/1999/xhtml" xmlns:fb="http://www.facebook.com/2008/fbml" xml:lang="en" lang="en">-->
<!-- paulirish.com/2008/conditional-stylesheets-vs-css-hacks-answer-neither/ -->
<!--[if lt IE 7 ]> <html lang="en" class="no-js ie6"> <![endif]-->
<!--[if IE 7 ]>    <html lang="en" class="no-js ie7"> <![endif]-->
<!--[if IE 8 ]>    <html lang="en" class="no-js ie8"> <![endif]-->
<!--[if IE 9 ]>    <html lang="en" class="no-js ie9"> <![endif]-->
<!--[if (gt IE 9)|!(IE)]><!--> <html lang="en" class="no-js"> <!--<![endif]-->
  <head>
    <%= render :partial => "shared/head" %>
    <%= javascript_include_tag "apps/account" if params[:controller].downcase == 'launcher/users' %>
    <style type="text/css">
      @font-face {
        font-family: 'exo_2light';
        src: url('/fonts/exo2-light-webfont.eot');
        src: url('/fonts/exo2-light-webfont.eot?#iefix') format('embedded-opentype'),
             url('/fonts/exo2-light-webfont.woff') format('woff'),
             url('/fonts/exo2-light-webfont.ttf') format('truetype'),
             url('/fonts/exo2-light-webfont.svg#exo_2light') format('svg');
        font-weight: normal;
        font-style: normal;
      }
    </style>
  </head>
  <body id="app-<%= @current_app if defined?(@current_app) %>" class="no-layout">
    <% if content_for?(:facebook) %>
      <%= yield(:facebook) %>
    <% end %>
    <div class="row" id="registration"></div>
    <a name='top'></a>
    <div id="zmr-signup" style="display:none;"></div>
    <div id='blackout' style='display:none;'></div>

    <div id="container-main">
      <%= yield %>
    </div><!--#container-main-->

    <% if in_launcher? %>
      <form><input type="hidden" name="blackbox" id="blackbox" value="" /></form>
      <script type="text/javascript">
        if (!inLauncher()) {
          window.location = "/launcher/forbidden";
        } else {
          setTimeout(serverPing, (KeepaliveInterval || (1000 * 60 * 15)));
        }
      </script>
      <%= render :partial => "shared/iovation_init" %>
    <% end %>
  </body>
</html>
