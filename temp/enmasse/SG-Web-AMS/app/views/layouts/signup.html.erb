    <script>
$(document).ready(function() {

  $('#toggle_pass').on('click', 'a', function(event) {
    event.preventDefault();
    if($('#user_password').attr('type') == 'password') {
      $('#user_password').attr('type', 'text');
      $('#toggle_pass a').html('Hide Password');
    } else {
      $('#user_password').attr('type', 'password');
      $('#toggle_pass a').html('Show Password');
    }
  })

  function setPosterSize() {
    var videoWidth = $('.video-inner').outerWidth();
    var videoHeight = $('.video-inner').outerHeight();
    $('#video-overlay').css('height', videoHeight );
    $('#video-overlay').css('width', videoWidth );
  }

  //setPosterSize();

  function setCorrectBG() {
    if($('.for-mobile').is(":visible")) {
      var correctBG = $('#correctBG_small').attr("data-image");
    } else if($('.for-tablet').is(":visible")) {
      var correctBG = $('#correctBG_medium').attr("data-image");
    } else {
      var correctBG = $('#correctBG_big').attr("data-image");
    }
    $('section.page_bg').css('background-image', 'url(' + correctBG + ')');

    var winW = $(window).width();
    if(winW <= 768) {
      $( 'section.for-tablet' );
      $( 'section.for-desktop' );
    } else if(winW <= 1024) {
      $( 'section.for-mobile' );
      $( 'section.for-desktop' );
    } else {
      $( 'section.for-mobile' );
      $( 'section.for-tablet' );
    }
  }

  setCorrectBG();

/*  function forcevalidation() {
    if($('.check.with_errors').length > 0) {
      $('#btn-create-account').addClass('disabled');
    } else {
      $('#btn-create-account').removeClass('disabled');
      checkFormComplete();
    }
  }
 
  $('#submit-btn').on('hover mouseenter click', function() {
   // forcevalidation();
   // console.log('foreValidation being caleed');
    console.log('inpage submit calling to checkFormComplete');
    checkFormComplete();
  })
 */
 $('#user_password').on('keydown, keyup', function() {
    $('#user_password_confirmation').val($('#user_password').val());
 });
 /*$('#user_email').on('keyup', function() {
    $('#user_email_confirmation').val($('#user_email').val());
 });*/


  // Returns a function, that, as long as it continues to be invoked, will not
// be triggered. The function will be called after it stops being called for
// N milliseconds. If `immediate` is passed, trigger the function on the
// leading edge, instead of the trailing.
//http://davidwalsh.name/javascript-debounce-function
  function debounce(func, wait, immediate) {
    var timeout;
    return function() {
      var context = this, args = arguments;
      var later = function() {
        timeout = null;
        if (!immediate) func.apply(context, args);
      };
      var callNow = immediate && !timeout;
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
      if (callNow) func.apply(context, args);
    };
  }

  var myEfficientFn = debounce(function() {
    var winW = $(window).width();
    //setPosterSize();
    setCorrectBG();
  }, 250);

  if (window.addEventListener) {
      window.addEventListener('resize', myEfficientFn, false);
  }
  else {
      window.attachEvent('resize', myEfficientFn);
  }

}); 
</script>
