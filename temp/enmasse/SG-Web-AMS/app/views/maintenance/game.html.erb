<% content_for :google_analytics_account, 'UA-10684483-3' %>

<% title tslt("game maintenance") %>
 
<div class='content-launcher'>
  <%= render :partial => "shared/flash_notices" %>
  <div class='clear'></div>
  <div class='content-container'>
    <div class='content-body'>
      <h1><%= h(@maintenance["title"]) %></h1>
      <hr />
      <p class='message'><%= add_breaks(h(@maintenance["body"])) %></p>
    </div><!--.content-body-->
  </div><!--.content-container-->
</div><!--#launcher-->

<script>
$(function() { $('.content-body').jScrollPane(); });
</script>