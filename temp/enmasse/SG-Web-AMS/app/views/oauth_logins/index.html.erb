<style>
html body.no-layout {
  background: transparent;
}
body div#container-main {
  display: table;
  position: absolute;
  height: 100%;
  width: 100%;
}
body div#container-middle {
  vertical-align: middle;
  display: table-cell;
}
#login {
  margin-left: auto;
  margin-right: auto;
  border-radius: 7px;
  width: 320px;
  background-color: #30343b;
  border: 2px solid #000;
}
</style>
<script>  // Not in launcher - ignore launcher JS
  function inLauncher() { return false; }
</script>
<% if logged_in? %>
  <p>Successfully logged in.</p>
  <script>
    parent.postMessage("loggedIn","*");
  </script>
<% else %>
  <div id="container-middle">
    <input type="hidden" name="blackbox" id="blackbox" value="" />
    <%= render :partial => "/shared/iovation_init" %>
    <%= render :partial => "/shared/full_login_box", :locals => {:show_errors => true, :pop_tabs => true, :return_to => @return_to, :fail_to => "/oauth_logins" } %>
  </div>
<% end %>
