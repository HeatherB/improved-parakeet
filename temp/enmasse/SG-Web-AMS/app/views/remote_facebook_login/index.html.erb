<style>
html body.no-layout {
  background: transparent;
}
body div#container-main {
  width: 100%;
  color:#000000;
  font-size: 14px;
}
#login {
  border-radius: 7px;
  width: 100%;
  background-color: none;
  border: none;
  padding: 0;
  margin:0;
}
.login-facebook-btn {
  background-image:url(assets/uniLauncher/log_in_with_fb.png);
  width:288px;
  height:57px;
  background-position:0 0;
}
.login-facebook-btn:hover {
  background-position:0 -57px;
}
</style>
<script>  // Not in launcher - ignore launcher JS
  function inLauncher() { return false; }

  sessionStorage.setItem('inUniversalLauncher', 'true');
  //var inUniversalLauncher = sessionStorage.getItem('inUniversalLauncher');
  
</script>
<% if logged_in? %>
  <p>Successfully logged in.</p>
  <script>
    parent.postMessage("loggedIn","*");
  </script>
<% else %>
  <input type="hidden" name="blackbox" id="blackbox" value="" />
  <%= render :partial => "/shared/iovation_init" %>
  <%= render :partial => "/shared/facebook_login_box", :locals => {:show_errors => true, :pop_tabs => true, :return_to => "/remote_facebook_login" } %>
<% end %>

