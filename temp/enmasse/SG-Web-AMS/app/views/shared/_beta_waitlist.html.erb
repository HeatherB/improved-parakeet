
<p class="sign-up-heading">We are accepting applications for beta testing. <span class="details">Apply here to reserve your place</span></p>
<div id="beta-message" style="display:none"></div>
<div id="beta-status-block">
  <p>Beta Status: <span id='beta-status'><%= @beta_app.nil? ? "Not Signed Up" : @beta_app.status %></span></p>
</div>
<% if @beta_app.nil? || @beta_app && @beta_app.can_activate? %>
  <!--<p class="beta-details">Enter a code to save your place in beta. <span class="details">Codes are NOT required, but do ensure your place in a beta event.</span></p>-->
  <%= form_tag "/beta/apply", remote: true, id: "beta-code" do |f| %>
    <%= hidden_field_tag :game_id, @game_obj.id %>
    <!--<div class="beta-code-field">
      <%#= label :beta_code, "Beta Code:" %>
      <%#= text_field_tag :beta_code %>
    </div>-->
    <div id="submit-beta">
    <button type="submit" value="Apply for Beta" />
      <%= submit_tag "Apply for Beta", class: "beta-apply" %>
    </div>
  <% end %>
<% end %>
