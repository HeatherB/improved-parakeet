<%= form_for :user, :url => url, :html => { :id => "popup-login-form", :class => "login-form", :'data-io-bb' => "user_io_black_box", :name => "login" } do |f| %>
  <%= f.hidden_field :client_time %>
  <%= f.hidden_field :rt, :value => @requestId if @requestId.present? %>
  <%= f.hidden_field :rid, :value => params[:rid] if params[:rid].present? %>
  <%= hidden_field_tag :newsletter_id, newsletter if defined?(newsletter) %>
  <script>
    $(function() {
      $('#user_client_time').val(Date(Date.UTC()));
    });
  </script>
  <%= f.hidden_field :io_black_box %>

  <% if defined?(return_to) %>
    <%= hidden_field_tag :return_to, return_to %>
  <% end %>
  <% if defined?(fail_to) %>
    <%= hidden_field_tag :fail_to, fail_to %>
  <% end %>
  <div class='fgroup'>
    <div class='input-text'><span id="email_text">E-mail Address</span>
      <input id="user_email" class="field focus" type="text" size="30" name="user[email]" placeholder="<%= tslt('input placeholder email') %>">
    </div><!--.input-text-->
    <div class="clear"></div>
  </div><!--.fgroup-->
  <div class='fgroup'>
    <div class='input-text'><span id="pwd_text">Password</span>
      <input id="user_password" class="field" type="password" size="30" name="user[password]" placeholder="<%= tslt('input placeholder password') %>" autocomplete="off">
    </div><!--.input-text-->
    <div class="clear"></div>
  </div><!--.fgroup-->
  <div class="login-btn controls">
    <a class="submit-link login-submit-link btn-login buttonYellow" href="#" data-form="popup-login-form"><span><%= tslt("log in")%></span></a>
    <div class='clear'></div>
  </div><!--.controls-->
<% end %>
