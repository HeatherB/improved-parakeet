<% content_for :facebook do %>
  <%= render :partial => "shared/facebook" %>
<% end %>
<% link_opts = defined?(pop_tabs) && pop_tabs ? {:target => "_new"} : {} %>
<% newsletter = defined?(newsletter) && newsletter ? newsletter : false %>
<div id="login">
  <% if defined?(show_errors) && show_errors %>
  <div style="position:absolute; zindex:100; width:320px; margin: 0 auto;">
    <%= render :partial => "shared/flash_notices" %>
  </div>
  <% end %>
  <div class="heading">
    <%= link_to "", "javascript:void(0);", :class => "login-facebook-link login-facebook-btn", :title => tslt("sign in with facebook") %>
  </div>
  <div class="hr">
    <%= tslt("or") %>
  </div>
  <%  locals = { :url => signin_submit_url}
      locals[:return_to] = return_to if defined?(return_to)
      locals[:newsletter] = newsletter if newsletter
      locals[:fail_to] = fail_to if defined?(fail_to)
  %>
  <%= render :partial => "shared/default_login_form", :locals => locals %>
  <div class="login-footer">
    <%= link_to tslt("problems logging in"), password_reset_users_path, link_opts %>
    &nbsp;|&nbsp;
    <%= link_to tslt("create an account"), "/sign-up", link_opts %>
  </div>
</div>
