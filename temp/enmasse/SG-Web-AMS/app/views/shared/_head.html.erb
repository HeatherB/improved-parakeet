<%= render :partial => "shared/html_meta" %>
<%= render :partial => "shared/google_analytics" %>

<!--[if lt IE 9]>
<script src="https://html5shim.googlecode.com/svn/trunk/html5.js" type="text/javascript"></script>
<![endif]-->
<%= stylesheet_link_tag "application", :media => "all" %>

<!--[if lte IE 9]>
  <%= stylesheet_link_tag "application-ie", :media => "all" %>
<![endif]-->
<% if content_for?(:stylesheets) %>
  <%= yield(:stylesheets) %>
<% end %>

<%= javascript_include_tag "application" %>
<%= javascript_include_tag "apps/#{@current_app}" if @current_app && Rails.application.assets.find_asset("apps/#{@current_app}.js").present? %>

<% if content_for?(:tracking_js) %>
  <%= yield(:tracking_js) %>
<% end %>

<%= yield :head -%>


