<% emp_url = SECURE_CONFIG["enmasse"]["emp_purchase_url"] rescue SHOP_URL %>

<%= EMEGlobalAssets.snippet("eme-bar", {:create_support_link => "https://#{Rails.application.config.support_server}/eme", :create_link => "https://#{Rails.application.config.account_server}/eme/sign-up", :create_ams_link => "https://#{Rails.application.config.account_server}", :eme_bar => true, :games_menu => true, :shop_bar => true, :slink => true, :alinks => true}) %>

<input type="hidden" name="blackbox" id="blackbox" value="" />

<%= render :partial => "shared/flash_notices" %>
<%= render :partial => "shared/global_alerts" %>


<% if logged_in? %>
<script>
  $('#eme-bar .loginli').replaceWith('<li><%= link_to(tslt("log out"), signout_path) %></li>');
</script>
<% else %>
<script>
	$('#eme-bar .loginli').replaceWith('<button type="button" class="dropdownLogin showRegLogin">Log In</button>');
</script>
<% end %>
