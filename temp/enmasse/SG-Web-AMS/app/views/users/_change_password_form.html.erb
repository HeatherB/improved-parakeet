<% email_arr = @user.email.split("@") %>
<input type="hidden" id="user_email_name" value="<%= email_arr[0] %>" />
<input type="hidden" id="user_email_domain" value="<%= email_arr[1] %>" />

<label for="user_new_password"><%= tslt("new password")%></label>
<div class="iparent"><%= f.password_field :new_password, :value => "", :class => "input-4 password check-form focus", :autocomplete => "off", :rel => ".pstrength-meter-cont" %></div>
<!--<label>&nbsp;</label>-->
<div id="password-strength" class="pstrength-meter-cont"></div>
<!--<label>&nbsp;</label>-->
<div class="hint">
  <div id="user_password-hint" class="hint-text">
    <p><%=tslt("your password must meet the following criteria")%>:</p>
    <ul>
      <li><%= tslt("greater than 8 characters")%></li>
      <li><%= tslt("contains at least two of the following types")%></li>
      <li><%= tslt("does not contain your email name or email domain")%></li>
    </ul>
  </div>
</div>
<div class="clear"></div>

<label for="user_new_password"><%= tslt("confirm new password")%></label>
<div class="iparent"><%= f.password_field :new_password_confirmation, :value => "", :class => "input-4 check-form", :autocomplete => "off" %></div>
<div class="check"></div>
<div class="clear"></div>

<div class="actions">
	<button type="submit" id="password-submit" class="submit-link default-button btn-1 disabled preview buttonDark" title="<%= tslt("please complete the change password form")%>" data-form="change-password-form"><%=tslt("update")%></button>
	<button type="button" class="cancel buttonLight"><%= tslt("cancel")%></button>
</div>
