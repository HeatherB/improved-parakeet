<div id="user_email-hint" class="hint-text">
  <%= tslt("youll use your email address to log in")%>
</div>
<div id="user_email-warning" class="hint-text">
  <p><%#= tslt("Invalid email address")%></p>
  <p class="server-error" style="font-size:16px; line-height: 1.6em; font-family: Helvetica Neue,Helvetica,Arial,sans-serif; font-weight:normal;"><%#= "Email #{@user.errors[:email]}" if @user.errors[:email].present? %></p>
  <!-- 
  &quot;abuse&quot;, &quot;admin&quot;, &quot;all&quot;, &quot;everyone&quot;, &quot;ftp&quot;, &quot;investor relations&quot;, 
  &quot;jobs&quot;, &quot;marketing&quot;, &quot;media&quot;, &quot;noc&quot;, &quot;postmaster&quot;, &quot;privacy&quot;, &quot;remove&quot;, &quot;request&quot;, &quot;root&quot;, &quot;sales&quot;, &quot;security&quot;, 
  &quot;subscribe&quot;, &quot;unsubscribe&quot;, &quot;usenet&quot;, &quot;users&quot;, &quot;uucp&quot;, &quot;webmaster&quot;, &quot;www&quot;
  -->
</div>

<div id="user_email_confirmation-hint" class="hint-text">
  <p><%= tslt("when asked for their email address once")%></p> 
  <p><%= tslt("were asking for your email address twice so this doesnt happen")%></p>
</div>
<div id="user_email_confirmation-warning" class="hint-text">
  <p>
    <% if @user.errors[:email_confirmation].present? %>
      <%= tslt("email confirmation")%> <%= @user.errors[:email_confirmation] %>
    <% else %>
      <%= tslt("your email confirmation will need to match your email address")%>
    <% end %>
  </p>
</div>

<div id="user_password-hint" class="hint-text">
  <p style="width:380px; font-size:16px; line-height:1.6em; margin-left: -15px; padding-top: 10px; font-family: Helvetica Neue,Helvetica,Arial,sans-serif; font-weight:normal;">Your password must meet the following criteria:</p>
  <ul class="disc">
    <li class="gt8">Has 8 or more characters.</li>
    <li class="lt99">Has fewer than 99 characters.</li>
    <li class="sym">Uses at least 2 of the following: 
      <ul>
        <li>letters (a-z, A-Z)</li>
        <li>digits (0-9)</li>
        <li>symbols (-+=@^&amp;%/?!#)</li>
      </ul>
    </li>
    <li class="contains">Does not contain your email name or domain.</li>
  </ul>
</div>
<div id="user_password-warning" class="hint-text">
  <p style="width:380px; font-size:16px; line-height:1.6em; text-align:left; padding-left: 7px; padding-top: 10px; font-family: Helvetica Neue,Helvetica,Arial,sans-serif; font-weight:normal;">The password you have provided does not meet the minimum requirements:</p>
  <ul class="disc">
    <li class="gt8">Has 8 or more characters.</li>
    <li class="lt99">Has fewer than 99 characters.</li>
    <li class="sym">Uses at least 2 of the following: 
      <ul>
        <li>letters (a-z, A-Z)</li>
        <li>digits (0-9)</li>
        <li>symbols (-+=@^&amp;%/?!#)</li>
      </ul>
    </li>
    <li class="contains">Does not contain your email name or domain.</li>
  </ul>
</div>

<div id="user_password_confirmation-hint" class="hint-text">
  <p style="font-size:16px; line-height:1.6em;"><%= tslt("please retype your password")%></p>
</div>

<div id="user_password_confirmation-warning" class="hint-text">
  
    <% if @user.errors[:password_confirmation].present? %>
     <p> <%= tslt("password confirmation")%> <%= @user.errors[:password_confirmation] %></p>
    <% else %>
      <p style="width:380px; font-size:16px; line-height:1.6em; text-align:left; padding-left: 7px; padding-top: 10px; padding-bottom: 10px; font-family: Helvetica Neue,Helvetica,Arial,sans-serif; font-weight:normal;">The password confirmation will need to match your password.</p>
    <% end %>
  
</div>

<div id="user_secret_question_id-hint" class="hint-text">
  <p><%=tslt("be sure to remember the secret question")%></p>  
  <p>
    <%= tslt("please select a secret question from the list and provide your answer")%>
  </p>  
</div>
<div id="user_secret_question_id-warning" class="hint-text">
  <p>
    <%= tslt("please select a secret question from the list and provide your answer")%>
  </p>
</div>

<div id="user_secret_answer-hint" class="hint-text">
  <p><%= tslt("be sure to remember the secret question and answer that you provide")%></p>  
  <p><%= tslt("please select a secret question from the list and provide your answer")%></p>  
</div>
<div id="user_secret_answer-warning" class="hint-text">
  <p><%= tslt("please input a secret answer")%></p>  
</div>

