<div id="pending-email-change-cont">
  <ul class="labels">
    <li><%=tslt("new email address")%>:</li>
  </ul>
  <ul class="values">
    <li><%= h(user.new_email) %></li>
  </ul>
  <div class="clear"></div>
  <%= link_to(tslt("resend verification"), resend_email_change_users_account_path, :class => "default-button btn-2 buttonLight resend-email-link") %>
  <%= link_to(tslt("cancel request"), cancel_email_change_users_account_path, :class => "default-button btn-2 buttonLight cancel-email-link", :method => :put ) %>
  <div class="clear"></div>
</div>