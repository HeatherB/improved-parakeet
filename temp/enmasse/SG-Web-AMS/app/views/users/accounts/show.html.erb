<div class="game-accounts">
  <h1 class="heading">Game Account Settings</h1>

  <!-- begin ruby logic to output games -->
  <!-- games already have -->
  <% if @game_accounts.any? %>
  <div class="game_section_header">
      <h2>&ndash;  Games You Have Played &ndash;</h2>
    </div>
    <% @game_accounts.each do |acct| %>
            <% game = acct.game
               sub = acct.subscription(@subscriptions)
               oid = acct.obfuscated_id
               img_src = game.thumbnail_url.blank? ? "account/fpo.jpg" : game.thumbnail_url %>
      <section id="game_account_<%= game.name.downcase %>" class="game_account_bundle open">
          <div class="header">
            <div class="nav">
              <span class="reveal-game"></span>
            </div>
          </div>
          <div class="content">
            <div class="leftCol">
              <div class="thumb <%= game.name.downcase %>">
                <!--<img src="/assets/game_thumbs/<%#= game.name.downcase %>.png" alt="<%#= game.name.downcase %>" />-->
                <% if h(acct.game_account_type.name) == game.name + " Beta" %>
                  <span class="flair beta">in beta</span>
                <% end %>
              </div>
              <div class="nameplate">
                <span class="game_name"><span class="game_name_icon <%= game.name.downcase %>"></span><%= game.name %></span>
                <!--<span class="game_type">PC - Epic Fantasy MMORPG</span>-->
                <% if game.name.downcase == "tera" %>
                  <span class="game_type">
                    <span class="type_platform"><%= @platform_PC %></span> - 
                    <span class="type_type"><%= @type_epic %> <%= @type_fantasy %></span> 
                    <span class="type_genre"><%= @genre_mmorpg %></span>
                  </span>
                <% elsif game.name.downcase == "ava" %>
                  <span class="game_type">
                    <span class="type_platform"><%= @platform_PC %></span> - 
                    <span class="type_type"><%= @type_online %></span> 
                    <span class="type_genre"><%= @genre_fps %></span>
                  </span>
                <% elsif game.name.downcase == "zmr" %>
                  <span class="game_type">
                    <span class="type_platform"><%= @platform_PC %></span> - 
                    <span class="type_type"><%= @type_online %></span> 
                    <span class="type_genre"><%= @genre_fps %></span>
                  </span>
                <% elsif game.name.downcase == "kritika" %>
                  <span class="game_type">
                    <span class="type_platform"><%= @platform_PC %></span> - 
                    <span class="type_type"><%= @type_stylish %> <%= @type_fantasy %> </span> 
                    <span class="type_genre"><%= @genre_mmorpg %></span>
                  </span>
                <% elsif game.name.downcase == "closers" %>
                  <span class="game_type">
                    <span class="type_platform"><%= @platform_PC %></span> - 
                    <span class="type_type"><%= @type_arcade %> <%= @type_fantasy %></span> 
                    <span class="type_genre"><%= @genre_mmorpg %></span>
                  </span>
                <% elsif game.name.downcase == "tera_ps_na" %>
                  <span class="game_type">
                    <span class="type_platform"><%= @platform_PS %></span> - 
                    <span class="type_type"><%= @type_epic %> <%= @type_fantasy %></span> 
                    <span class="type_genre"><%= @genre_mmorpg %></span>
                  </span>
                <% elsif game.name.downcase == "tera_xb_na" %>
                  <span class="game_type">
                    <span class="type_platform"><%= @platform_Xbox %></span> - 
                    <span class="type_type"><%= @type_epic %> <%= @type_fantasy %></span> 
                    <span class="type_genre"><%= @genre_mmorpg %></span>
                  </span>
                <% else %>
                  <span class="game_type">TBD</span>
                <% end %>
              </div>
            </div><!-- end of leftcol -->
            <div class="rightCol">
              <div class="about">
                <h3>Account Info:</h3>
                <h5>Type: 
                  <% if h(acct.access_level) == 0 %>
                  <span>Standard</span>
                  <% elsif h(acct.access_level) == 1 %>
                  <span>Founder</span>
                  <% elsif h(acct.access_level) == 2 %>
                  <span>Elite</span>
                  <% else %>
                  <span>Standard</span>
                  <% end %>
                  <!--<span><%#= (sub.present? && sub.active?) ? tslt("elite") : h(acct.game_account_type.name) %></span>-->
                </h5>

                <% if sub.present? && sub.active? %>
                <% sub_end = sub.ended_at.in_time_zone("Pacific Time (US & Canada)") %>
                <h5>Elite Time: <span><%= sub_end.strftime("%b %d, %Y") %></span></h5>
                <% end %>

                <h5>Status:
                <% if h(acct.game_account_type.name) == game.name + " Beta" %>
                  <span class="gold">BETA <%= acct.account_status_description %></span>
                <% elsif acct.account_status_description.downcase == "active" %>
                  <span class="green"><%= acct.account_status_description %></span>
                <% elsif acct.account_status_description.downcase == "permanent ban" || acct.account_status_description.downcase == "suspended" || acct.account_status_description.downcase == "chat banned" %>
                  <span class="red"><%= acct.account_status_description %></span>
                <% else %>
                  <span><%= acct.account_status_description %></span>
                <% end %>
                </h5>
                <% if acct.account_status_description.downcase == "permanent ban" %>
                  <p class="more_detail red"><b>ACTION NEEDED:</b> Your account has been permanently banned.</p>
                <% elsif acct.account_status_description.downcase == "suspended" %>
                  <p class="more_detail red"><b>ACTION NEEDED:</b> Your account has been suspended.</p>
                <% elsif acct.account_status_description.downcase == "chat banned" %>
                  <p class="more_detail red"><b>ACTION NEEDED:</b> Your account has been banned from chat.</p>
                <% end %>
              </div>

              <div class="actions">
                <%= button_to(tslt("download game"), game.download_url, :class => "buttonDark", :target => :blank) if game.download_url.present? %>

                <% if game.setting(:allow_transfers) %>
                  <%= button_to(tslt('Server Transfer'), new_game_account_transfer_path(:game_account_id => oid), :class => "buttonLight") %>
                <% end %>

                <!-- button for AVA account migration -->
                <% if game.setting(:allow_migration).to_s == 'true' %>
                  <%= button_to(('Migrate Account'), users_migration_start_path(game: 'ava'), :class => "buttonLight") %>
                <% end %>

                <% if game.setting(:subscriptions) %>
                  <% if sub.present? && sub.active? %>
                    <%= post_to_link(subscription_management_url, {:game_account_id => acct.id, :clear => true}, {:value => ("Manage Elite Subscription"), :class => "buttonLight"}) %>
                  <% elsif acct.is_trial? %>
                    <%= button_to(("Upgrade to Elite"), "#", :class => "buttonLight", :'data-gid' => oid) %>
                  <% elsif sub.nil? || !sub.active? %>
                    <%= post_to_link(subscription_setup_url, {:game_account_id => acct.id, :clear => true}, {:value => tslt("Upgrade to Elite"), :class => "buttonLight"}) %>
                  <% end %>
                <% end %>

              <a href="http://support.enmasse.com/<%= game.name.downcase %>" class="buttonLight"><%= game.name %> Support</a>
            </div>
          </div><!-- end of right col -->
        </div>
      </section>
    <% end %>
  <% end %>

  <!-- games to add -->
  <% if @games_without_accounts.any? %>
    <div class="game_section_header">
      <h2>&ndash;  Games You Have Not Played Yet &ndash;</h2>
    </div>
