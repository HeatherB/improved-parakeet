          <span class="icon <%= @billing_info.cctype.downcase %>"></span>
          <span class="pref_acct <%= @billing_info.cctype.downcase %>"><%= @billing_info.cctype %>: **** <%= @billing_info.ccacct %></span>
        <% else %>
          <span class="pref_acct">No card on file.</span>
