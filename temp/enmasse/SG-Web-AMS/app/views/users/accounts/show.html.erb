        </div>
      </div><!-- end of right col -->
      <h3>Elite Subscription: </h3>
      <div class="elite_wrapper">
        <div class="input_wrap elite_sub">
          <span class="elite_subscription_logo"></span>
          <div class="copy">
          <% if !@subscriptions.empty? %>
            <% @subscriptions.each do |subscrip| %>
              <h2>Your Elite Subscription is <span class="elite_sub_standing <%= subscrip.state.downcase %>"><%= subscrip.state.capitalize %></span></h2>
