      <% unless @unredeemed_codes.empty? && @unredeemed_rewards.empty? %>
      <table>
        <thead>
          <tr>
            <th>
              <h3>Unredeemed Codes</h3>
            </th>
          </tr>
        </thead>
        <% @unredeemed_codes.each do |code| %>
        <tr>
          <td><%= link_to h(code.promotion.promotion_name), users_game_code_url(code, :protocol => DEFAULT_PROTOCOL), :class => "unredeemed-code" %></td>
        </tr>
        <% end %>
        <% @unredeemed_rewards.each do |reward| %>
        <tr>
          <td><%= link_to h(reward.reward_promotion.promotion_name), users_progressive_goal_reward_url(reward, :protocol => DEFAULT_PROTOCOL), :class => "unredeemed-code" %></td>
        </tr>
        <% end %>
      </table>
      <% end %>
    </div>
  </section>

  <section>
