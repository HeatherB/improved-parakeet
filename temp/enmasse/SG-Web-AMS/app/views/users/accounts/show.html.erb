          <a href="<%= subscription_management_url %>" class="buttonLight update-billing">Update Billing Info</a>
          <a href="<%= subscription_management_url %>" class="buttonLight cancel-subscription">Cancel Subscription</a>
        <% else %>
          <a href="<%= subscription_setup_url %>" class="buttonDark elite-upgrade">Upgrade To Elite</a>
        <% end %>
        </div>
