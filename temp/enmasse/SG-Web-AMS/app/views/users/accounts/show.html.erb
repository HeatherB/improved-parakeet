  <% content_for :custom_google_analytics_calls do %>
    _gaq.push(['_trackEvent', 'Accounts', 'Login Successful', '<%= current_user.id %>']);
  <% end %>
<% end %>


<!-- from mockup -->
<div class="account-settings">
  <h1>Account Settings</h1>
  <button type="button" class="buttonDark enter-code-btn" >Redeem a code</button>

  <% if !current_user.new_email.present? %>
  <% else %>
  <!-- things we currently support that were not included in mockups -->
  <section class="notify">
    <h2 class="heading">Notifications</h2>
    <div class="wrapper">
      <% if current_user.new_email.present? %>
        <div class="settings">
          <h3><%= tslt("email change requested")%></h3><hr />
          <%= render :partial => "pending_email_change", :locals => { :user => current_user } %>
        </div>
      <% end %>
    </div>
  </section>
  <!-- end current support things that were missing -->
  <% end %>

  <section>
    <h2 class="heading">Account Details</h2>
    <div class="wrapper">
      <form>
        <div class="leftCol">
          <label>Email Address:</label>
          <div class="input_wrap">
            <!--<input type="text" value="Fanny.Dang.Dewberry@aol.com" />-->
            <span class="text_input"><%= h(@user.email) %></span>
            <button type="button" value="edit" class="buttonLight edit_btn edit-email-link">Edit</button>
          </div>

          <label>Password:</label>
          <div class="input_wrap">
            <!--<input type="password" value="****************" />-->
            <span class="text_input">********</span>
            <button type="button" value="edit" class="buttonLight edit_btn edit-password-link">Edit</button>
          </div>
        </div><!-- end of left col -->
        <div class="rightCol">
          <label>Public Name:</label>
          <div class="input_wrap">
            <!--<input type="text" value="Fanny Dang Dewberry" />-->
            <span class="text_input"><%= h(current_user.screen_name) %></span>
            <button type="button" value="edit" class="buttonLight edit_btn nickname">Edit</button>
          </div>
          <div class="input_block">
            <h3>Account Armor 
              <span class="hover-info">What is this?
                <div id="aa-reveal" class="hover-reveal">
                  <p>Account Armor is an additional layer of security which prevents unauthorized devices from accessing your En Masse account. Account Armor is enabled by default to keep your account safe.</p>

                  <p>Account Armor sends an authorization code to the email address on record whenever a new device tries to access your account. Without the code, the new device can't sign in. This makes things much more difficult for hackers, even if they have your password.</p>

                  <p>An Account Armor code is only good for 30 minutes, so be sure to enter your code promptly after receiving the email. If you request another code while waiting for the email, this will invalidate the first code.</p>
                </div>
              </span>
              <label class="armor_label">
                <span class="icon armor"></span>
                <p>Account armor is 
                  <% if @user.engarde_enabled? %>
                  <span class="armorToggle"><b>ON</b> (recommended)</span>
                  <% else %>
                  <span class="armorToggle"><b>OFF</b></span>
                  <% end %>
                </p>
              </label>
              <button type="button" value="edit" class="buttonLight edit_btn edit-engarde-link">Edit</button>
            </h3>
          </div>
        </div><!-- end of right col -->
      </form>
    </div>
  </section>

