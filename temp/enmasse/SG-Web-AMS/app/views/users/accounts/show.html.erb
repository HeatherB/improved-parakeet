        <div id="nickname-form">
          <label for="user_screen_name"><%= tslt("public nickname")%></label>
            <span class="iparent">
              <%= f.text_field :screen_name, :value => "", :class => "input focus", :rel => "screen-name-form", :maxlength => 20, :autocomplete => "off" %>
