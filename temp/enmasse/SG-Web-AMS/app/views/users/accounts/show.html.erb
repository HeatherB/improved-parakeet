          <div id="screen-name-err-msg" class="err-msg"></div>
          <div id="alternate-names" style="display:none;"><p><%= tslt("the name")%> <b><span id="existing-name"></span></b> <%= tslt("is already taken how about")%> <span id="alternate-name-links"></span></p></div>
          <div class="actions">
            <button type="submit" id="screen-name-submit" class="submit-link default-button btn-1 disabled preview buttonDark" title="<%=tslt('please enter a valid nickname')%>" data-form="screen-name-form"><%= tslt("create")%></button>
            <button type="button" class="cancel buttonLight"><%= tslt("cancel")%></button>
          </div>
        </div>
      <% end %>
        <script type="text/javascript">
        var ScreenNameErrors = { "too_short":"<%=tslt('nickname mustbe at least three char long')%>", "invalid":"<%=tslt('nickname is invalid')%>" };
