    <div id="games">
      <a href="#" onclick="return false" class="trigger"><span>Games</span></a>
      <ul class="eme-menu">
        <li class="games-link tera"><a href="http://tera.enmasse.com"><span>Windows</span></a></li>
        <li class="games-link kritika"><a href="http://www.playkritika.com"><span>Windows</span></a></li>
        <li class="games-link zmr"><a href="http://zmr.enmasse.com"><span>Windows</span></a></li>
         <li class="games-link ava"><a href="http://ava.enmasse.com"><span>Windows</span></a></li>
        <!--<li class="games-link battleplans"><a href="http://www.enmasse.com/games/battleplans"><span>iOS &amp; Android</span></a></li>-->
        <!--<li class="games-link fruit-attacks"><a href="http://www.enmasse.com/games/fruit-attacks"><span>iOS &amp; Android</span></a></li>
        <li class="games-link pocket-platoons"><a href="http://www.enmasse.com/games/pocket-platoons"><span>iOS &amp; Android</span></a></li>-->
      </ul>
    </div>

    <!--<div  id="account">
      <ul>
        <li><a href="#" class="sign-in login-popup-link">Sign In</a></li>
        <li><a href="https://account-edge.enmasse.com/tera/sign-up" class="create">Create Account</a></li>
      </ul>
    </div>-->

  </div><!-- end wrapper -->
</div><!-- end eme bar -->


<section id="<%= raw @campaign.campaign_name %>" class="page_bg default activation_failure">
  <div class="wrapper">

    <div class="sleeve">
      <% if @campaign.game.blank? %>
      <h1 class="game_logo">
            <img src="http://download.enmasse.com/images/sign-up/eme/master/eme_signup_logo.png" alt="en masse" />
      </h1>
      <% else %>
      <h1 class="game_logo">
            <img src="<%= raw @campaign.game_logo_url %>" alt="<%= raw @campaign.game %>" />
      </h1>
      <% end %>

    <div class="inner_wrapper">
    <h1><%= tslt("account activation failed") %></h1>
    
    <div>
      <h2><%= tslt("try again")%>.</h2>
      <p><%=tslt("your account activation request was rejected")%>.</p>
      <ul>
        <li><%= tslt("the account has  already been activated")%></li>
        <li><%= tslt("user does not exist")%></li>
        <li><%= tslt("invalid activation code")%></li>
        <li><%= tslt("expired activation code")%></li>
      </ul>
    </div>
    <div class="btn_wrapper">
      <%= link_to(tslt("create account"), '/sign-up', class: 'btn-retry') %>
    </div>
  </div><!-- end of inner wrapper -->


<div>
  <%= raw @campaign.tracking_activate_failed_html %>
</div>

</div><!-- end of sleeve -->
  </div><!-- end of wrapper -->         
</section><!-- end of main content -->
<%#= javascript_include_tag "apps/eme-bar" %>
<%= javascript_include_tag "apps/shame" %>

