<% title tslt("account verification complete") %>
<% content_for :custom_google_analytics_calls do %>
  _gaq.push(['_trackEvent', 'Accounts', 'Complete Registration', 'EME']);
<% end %>

<div id="eme-bar">
  <div class="wrapper">
    <div class="eme"><a href="http://www.enmasse.com/"></a></div>

    <div id="games">
      <a href="#" onclick="return false" class="trigger"><span>Games</span></a>
      <ul class="eme-menu">
        <li class="games-link tera"><a href="http://tera.enmasse.com"><span>Windows</span></a></li>
        <li class="games-link kritika"><a href="http://www.playkritika.com"><span>Windows</span></a></li>
        <li class="games-link zmr"><a href="http://zmr.enmasse.com"><span>Windows</span></a></li>
         <li class="games-link ava"><a href="http://ava.enmasse.com"><span>Windows</span></a></li>
        <!--<li class="games-link battleplans"><a href="http://www.enmasse.com/games/battleplans"><span>iOS &amp; Android</span></a></li>-->
        <!--<li class="games-link fruit-attacks"><a href="http://www.enmasse.com/games/fruit-attacks"><span>iOS &amp; Android</span></a></li>
        <li class="games-link pocket-platoons"><a href="http://www.enmasse.com/games/pocket-platoons"><span>iOS &amp; Android</span></a></li>-->
      </ul>
    </div>

   <!-- <div  id="account">
      <ul>
        <li><a href="#" class="sign-in login-popup-link">Sign In</a></li>
        <li><a href="https://account-edge.enmasse.com/tera/sign-up" class="create">Create Account</a></li>
      </ul>
    </div> -->

  </div><!-- end wrapper -->
</div><!-- end eme bar -->

<section id="<%= raw @campaign.campaign_name %>" class="page_bg default">
  <div class="wrapper">

    <div class="sleeve">
      <% if @campaign.game.blank? %>
      <h1 class="game_logo">
            <img src="http://download.enmasse.com/images/sign-up/eme/master/eme_signup_logo.png" alt="en masse" />
      </h1>
      <% else %>
      <h1 class="game_logo">
            <img src="<%= raw @campaign.game_logo_url %>" alt="<%= raw @campaign.game %>" />
      </h1>
      <% end %>



            

      <!-- new beta landing -->
      <% if @game_obj && @game_obj.beta_applications_open %>
            <% if current_user.nil? || current_user == :false %>
              <h2 class="beta-heading">Account Activation Complete</h2>
              <p style="text-align:center;">Sign in on the <%= link_to "Beta sign up page", "/#{@campaign.game}/sign-up" %></p>

              <% if !@campaign.success_img_url.blank? %>
                <img src="<%= @campaign.success_img_url %>" class="didit beta" alt="you did it">
              <% end %>

              <% if !@campaign.confirmation_additional_html.blank? %>
                <div class="additional_html_beta">
                  <%= raw @campaign.confirmation_additional_html %>
                </div>
              <% end %>
            <% else %>
              <%= render :partial => "shared/beta_waitlist" %>
            <% end %>


      <% else %>
      <!-- end beta landing -->

      <div id="complete-wrap" class="secondary-wrap" >
        <div class="progess-bar">
          <img src="/assets/sign-up-multi/progress-download.png" alt="Signup Verify Security [Download]">
        </div><!-- end of progress bar -->


        <h2>Account Activation Complete</h2>
        <% if !@campaign.success_img_url.blank? %>
        <img src="<%= @campaign.success_img_url %>" class="didit" alt="you did it">
        <% end %>


        <%# if raw @campaign.download_link %>
        <% if !@campaign.download_link.blank? %>
        <p>Click the button below to start downloading
          <% if @campaign.game.downcase == 'tera' %>
            <em class="tera"><%= @campaign.game %>:</em>
          <% elsif @campaign.game.downcase == 'zmr' %>
            <em><%= @campaign.game.upcase %>:</em>
          <% elsif @campaign.game.downcase == 'ava' %>
            <em><%= @campaign.game.upcase %>:</em>
          <% else %>
            <em><%= @campaign.game %>:</em>
          <% end %>
        </p>
        <div class="btn_options">
          <a class="eme_btn" href="<%= raw @campaign.download_link %>">Download</a>
          <p class="small"><a href="<%= raw @campaign.download_link %>">See more download options</a></p>
        </div>
        
        <% end %>

        <% if !@campaign.confirmation_additional_html.blank? %>
        <div class="additional_html">
          <%= raw @campaign.confirmation_additional_html %>
        </div>
        <% end %>
      </div>
      <!-- swap for beta -->
      <% end %>
      <!-- end swap for beta -->

<div>
  <%= raw @campaign.tracking_activated_html %>
</div>

<%= CustomBlock.content_for("eme_complete_registration").to_s.html_safe %>

</div><!-- end of sleeve -->
  </div><!-- end of wrapper -->         
</section><!-- end of main content -->


<%#= javascript_include_tag "apps/eme-bar" %>
<%= javascript_include_tag "apps/shame" %>