<% title tslt("account verification complete") %>
<% content_for :custom_google_analytics_calls do %>
  _gaq.push(['_trackEvent', 'Accounts', 'Complete Registration', 'ZMR']);
<% end %>
<script src="//ajax.googleapis.com/ajax/libs/webfont/1.4.7/webfont.js"></script>
<script>
window.onload = function() {
  WebFont.load({
    google: {
      families: ['Luckiest Guy']
    }
  });
}
</script>
<link href='https://fonts.googleapis.com/css?family=Luckiest+Guy' rel='stylesheet' type='text/css'>
<style type="text/css">

#content {
  background: url(/assets/account/zmr_confirm_screen.jpg) no-repeat 50% 0;
  width: 1100px;
  margin: -29px 0px -122px 0px;
  height: 555px;
  font-family: "luckiest guy", Arial;
  text-transform: uppercase;
  letter-spacing: 1px;
}
#content h2 {
  font-size: 38px;
  line-height: 46px;
  font-family: "luckiest guy", Arial;
  border-bottom: none;
  color: #ffc800;
}
#content .congrats {
  margin: 0px 50px 0px 570px;
  padding-top: 40px;
  font-size: 24px;
  line-height: 38px;
}
#content p {
  margin-top: 15px;
  font-family: Arial;
  text-transform: none;
  font-size: 18px;
  line-height: 1.6em;
  letter-spacing: 0;
  width: 420px;
}
#content a {
  color: #eb0000;
}
#content a:hover {
  color: #ffc800;
}
#content strong {
  color: #eb0000;
  font-weight: normal;
  font-weight: bold;
}
#content .nowrap {
  white-space: nowrap;
}

#content .download-btn {
  margin: 80px 0px 0px 35px;
}

#btn-zmr-download {
  display: block;
  width: 356px;
  height: 128px;
  background: url(/assets/account/zmr-download-btn.png) no-repeat 0px 0px;
}
#btn-zmr-download:hover {
  background-position: 0 -128px;
}
#btn-zmr-download:active {
  background-position: 0 -256px;
}
</style>

