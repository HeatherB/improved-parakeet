<div id="content">
  <div class="congrats">
    <h2>Thanks for signing up!</h2>
    <p>While downloading, check out our <a href="http://zmr.enmasse.com/game-info/getting-started/new-players-guide">new player's guide</a> so you're ready to rock as soon as you log in.</p>
    <div class="download-btn">
      <%= link_to("", "http://zmr.enmasse.com/download", :id => "btn-zmr-download") %>
    </div>
  </div>
</div>

