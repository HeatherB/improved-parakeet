    </div>

    <!--<div  id="account">
      <ul>
        <li><a href="#" class="sign-in login-popup-link">Sign In</a></li>
        <li><a href="https://account-edge.enmasse.com/tera/sign-up" class="create">Create Account</a></li>
      </ul>
    </div>-->

  </div><!-- end wrapper -->
</div><!-- end eme bar -->


<section id="<%= raw @campaign.campaign_name %>" class="page_bg default">
  <div class="wrapper">

    <div class="sleeve">
      <% if @campaign.game.blank? %>
      <h1 class="game_logo">
            <img src="http://download.enmasse.com/images/sign-up/eme/master/eme_signup_logo.png" alt="en masse" />
      </h1>
      <% else %>
      <h1 class="game_logo">
            <img src="<%= raw @campaign.game_logo_url %>" alt="<%= raw @campaign.game %>" />
      </h1>
      <% end %>

      <div id="security-wrap" class="secondary-wrap">
        <div class="progess-bar">
          <img src="/assets/sign-up-multi/progress-security.png" alt="Signup Verify [Security] Download">
        </div><!-- end of progress bar -->

        <%= error_messages_for :user %>

        <h2>Account Verified</h2>
        <p>Please provide a security question and answer.</p>
        <p>We use this information to verify your identity when you contact customer service. Make sure the answer you provide is something you can easily remember. For your security, this information is not made visible on your account management page.</p>
        <%= render :partial => "additional_requirements_form", :locals => {:in_launcher => false} %>
      </div><!-- end of security wrap -->
  

<%= CustomBlock.content_for("enter_security_question_info").to_s.html_safe %>

    </div><!-- end of sleeve -->
  </div><!-- end of wrapper -->         
</section><!-- end of main content -->


<%#= javascript_include_tag "apps/eme-bar" %>
<%= javascript_include_tag "apps/shame" %>
