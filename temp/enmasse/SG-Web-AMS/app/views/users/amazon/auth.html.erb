<input type="hidden" name="blackbox" id="blackbox" value="" />
<%= render :partial => "shared/iovation_init" %>
<div id="container-message">
    <% flash.each do |name, msg| %>
      <%= content_tag :div, msg, :class => name %>
    <% end %>
    <div id="login" class="amazon">
      <%= render :partial => "shared/default_login_form", :locals => { :url => signin_users_amazon_index_url(:protocol => DEFAULT_PROTOCOL, :requestId => params[:requestId]) } %>
      <div class="links">
        <%= link_to "Forgot your password?", password_reset_users_url(:protocol => DEFAULT_PROTOCOL) %>
        |
        <%= link_to "Register an Account", register_users_amazon_index_url(:requestId => params[:requestId]) %>
        <br>
        <%= link_to "Privacy Policy", 'http://tera.enmasse.com/standalone-pages/privacy-policy-and-end-user-license-agreement' %>
      </div>
    </div>

    <div id="amazon-legal-text">
      <%= tslt('amazon account linking legal text') %>
    </div>
</div>
