<%= error_messages_for_form_step.join('<br>').html_safe %>

<div class='fgroup'>
  <%= f.label :email, "<span>#{tslt('email address')}</span>".html_safe, :class => 'label-username', :id => 'user-email-label' %>
  <div class='input-text'>
    <%= f.text_field :email, :placeholder => tslt('input placeholder email'), :class => 'field', :id => 'user-email-text-field' %>
  </div><!--.input-text-->
  <div class="clear"></div>
</div><!--.fgroup-->

<div id='user-password-container'>
    <div class='fgroup' id='user-password-group'>
      <%= f.label :password, "<span>#{tslt('password')}</span>".html_safe, :class => 'label-username' %>
      <div class='input-text'>
        <%= f.password_field :password, :placeholder => tslt('input placeholder password'), :class => 'field', :id => 'user-password-text-field' %>
      </div><!--.input-text-->
      <div class="clear"></div>
    </div><!--.fgroup-->

    <div class='fgroup' id='user-password-confirm-group'>
      <%= f.label :password_confirmation, "<span>#{tslt('verify')} #{tslt('password')}</span>".html_safe, :class => 'label-username' %>
      <div class='input-text'>
        <%= f.password_field :password_confirmation, :class => 'field', :id => 'user-password-confirm-text-field' %>
      </div><!--.input-text-->
      <div class="clear"></div>
    </div><!--.fgroup-->
</div>

<div id='link-button-container'>
    <div id='login-links'>
    <%= link_to "Have an account?", auth_users_amazon_index_url(:requestId => params[:requestId]) %>
    |
    <%= link_to "Privacy Policy", 'http://tera.enmasse.com/standalone-pages/privacy-policy-and-end-user-license-agreement' %>
    </div>

    <%= hidden_field_tag :form_step, 1 %>
    <%= hidden_field_tag :requestId, params[:requestId] || @requestId %>
    <%= hidden_field_tag :redirectUrl, params[:redirectUrl] || @redirectUrl %>
    <%= hidden_field_tag :game_id, params[:game_id] || @game_id %>

    <div class="controls" id='next-button'>
      <%= f.submit 'Next', :class => 'login-btn' %>
      <div class='clear'></div>
    </div><!--.controls-->
</div>
