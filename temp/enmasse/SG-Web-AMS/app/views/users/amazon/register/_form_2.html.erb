<%= error_messages_for_form_step.join('<br>').html_safe %>

<% @user_params.each do |key, value| %>
  <%= f.hidden_field key, :value => value %>
<% end %>

<div class='fgroup'>
  <%= f.label :secret_question_id, "<span>#{tslt('select a secret question')}</span>".html_safe %>
  <div class='input-text'>
    <%= f.select :secret_question_id, @secret_questions.collect{ |q| [q.question, q.id] }, { :prompt => tslt("select question") },
                 { :class => "easy-select hintable" } %>
  </div><!--.input-text-->
  <div class="clear"></div>
</div><!--.fgroup-->

<div class='fgroup'>
  <%= f.label :secret_answer, "<span>#{tslt('secret answer')}</span>".html_safe %>
  <div class='input-text'>
    <%= f.text_field :secret_answer, :class => 'field', :id => 'secret-answer-text-field' %>
  </div><!--.input-text-->
  <div class="clear"></div>
</div><!--.fgroup-->

<div>
    <div class="controls" id='prev-button'>
      <%= f.submit '< PREV', :class => 'login-btn' %>
      <div class='clear'></div>
    </div><!--.controls-->

    <div class='fgroup' id='terms-link'>
      <%= tslt("sign_up_notice") %>
      <div class="clear"></div>
    </div><!--.fgroup-->

    <%= hidden_field_tag :form_step, 2 %>
    <%= hidden_field_tag :requestId, params[:requestId] || @requestId %>
    <%= hidden_field_tag :redirectUrl, params[:redirectUrl] || @redirectUrl %>
    <%= hidden_field_tag :game_id, params[:game_id] || @game_id %>

    <div class="controls" id='submit-button'>
      <%= f.submit 'Submit', :class => 'login-btn' %>
      <div class='clear'></div>
    </div><!--.controls-->
</div>

<div class="display-none">
  <div id="terms">
    <h1><%= tslt("en masse terms of service")%></h1>
    <div id="terms-content">
      <%= render :partial => "pages/terms_of_service" %>
    </div>
  </div>
</div>
