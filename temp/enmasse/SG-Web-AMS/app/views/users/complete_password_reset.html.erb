<% title "Complete Password Reset Request" %>

<div id="content" class="default-message-cont pass-reset-step-3">
<!--rounded corners-->
  <div class="content-top"> <h1><%= tslt("complete password reset request")%></h1>
    <hr />
  </div>
  <!--end rounded corners-->
  <div class="content-block">
    <div id="right-column">
      <div class="btn account"><p align="center"><%= link_to(tslt("create account"), '/sign-up') %></p></div>
    </div>
    <div id="left-column" class="password-reset-cont">
      <h2><%= tslt("enter new password")%></h2>
      <div id="change-password-form-cont" class="cb-cont">
        <%= form_for :user, :url => submit_password_reset_user_path(@user.screen_name), :html => { :id => "change-password-form", :class => "default" } do |f| %>
          <%= hidden_field_tag :ticket, @user.forgot_password_key %>
          <%= render :partial => "/users/change_password_form", :locals => { :f => f } %>
        <% end %>
      </div>

    </div>
    <div class="clear"></div>
    <hr />
  </div>
  <!--rounded corners-->
  <div class="content-bottom"></div>
<!--end rounded corners-->  
</div>