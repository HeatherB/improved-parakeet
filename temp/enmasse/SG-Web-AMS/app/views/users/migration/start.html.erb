<% if flash[:message_title] && flash[:message_body] && flash[:message_class] %>
  <div class="inner-content">
    <div class="leftSleeve">
      <h2 class="error">Account transfer error</h2>
      <div class="flash-message-box">
        <span class="<%= "icon icon-#{flash[:message_class]}" %>"></span>
        <p class="flash-message-title subhead"><%= flash[:message_title] %></p>
        <p class="flash-message-body"><%= flash[:message_body] %></p>
        <% if flash[:message_list] %>
        <%= flash[:message_list].html_safe %>
        <% end %>
      </div>
      <p>For more information on this error, see our <a href="/">Account Transfer FAQ</a>, or contact <a href="http://support.enmasse.com/games">Customer Support</a> for assistance.</p>
      <div>
        <div class="buttons">
          <div class="button tryAgain"><a href="<%= @aeria_migration_start_url %>">Try Again</a></div>
          <p>
            <span class="or">or</span>
            <a href="<%= users_account_url %>">Cancel</a>
          </p>
        </div>
      </div>
    </div><!-- end of left sleeve -->
    <div class="rightSleeve">
      <img src="/assets/account/avaToEnmasse.png" alt="migrate your AVA account to En Masse" />
    </div><!-- end of rightSleeve -->
  </div>
<% else %>

    <!-- no errors -->
    <div class="inner-content">
      <div class="leftSleeve">
        <h2 class="noicon">AVA Game Account Migration </h2>
        <p class="subhead">Authorize transfer of your AVA game account from your Aeria Games account.</p>
        <p>Click the button below to go to the <b>Aeria Games website</b>, where you can log in and authorize the account transfer. If at any time you wish to stop the transfer, just click "Cancel".</p>
        <p><b>NOTE:</b> This transfer will overwrite any newly-created AVA characters on your En Masse account. <a href="http://ava.enmasse.com/guide/account-transfer-guide">View the account transfer guide for more details.</a></p>
          <div class="buttons">
            <div class="button startMigration"><a href="<%= @aeria_migration_start_url %>">Begin Transfer</a></div>
            <p>
              <span class="or">or</span>
              <a href="<%= users_account_url %>">Cancel</a>
            </p>
          </div>
      </div><!-- end of left sleeve -->
      <div class="rightSleeve">
        <img src="/assets/account/avaToEnmasse.png" alt="migrate your AVA account to En Masse" />
      </div><!-- end of rightSleeve -->
    </div>

<% end %>
    