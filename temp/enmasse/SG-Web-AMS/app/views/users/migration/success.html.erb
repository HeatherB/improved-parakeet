<div class="inner-content">
  <div class="leftSleeve">
    <h2 class="success">Good news! Your account is authorized for transfer.</h2>
    <p>Click <b>"Complete Transfer"</b> to complete the process, or "Cancel" if you do not wish to complete the account transfer at this time.</p>
    <p><b>NOTE:</b> Once the transfer is completed it cannot be reversed.</p>
    <p>For more information regarding the account transfer process, see our <a href="/">Account Transfer FAQ</a>, or contact <a href="http://support.enmasse.com/games">Customer Support</a> for assistance.</p>
    <div>
      <div class="buttons">
        <div class="button completeMigration"><a href="<%= @migration_confirmation_url %>">Complete Transfer</a></div>
        <p>
          <span class="or">or</span>
          <a href="<%= users_account_url %>">Cancel</a>
        </p>
      </div>
    </div>
  </div><!-- end of left sleeve -->
  <div class="rightSleeve">
    <img src="/assets/account/avaToEnmasse.png" alt="migrate your AVA account to En Masse" />
  </div><!-- end of rightSleeve -->
</div>