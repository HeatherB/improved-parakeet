<%= render :partial => "shared/global_alerts" %>

<section id="<%= raw @campaign.campaign_name %>" class="page_bg default <%= raw @campaign.game %>">
  <div class="wrapper">
    <div class="sleeve">
      <% if @campaign.game.blank? %>
      <h1 class="game_logo">
            <img src="http://download.enmasse.com/images/sign-up/eme/master/eme_signup_logo.png" alt="en masse" />
      </h1>
      <% else %>
      <h1 class="game_logo">
            <img src="<%= raw @campaign.game_logo_url %>" alt="<%= raw @campaign.game %>" />
      </h1>
      <% end %>

      <div class="signup-wrap">
        <% if !@campaign.youtube_video_url.blank? %>
        <div class="video-wrapper">
          <div class="video-inner">
            <iframe src="<%= raw @campaign.youtube_video_url %>" id="video" frameborder="0" width="560" height="315"></iframe>
            <div id="video-overlay" style="background-image: url(<%= raw @campaign.youtube_poster_url %>); "></div>
          </div>
        </div><!-- end of video wrapper -->
        <% end %>
        <% if current_user.nil? || current_user == :false %>
          <% if @game_obj && @game_obj.beta_applications_open %>
            <p class="sign-up-heading">We are accepting applications for beta testing. <span class="details"><%= link_to "Sign in", "#", :class => "login-popup-link" %> or create an account to apply.</span></p>
            <% else %>
            <p class="sign-up-heading">Create a free En Masse account:</p>
          <% end %>

          <input type="hidden" name="blackbox" id="blackbox" value="" />
          <%= render :partial => "shared/iovation_init" %>

           <%= link_to "", "javascript:void(0);", :class => "signup-facebook-link signup-facebook-btn login-facebook-btn", :title => "Log in with Facebook" %>
           <span class="or">or</span>

          <%= form_for :user, :url => users_path, :html => { :method => :post, :id => "account-registration-form" } do |f| %>
            <%= render :partial => "form_multi", :locals => { :f => f } %>
          <% end %>

          <div style="display:none">
          <% if @game_obj && @game_obj.beta_applications_open %>
          <%= render :partial => "/shared/full_login_box", :locals => {:fail_to => index_path(:slogin => true), :return_to => game_sign_up_path} %>
          <% else %>
          <%= render :partial => "/shared/full_login_box", :locals => {:fail_to => index_path(:slogin => true), :return_to => verified_users_path} %>
          <% end %>
            <%#= render :partial => "/shared/full_login_box", :locals => {:fail_to => index_path(:slogin => true), :return_to => verified_users_path} %>
          </div>
        <% else %>
          <% if @game_obj && @game_obj.beta_applications_open %>
            <%= render :partial => "shared/beta_waitlist" %>
          <% end %>
        <% end %>

        <% if !@campaign.download_link.blank? %>
        <div class="download_game">
          <p class="small">Already have an account?<br><a href="<%= raw @campaign.download_link %>">Download 
            <em class="<%= @campaign.game.downcase %>">
            <% if ['ava', 'zmr'].include?(@campaign.game.downcase) %>
              <%= @campaign.game.upcase %>
            <% else %>
              <%= @campaign.game %>
            <% end %>
            </em>
            !</a></p>
        </div>
        <% end %>

       <% if !@campaign.offer_image_url.blank? %>
        <div class="signupOffer">
          <img src="<%= raw @campaign.offer_image_url %>" alt="Sign Up and receive rewards" />
        </div>
        <% end %>
      </div><!-- end  sign up wrap -->


      <div id="verify-wrap" class="secondary-wrap" style="display:none;">
        <div class="progess-bar">
          <img src="/assets/sign-up-multi/progress-verify.png" alt="Signup [Verify] Security Download">
        </div><!-- end of progress bar -->
        <h2>Check your email</h2>
        <p>You should receive an email momentarily containing a verification link and instructions to activate your account.
        <span id="email_address"></span>
        <span id="email_inbox"></span></p>
        <p>If you haven't received an email, please click the link below: 
          <a href="/" class="resend_activation">Resend Verification Email</a>
          </p>
          <%# if @user.activation_code %>
          <%#= link_to(tslt("Resend Verification Email"), resend_activation_user_path(@user.screen_name, :ticket => @user.resend_activation_ticket)) %>
          <%# end %>

        <%# if raw @campaign.download_link %>
        <% if @campaign.download_link.blank? %>
        <% else %>
        <p>In the meantime, start downloading 
          <% if @campaign.game.downcase == 'tera' %>
            <em class="tera"><%= @campaign.game.upcase %>:</em>
          <% elsif @campaign.game.downcase == 'zmr' %>
            <em><%= @campaign.game.upcase %>:</em>
          <% elsif @campaign.game.downcase == 'ava' %>
            <em><%= @campaign.game.upcase %>:</em>
          <% else %>
            <em><%= @campaign.game %>:</em>
          <% end %>
        </p>
        <div class="btn_options">
          <a class="eme_btn" href="<%= raw @campaign.download_link %>">Download</a>
          <p class="small"><a href="<%= raw @campaign.download_link %>">See more download options</a></p>
        </div>
        <% end %>

        <p class="small">If you are still not receiving a verification email, please consult our <a href="http://support.enmasse.com/tera/i-didn-t-receive-my-account-verification-email">email verification FAQ.</a></p>
      </div><!-- end verify wrap -->
    </div><!-- end of sleeve -->
  </div><!-- end of wrapper -->
</section><!-- end of main content -->

