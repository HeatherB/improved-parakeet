<% title "Request Password Reset" %>

<div class="pass-reset-step-1">
  <section>
    <h2 class="heading">Request Password Reset</h2>
    <div class="wrapper">
      
        <div class="leftCol">
          <h2><%= tslt("step one")%></h2>
          <p class="info"><%= tslt("please provide the email address used to register your account")%></p>
          <%= form_tag submit_password_reset_1_users_path, :id => "submit-password-reset-1", :class => "default", :method => :put do %>
            <label for="email"><%= tslt("email address")%></label>
            <div class="input_wrap">
              <%= text_field_tag :email, "", :class => "input-4 focus", :autocomplete => "off" %>
            </div>
        
            <div class="iparent">
              <a href="#" class="submit-link buttonDark" data-form="submit-password-reset-1"><%= tslt("continue")%></a>
            </div>
          <% end %>
        </div><!-- end of left col -->
        <div class="rightCol">
          <p>On second though, I want to 
          <%= link_to(tslt("create an account"), '/sign-up', :class => 'justText') %>.</p>
        </div><!-- end of right col -->

    </div>
  </section>
</div>