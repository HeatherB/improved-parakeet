<% title "Password Reset Complete" %>

<div class="pass-reset-complete">
  <section>
    <h2 class="heading"><%= tslt("password reset complete")%></h2>
    <div class="wrapper">
      
        <div>
          <h2><%= tslt("check your email")%></h2>
          <p>Your password has been reset to a temporary password sent to your email address.</p>
          <p>Login to your account with the temp password.</p>
          
          <div class="iparent">
            <%= link_to "Login", signin_path, :class => 'buttonLight' %>
          </div>
        </div><!-- end of right col -->

    </div>
  </section>
</div>