<% title "Request Password Reset" %>


<div class="pass-reset-step-2">
  <section>
    <h2 class="heading">Request Password Reset</h2>
    <div class="wrapper">
      
        <div class="leftCol">
          <h2><%= tslt("step two")%></h2>
         <p class="info"><%= tslt("please provide the answer to the secret question")%></p>
          <%= form_tag submit_password_reset_2_users_path, :id => "submit-password-reset-2", :class => "default", :method => :put do %>
          <%= hidden_field_tag :email, @user.email %>
            <label for="secret_question"><%= tslt("secret question")%></label>
            <p>
              <%= h(@secret_question.question) %>
            </p>

            <label for="secret_answer"><%= tslt("secret answer")%></label>
            <div class="input_wrap">
              <%= text_field_tag :secret_answer, "", :class => "input-4 focus", :autocomplete => "off" %>
            </div>
        
            <div class="iparent">
              <a href="#" class="submit-link buttonDark" data-form="submit-password-reset-2"><%= tslt("continue")%></a>
            </div>
          <% end %>
        </div><!-- end of left col -->
        <div class="rightCol">
          <p>On second though, I want to  
          <%= link_to(tslt("create an account"), '/sign-up', :class => 'justText') %>.</p>
        </div><!-- end of right col -->

    </div>
  </section>
</div>
