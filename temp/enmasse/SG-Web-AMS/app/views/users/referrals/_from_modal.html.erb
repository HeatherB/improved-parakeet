<div id="game-account-selection-modal">
  <h3><%= tslt('select a character') %></h3>
  <hr>

  <% if @game_accounts.count == 1 %>
    <div id="game-account-characters">
      <% @servers = @active_servers.map{ |s| @servers[s] } %>
      <%= render :partial => 'users/referrals/game_account_characters', :locals => { :servers => @servers, :game_account => @game_accounts.first } %>
    </div>
  <% else %>
    <% @game_accounts.each do |game_account| %>
      <div class="game-account" data-gid="<%= game_account.obfuscated_id %>" data-acct-name="<%= game_account.account_name %>"><%= game_account.account_name %></div>
    <% end %>

    <div class="clear"></div>
    <div id="game-account-characters">

    </div>
  <% end %>
</div>
