<% servers ||= nil %>
<% game_account ||= nil %>
<% @servers = servers || @server %>
<% @game_account = game_account || @game_account %>

<% @servers.each do |server| %>
  <div class="server closed">
    <span class="name"><%= server.name %></span>
    <span class="pull-right"><%= server.category %></span>
  </div>

  <div class="server open" data-server-name="<%= server.name %>">
    <div class="top">
      <span class="name"><%= server.name%></span>
      <span class="pull-right"><%= server.category %></span>
    </div>

    <div class="mid">
      <ul class="character-list">
          <% @game_account.characters.each do |character| %>
            <% next if character['server_id'].to_i != server.id.to_i %>
            <li data-char-srl="<%= character['char_srl'] %>"
                data-server-id="<%= server.id %>"
                data-char-name="<%= character['char_name'] %>"
                data-server-name="<%= server.name %>"
                class="character">
              <span class="character-name"><%= character['char_name'] %></span>
              -
              lvl. <%= character['char_level'] %>
            </li>
          <% end %>
      </ul>
    </div>

    <div class="bottom"></div>
  </div>
<% end %>
