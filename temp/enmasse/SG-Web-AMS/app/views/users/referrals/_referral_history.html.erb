<table id="referral-history-table">
  <% @referrals.each do |referral| %>
    <tr class="<%= cycle('even', 'odd') %>">
      <td>
        <%= referral.created_at.strftime("%b %d, %Y") %>
      </td>

      <td>
        Invited
        <span class="info"><%= handle_long_text(referral.email) %></span>
        From
        <span class="info"><%= referral.character_name %></span>
        On
        <span class="info"><%= referral.server %></span>
      </td>

      <td>
        <% link_to '', 'data-url' => users_referral_path(referral.obfuscated_id), 'data-text' => tslt('check status'), :class => 'referral-status-link' do %>
          <%= tslt('check status') %>
          >
        <% end %>
      </td>
    </tr>
  <% end %>
</table>
