<div id="content">
  <div class="content-top account-man"> 
    <%= render :partial => "/users/accounts/account_nav", :locals => { :current => "" }%>
  </div>

  <div class="content-block referral-content">
    <div class="top-content">
      <h4><%= tslt('refer a friend') %>!</h4>
      <p><%= tslt('referral details') %></p>
    </div>

    <div class="top-content" id='referral-rewards'>
      <%= image_tag('referrals/refer-letter-small.png', :style => 'float: right;' ) %>
      <h4><%= tslt('referral rewards') %>!</h4>
      <p><%= tslt('referral reward details') %></p>
    </div>
    <div class="clear"> </div>
  </div>

  <div class="content-block referral-content">
    <h4><%= tslt('referral history') %></h4>
    <%= render :partial => 'referral_history', :locals => { :referrals => @referrals } %>
  </div>

  <div class="content-block referral-content">
    <%= render :partial => 'from_modal' %>

    <div id="referral-status-modal-container">
      <%= render :partial => 'referral_status_modal' %>
    </div>

    <div id="referral-sent-modal-container">
      <%= render :partial => 'sent_modal' %>
    </div>

    <% if Referral.user_can_invite?(@user) %>
      <%= render :partial => 'form' %>
    <% else %>
      <div class="error-message referral-content">
        <%= tslt('referral rate limited') %>
        <%= tslt('referral rate limit resets on') %>
        <%= (@referrals.first.created_at + 30.days).strftime("%b %d, %Y") %>
      </div>
    <% end %>
  </div>
</div>
