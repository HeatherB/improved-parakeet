<% title tslt("account registration complete") %>

<% content_for :custom_google_analytics_calls do %>
  _gaq.push(['_trackEvent', 'Accounts', 'Registration Verification', '<%= @user.id %>']);
<% end %>

<!-- <img src="http://ad.adlegend.com/ping?spacedesc=1097917_1061349_1x1_1061349_1061349&db_afcr=123&group=032012_ SITETRACKING&event=6B_NEWREG_COMPLT" width=1 height=1 alt=" " border=0 style="position:absolute;left:-10000px;top:-10000px"> -->

<div id="content" class="default-message-cont">
<!--rounded corners-->
  <div class="content-top"> <h1><%= tslt("you account has been created youre almost there")%></h1>
    <hr />
  </div>
  <!--end rounded corners-->
  <div class="content-block">
    <div id="right-column">
      <div class="btn account"><p align="center"><%= link_to(tslt("resend e mail"), resend_activation_user_path(@user.screen_name, :ticket => @user.resend_activation_ticket)) %></p></div>
    </div>
    <div id="left-column">
      <h2><%= tslt("check your email")%></h2>
      <p>
        <%= tslt("click on the link provided within your email to verify your email address")%>
      </p>
      <p><%= tslt("if you have lost or not recieved your verification email")%></p>
    </div>
    <div class="clear"></div>
    <hr />
  </div>
  <!--rounded corners-->
  <div class="content-bottom"></div>
<!--end rounded corners-->  
</div>
