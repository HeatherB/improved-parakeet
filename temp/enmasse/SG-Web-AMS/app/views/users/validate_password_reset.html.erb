<% title "Verify Password Reset Request" %>




<div class="pass-reset-validate">
  <section>
    <h2 class="heading"><%= tslt("verify password reset request")%></h2>
    <div class="wrapper">
      
        <div class="leftCol">
          <h2><%= tslt("check your email")%></h2>
          <p><%= tslt("click on the link provided within your email to complete your password reset request")%></p>
        </div><!-- end of left col -->
        <div class="rightCol">
          <p>On second though, I want to  
          <%= link_to(tslt("create an account"), '/sign-up', :class => 'justText') %>.</p>
        </div><!-- end of right col -->

    </div>
  </section>
</div>