<style type="text/css">
  body { background: none; }
  #app-account.no-layout #additional-requirements { background: #EAD6B9; }
  #app-account #additional-requirements form label { color: #000000; }
  #app-account.no-layout #additional-requirements form #submit-btn {
    width: 219px;
    height: 50px;
  }


  #app-account.no-layout #additional-requirements form #submit-btn input {
    background: transparent url(/assets/launcher/save.png) no-repeat 0 0;
    text-indent: -9999px;
    width: 219px;
    height: 50px;
    border-top: none;
  }
  #app-account.no-layout #additional-requirements form #submit-btn input:hover {
    border-top: none;
    background-position: 0 -50px;
  }
  #app-account.no-layout #additional-requirements form #submit-btn input.disabled {
    cursor: default;
    border-top: none;
    background: transparent url(/assets/launcher/save.png) no-repeat 0 0;
    background-position: 0 -100px;
  }
</style>
<%= render :partial => 'users/additional_requirements_form', :locals => {:in_launcher => true} %>
