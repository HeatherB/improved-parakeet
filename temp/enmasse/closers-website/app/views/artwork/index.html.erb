<% content_for :currPageCallout do %>
<body class="artwork <%= @bodyclass %>">
<% end %>

<section id="content_article_header">
	<h1>Contest Rules</h1>
    <ul>
      <li>Don't suck</li>
      <li>Don't steal artwork</li>
      <li>Don't include links or branding, personal watermarks are fine</li>
    </ul>
    
    <form action="/artwork/submission">
      <input name="artwork" type="file" accept="image/*" />
      <input type="submit" />
    </form>
    <small>All submitted entries will be reviewed by EME Staff before they show up as submitted artwork</small>
</section>
<div id="main-wrapper">
	<section id="content_side_body">
		<h2>Submissions</h2>
        <h3>Vote for your favorites!</h3>
        <div id="submissions">
        
        </div>
	</section>
	<section id="content_body">
		<%= raw @custom_body %>
	</section>
	<section id="content_wide_body">
		<%= raw @custom_wide %>
	</section>
	<section id="content_article_footer">
		<%= raw @custom_footer %>
		<!--<a href="/download"><span>Play Free</span></a>-->
	</section>
</div>

