<!DOCTYPE html>
<head>
	<% cache_key = "#{params[:controller]}/#{params[:action]}/#{params[:path] || params[:id] || params[:page] || 1}" %>
	<%= render :partial => "/refinery/html_tag" %>

		<% cache("site_bar/#{cache_key}") do %>
	      <%= render :partial => "refinery/head", :locals => { :stylesheets => %w(application) } %>
	    <% end %>
	</head>
	<% if content_for?(:currPageCallout) %>
	  <%= yield (:currPageCallout) %>
	<% elsif is_media? || is_ambassador? %>
		<body class="<%= page_title.downcase %>">
	<% elsif is_shopping? %>
		<body class="<%= page_title.downcase %> shopping internal">
	<% else %>
		<body class="<%= page_title.downcase %> internal">
	<% end %>
		<!-- Google Tag Manager (noscript) -->
 		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5H9KGXC"
 		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
 		<!-- End Google Tag Manager (noscript) -->
		<%= EMEGlobalAssets.snippet("eme-bar", {:create_link => "https://#{Rails.application.config.account_server}/closers/sign-up" }) %>

	    <% if alert %>
	      <div class="site-alert"><%= raw alert %></div>
	    <% end %>
	    <% flash.each do |name, msg| %>
          <%= content_tag :div, msg, :id => "flash_#{name}" %>
        <% end %>

		

			<div id="mobile-nav-btn">
			<!--<span>open navigation</span>-->
			<span class="morph_bar top"></span>
			<span class="morph_bar middletop"></span>
			<span class="morph_bar middlebottom"></span>
			<span class="morph_bar bottom"></span>
		</div>

			<div class="wrapper" id="main-wrap">
				<section id="navigation">
					<div id="nav-wrapper">
					<a id="logo" href="/"><img src="/assets/icons/closers-logo.png" alt="home" /></a>
						<%= Refinery::Pages::MenuPresenter.new(refinery_menu_pages, self).to_html %>
						<!--<a id="signup-btn" href="https://account.enmasse.com/closers/sign-up">Sign Up</a>-->
						<a id="signup-btn" href="https://account.enmasse.com/closers/sign-up">Play Free</a>
					</div>
				</section>
				<main>
					<%= yield %>
				</main>
		</div><!-- end of wrapper -->
		

      	<%= render :partial => "refinery/social_cankle" %>
		<%= EMEGlobalAssets.snippet("footer") %>
		
	    <%= render :partial => "/refinery/javascripts" %>
		<%= EMEGlobalAssets.snippet("sso-init", {:account_server => Rails.application.config.account_server}) %>

		<!-- social network for google -->
		<script type="application/ld+json">
		{
			"@context" : "http://schema.org",
			"@type" : "Organization",
			"name" : "En Masse Entertainment",
			"url" : "http://www.enmasse.com/",
			"alternateName" : [
				"En Masse",
				"EME",
				"En Masse Entertainment, Inc."
			],
			"legalName": "En Masse Entertainment, Inc.",
			"sameAs" : [
				"https://www.facebook.com/enmasseentertainment/",
				"https://twitter.com/en_masse_ent",
				"https://www.youtube.com/user/enmasseentertainment",
				"https://plus.google.com/109054148843660807376",
				"https://www.linkedin.com/company/en-masse-entertainment"
			]
		}
		</script>
	<% if content_for?(:bodyscripts) %>
		<%= yield (:bodyscripts) %>
	<% end %>
</body>
</html>