<%# if content_for?(:entered_styles) %>
  <%#= yield (:entered_styles) %>
  <%# end %>

<%= raw @page.top_of_head_code if @page && !@page.top_of_head_code.blank? %>

  <link href="https://fonts.googleapis.com/css?family=Teko" rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="//fonts.googleapis.com/css?family=Ubuntu+Condensed" />

  <link rel="shortcut icon" href="<%= asset_path ("/favicon.ico") %>" sizes="16x16 24x24 32x32 48x48 64x64">
  <!-- apple touch icons -->
  <link rel="icon" href="<%= asset_path ("icons/android-icon-36x36.png") %>" sizes="36x36">
  <link rel="apple-touch-icon" href="<%= asset_path ("icons/apple-icon-57x57.png") %>" sizes="57x57">
  <link rel="apple-touch-icon" href="<%= asset_path ("icons/apple-icon-72x72.png") %>" sizes="72x72">
  <link rel="apple-touch-icon" href="<%= asset_path ("icons/apple-icon-76x76.png") %>" sizes="76x76">
  <link rel="apple-touch-icon" href="<%= asset_path ("icons/apple-icon-114x114.png") %>" sizes="114x114">
  <link rel="apple-touch-icon" href="<%= asset_path ("icons/apple-icon-120x120.png") %>" sizes="120x120">
  <link rel="apple-touch-icon" href="<%= asset_path ("icons/apple-icon-144x144.png") %>" sizes="144x144">
  <link rel="apple-touch-icon" href="<%= asset_path ("icons/apple-icon-152x152.png") %>" sizes="152x152">
  <link rel="apple-touch-icon" href="<%= asset_path ("icons/apple-icon-180x180.png") %>" sizes="180x180">

  <meta name="msapplication-TileImage" content="<%= asset_path ("icons/ms-icon-144x144.png") %>">
  <meta name="msapplication-TileColor" content="#ffffff">

  <script type="text/javascript" src="//script.crazyegg.com/pages/scripts/0071/4670.js" async="async"></script>

  <style>
    @font-face {
        font-family: NorwesterReg;
        src: url('/assets/fonts/norwester.ttf') format('truetype');
    }
  </style>
<%= render '/refinery/google_analytics' %>

<% if content_for?(:twittercard) %>
  <%= yield (:twittercard) %>
<% else %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@ClosersGame">
    <meta name="twitter:title" content="Closers">
    <meta name="twitter:description" content="Closers is an episodic anime action RPG with a truly epic storyline that unfolds over several seasons, and wild beat-’em-up action set in the beleaguered city of New Seoul. ">
    <meta name="twitter:image" content="https://eme01.enmasse-game.com/images/closers/share_twitter.jpg">
<% end %>

<% if content_for?(:facebookcard) %>
  <%= yield (:facebookcard) %>
<% else %>
  <meta property="og:title" content="Closers" />
  <meta property="og:site_name" content="Closers"/>
  <meta property="og:url" content="http://closers.enmasse.com" />
  <meta property="og:description" content="Closers is an episodic anime action RPG with a truly epic storyline that unfolds over several seasons, and wild beat-’em-up action set in the beleaguered city of New Seoul. " />
  <meta property="og:image" content="https://eme01.enmasse-game.com/images/closers/share_facebook.jpg" />
<% end %>
