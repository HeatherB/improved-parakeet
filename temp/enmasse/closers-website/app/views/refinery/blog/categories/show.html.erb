<% if @featured_posts %>
    <%= render :partial => "/refinery/blog/shared/postft", :collection => [@featured_posts] %>
  <% end %>
  <% if @posts.any? %>
    <%= render :partial => "/refinery/blog/shared/categories" %>
    <section id="blog_posts_news">
      <div class="wrapper">
      <%= render :partial => "/refinery/blog/shared/post", :collection => @posts %>
      </div>
      <%= will_paginate @posts, :inner_window => 1, :outer_window => 0 %>
    </section>
  <% else %>
    <p><%= t('.no_blog_articles_yet') %></p>
  <% end %>




