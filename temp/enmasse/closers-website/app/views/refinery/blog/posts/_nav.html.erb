<div class="container">
  <nav id="next_prev_article">
    <div class="post_tabs">
      <% if @post.next.present? && @post.next.live? -%>
        <%= link_to raw('<div id="next_post" class="post_tab">Next Post</div>'),
                    refinery.blog_post_path(@post.next),
                    :class => 'next' %>
      <% end -%>
      

      <% if @post.prev.present? && @post.prev.live? -%>
        <%= link_to raw('<div id="previous_post" class="post_tab">Prior Post</div>'),
                    refinery.blog_post_path(@post.prev),
                    :class => 'prev' %>
      <% end -%>
    </div>
  </nav><!-- /next_prev_article -->
</div><!-- end of container -->
