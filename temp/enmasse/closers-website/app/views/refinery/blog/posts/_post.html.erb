<section id="content_article_header" class="internal">
  <% if @post.news_hero_field.present? %>
    <%= image_tag(@post.news_hero_field) %>
  <% else %>
    <!--<img src="/assets/bgs/placeholder-news.jpg" alt="closers news post" />-->
  <% end %>
</section>

<div id="main-wrapper">
  <section id="content_side_body" class="internal">
    <div id="posts_sidebar">
      <h4>Recent Posts</h4>
      <div class="article_wrapper">
        <%= render :partial => "/refinery/blog/shared/post_sidebar", :collection => @posts_trunc %>
      </div>
    </div>
  </section>
  <section id="content_body" class="internal">
  


    <span class="newsWrapper"><a id="news-button" href="/news">Back to News</a></span>
    
    <div class="blog-post content"> 
      <div class="inner"> 
        <header class="title-area">
          <h1><%= raw @post.title %></h1>
          <small class='attribute'>
            <span class="icon"></span>
            <%= raw "<span class='author'> #{@post.author.username}</span>" if @post.author.present? %>
            <time datetime="<%=l @post.published_at.to_datetime, :format => "%m.%d.%YT%H:%M:%SZ" %>" >
              <%= t('created_at', :scope => 'refinery.blog.shared.posts', :when => @post.published_at.to_date) %>
            </time>
          </small>
        </header>
             
        <article id="blog_post" class="twitterheader">
          <div class="content"><%= @post.body.html_safe %></div>

          <div class="post-socials">
          <h4>Share</h4>
          <%#= request.original_url %>
          <ul>
            <li class="share-facebook"><a href="https://www.facebook.com/sharer/sharer.php?u=http://closers.enmasse.com/" id="share-facebook" target="_blank"></a></li>
           
            <li class="share-twitter"><a href="https://twitter.com/intent/tweet?text=<%= @post.title %>&url=<%= request.original_url %>" class="twitter-share-button" data-show-count="false" target="_blank"></a></li>
          </ul>
        </div>



        <%#= render 'nav' if next_or_previous?(@post) %>
        </article>
        
      </div>
    </div>
    <%= render '/refinery/draft_page_message' unless @post.nil? or @post.live? -%>
  </section>
  
  <div id="blackout"></div>
  <div id="doll_dressing_room">
        <div class="inner">
          <div class="doll_dressing_room_close"><span>X</span></div>
          <figure>
            <img src="" alt="dressing room" />
          </figure>
          <div class="content">
            <div class="wrapper">
              <h2></h2>
              <h3>wearing the <span></span> costume</h3>
              <p></p>
              <div id="outfit_controls"></div>
            </div>
          </div>
          <nav id="dressing_room_dolls"><h4>See other Closers in this costume:</h4></nav>
        </div>
      </div>
</div><!-- end of main wrapper -->
  <% content_for :twittercard do %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@ClosersGame">
    <meta name="twitter:title" content="<%= @post.title %>">
    <meta name="twitter:description" content="<%= strip_tags(blog_post_teaser(@post)) %>">

    <% if @post.teaser_img_field.present? %>
      <meta name="twitter:image" content="<%= @post.teaser_img_field %>">
    <% else %>
      <meta name="twitter:image" content="https://eme01.enmasse-game.com/images/closers/share_twitter.jpg">
    <% end %>
  <% end %>

  <% content_for :facebookcard do %>
     <meta property="og:title" content="<%= @post.title %>" />
     <meta property="og:site_name" content="Closers"/> 
     <meta property="og:url" content="<%= request.original_url %>" /> 
     <meta property="og:description" content="<%= strip_tags(blog_post_teaser(@post)) %>" />
   
     <% if @post.teaser_img_field.present? %>
       <meta property="og:image" content="<%= @post.teaser_img_field %>" />
     <% else %>
       <meta property="og:image" content="https://eme01.enmasse-game.com/images/closers/share_twitter.jpg" />
     <% end %>
  <% end %>