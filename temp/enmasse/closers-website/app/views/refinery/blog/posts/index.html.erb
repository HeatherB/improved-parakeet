<% content_for :currPageCallout do %>
  <body class="news <%= controller_name %> <%= action_name %>">
<% end %>

<% content_for :body do %>
  <div id="hero">
    <section>
      <% if @postft.any? %>
        <div class="tiles">
          <%= render :partial => "/refinery/blog/shared/postft", :collection => @postft %>
        </div>
      <% end %>

      <% if @posts_notfeatured.any? %>
        <%#= render :partial => "/refinery/blog/shared/categories" %>
        <section id="blog_posts_news">
          <h1>Closers News</h1>
          <div class="wrapper">
          <%= render :partial => "/refinery/blog/shared/post", :collection => @posts_notfeatured %>
          </div>
          <%= will_paginate @posts_notfeatured %>
        </section>
      <% else %>
        <p><%= t('.no_blog_articles_yet') %></p>
      <% end %>
    </section>
  </div>
<% end %>

<% content_for :side_body_prepend do -%>
  <%#= raw @page.content_for(Refinery::Pages.default_parts.second.to_sym) %>
<% end if Refinery::Pages.default_parts.any? -%>
<%#= render '/refinery/blog/shared/body_content_right' %>

<%#= render "/refinery/content_page" %>
<% content_for :stylesheets, stylesheet_link_tag('refinery/blog/frontend') %>
<div class="blog-index">
    <!--<h1>Closers News</h1>-->
    <%#= blog_rss_link(:header_corner => true) %>
    <%= raw content_for :body %>
</div><!-- end of blog index -->
<%# content_for :javascripts do %>
  <%#= javascript_include_tag 'app/blog_index.js' %>
<%# end %>