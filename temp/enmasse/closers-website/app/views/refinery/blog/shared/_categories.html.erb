<%# if @categories != nil and @categories.any? %>
<nav class="category_nav">
  <ul id='categories'>
    <% @categories.each do |category| %>
    <% if(category.title.downcase == 'featured') %>
    <% else %>
      <!--<li data-select=<%= category.title %> <%= " class='selected' " if @category.present? and @category.id == category.id %>>-->
      <li <%= " class=selected " if @category.present? and @category.id == category.id %>>
        <%= link_to "#{category.title}", refinery.blog_category_path(category) %>
        </li>
      <!--</li>-->
      <% end %>
    <% end %>
  </ul>
 </nav>
<%# end %>


