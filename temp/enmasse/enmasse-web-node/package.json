{
  "name": "enmasse-website",
  "version": "2.0.0",
  "description": "Minimal Apostrophe Boilerplate",
  "main": "app.js",
  "scripts": {
    "start": "nodemon app.js"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "Heather Boylan, Geunwoo Shin",
  "license": "All Rights Reserved",
  "dependencies": {
    "apostrophe": "^2.101.1",
    "apostrophe-redirects": "^2.2.0",
    "apostrophe-site-map": "^2.5.1",
    "apostrophe-workflow": "^2.30.0",
    "async": "^3.0.1",
    "dotenv": "^8.2.0"
  },
  "nodemonConfig": {
    "verbose": true,
    "watch": [
      "app.js",
      "lib/modules"
    ],
    "ignore": [
      "lib/modules/*/public/js/*.js",
      "locales/*.json",
      "public/modules/**/*.less",
      "public/modules/**/*.js",
      "public/uploads",
      "public/apos-minified/*.js",
      "public/css/master-*.less",
      "data"
    ],
    "ext": "json, js, html, less"
  },
  "devDependencies": {
    "apostrophe-blog": "^2.2.1",
    "apostrophe-headless": "^2.9.2",
    "nodemon": "^1.19.4",
    "rss": "^1.2.2"
  }
}
