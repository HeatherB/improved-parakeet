ams_api:
  ams:
    base_url: '<%= fetch :ams_api_base_url %>'
    auth_token: '<%= fetch :ams_auth_token %>'
  facebook:
    id: YOUR_FB_ID
    secret: YOUR_FB_SECRET
  vip:
    active: <% fetch :ams_vip_active %>
    exp_factor: <% fetch :ams_vip_exp_factor %>
    token_factor: <% fetch :ams_vip_token_factor %>
