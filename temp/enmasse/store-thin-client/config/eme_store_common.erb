more_set_headers 'Server: SPARKLES!';

proxy_redirect off;
proxy_buffering on;
proxy_buffers 8 16k;
proxy_intercept_errors on;
recursive_error_pages on;

#limit_conn limit_connections_per_ip 8;

location @unicorn_files {
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header Host $http_host;
  
  proxy_buffers 16 64k;
  
  proxy_pass http://<%= "#{fetch(:application)}" %>;
}

location ~ ^/.+$ {
  access_log off;
  expires max;
  add_header Cache-Control public;
  
  try_files $uri @unicorn_files;
}

error_page 400 403 404 =404 /404.html;
location /404.html {
  allow all;
  internal;
}

error_page 500 502 503 504 /500.html;
location /500.html {
  allow all;
  internal;
}