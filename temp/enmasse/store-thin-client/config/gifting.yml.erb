gifting:
  url: <%= "#{fetch(:gifting_url)}" %>
  ssl: <%= "#{fetch(:gifting_use_ssl)}" %>
  auth_key: "<%= "#{fetch(:gifting_auth_key)}" %>"
  use_memcache: <%= "#{fetch(:gifting_use_memcache)}" %>
  memcache_hosts: 
  <% fetch(:gifting_memcached_hosts).each do |memsrv| %>
    - <%= memsrv %>
  <% end %>
  cache_prefix: <%= "#{fetch(:gifting_cache_prefix)}" %>
  type: <%= "#{fetch(:gifting_type)}" %>

  tera:
    enabled: <%= fetch(:gifting_tera_enabled) %>
    promotion_id: <%= "#{fetch(:gifting_tera_promo_id)}" %>
    gift_kind_id: <%= "#{fetch(:gifting_tera_gift_kind_id)}" %>

  kritika:
    enabled: <%= fetch(:gifting_kritika_enabled) %>
    promotion_id: <%= "#{fetch(:gifting_kritika_promo_id)}" %>
    gift_kind_id: <%= "#{fetch(:gifting_kritika_gift_kind_id)}" %>

  closers:
    enabled: <%= fetch(:gifting_closers_enabled) %>
    promotion_id: <%= "#{fetch(:gifting_closers_promo_id)}" %>
    gift_kind_id: <%= "#{fetch(:gifting_closers_gift_kind_id)}" %>

  potion_shack:
    enabled: <%= fetch(:gifting_potion_enabled) %>
    group_promo_code: <%= "#{fetch(:gifting_potion_shack_group_promo_code)}" %>
    catalysts_per_try: <%= "#{fetch(:gifting_potion_shack_catalysts_per_try)}" %>
