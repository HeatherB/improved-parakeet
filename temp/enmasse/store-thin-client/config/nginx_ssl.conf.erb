server { 
	listen 			<%= "#{fetch(:server_ssl_port)}" %> ssl;
	server_name 	<%= "#{fetch(:server_url)}" %>;

	ssl_certificate     <%= "#{fetch(:server_ssl_cert)}" %>;
	ssl_certificate_key <%= "#{fetch(:server_ssl_key)}" %>;
	
    keepalive_timeout 	<%= "#{fetch(:server_keepalive)}" %>;

	access_log 		<%= "#{fetch(:server_url_access_log)}" %> combined;
	error_log 		<%= "#{fetch(:server_url_error_log)}" %> warn;
	
    # Location of our static files
    root <%= "#{fetch(:current_path)}" %>/public;

	proxy_read_timeout 360;
	proxy_send_timeout 360;

	location @unicorn_https {
	  proxy_set_header X-Forwarded-Proto https;
	  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	  proxy_set_header Host $http_host;

	  proxy_pass http://<%= "#{fetch(:application)}" %>;
	}

	error_page 400 403 404 =404 /404.html;
	location /404.html {
	  allow all;
	  internal;
	}

	error_page 500 502 503 504 /500.html;
	location /500.html {
	  allow all;
	  internal;
	}
	
	try_files $uri @unicorn_https;
}

server {
	listen 			<%= "#{fetch(:server_ssl_port)}" %> ssl;
	server_name 	<%= "#{fetch(:server_admin_url)}" %>;

	ssl_certificate     <%= "#{fetch(:server_ssl_cert)}" %>;
	ssl_certificate_key <%= "#{fetch(:server_ssl_key)}" %>;
	
    keepalive_timeout 	<%= "#{fetch(:server_keepalive)}" %>;

	access_log 		<%= "#{fetch(:server_admin_url_access_log)}" %> combined;
	error_log 		<%= "#{fetch(:server_admin_url_error_log)}" %> warn;
	
    # Location of our static files
    root <%= "#{fetch(:current_path)}" %>/public;

	proxy_read_timeout 360;
	proxy_send_timeout 360;
	
	allow 70.90.181.49;
	allow 208.67.48.0/24;
	allow 10.63.0.0/16;
	allow 127.0.0.1;
	deny all;
	
	client_body_buffer_size 32k;
	client_max_body_size 1024m;
	
	location = / {
		rewrite ^(.*) /refinery permanent;
	}

	proxy_redirect off;
	proxy_buffering on;
	proxy_buffers 8 16k;
	proxy_intercept_errors on;
	recursive_error_pages on;

	location @unicorn {
	  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	  proxy_set_header Host $http_host;

	  proxy_pass http://<%= "#{fetch(:application)}" %>;
	}

	location @unicorn_https {
	  proxy_set_header X-Forwarded-Proto https;
	  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	  proxy_set_header Host $http_host;

	  proxy_pass http://<%= "#{fetch(:application)}" %>;
	}

	location @unicorn_files {
	  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	  proxy_set_header Host $http_host;

	  proxy_buffers 16 64k;

	  proxy_pass http://<%= "#{fetch(:application)}" %>;
	}

	location @memcached_fallback {
	  try_files $uri @unicorn;
	}

	location @memcached_fallback_https {
	  try_files $uri @unicorn_https;
	}

	location ~ ^/assets/.+$ {
	  access_log off;
	  expires max;
	  add_header Cache-Control public;

	  try_files $uri @unicorn_files;
	}

	location ~ ^/system/.+$ {
	  access_log off;
	  expires max;
	  add_header Cache-Control public;

	  try_files $uri @unicorn_files;
	}

	location ~ ^.+\.(css|js|jpg|jpeg|gif|png|tiff|swf|flv|mov|mp4|ogv|webm|eot|svg|ttf|woff|ico)$ {
	  access_log off;
	  expires max;
	  add_header Cache-Control public;

	  try_files $uri @unicorn_files;
	}

	error_page 400 403 404 =404 /404.html;
	location /404.html {
	  allow all;
	  internal;
	}

	error_page 500 502 503 504 /500.html;
	location /500.html {
	  allow all;
	  internal;
	}
	
	try_files $uri @unicorn_https;
}
