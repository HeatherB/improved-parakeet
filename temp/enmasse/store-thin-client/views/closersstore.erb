  </head>
  <body class="no-js closersstore">
    <%= EMEGlobalAssets.snippet("eme-bar", {:create_link => "#{SimpleSSO::ACCOUNT_SERVER_SECURE_URL}/closers/sign-up" }) %>
    <main>
        <% if @saleperiod %>
            <div id="header" class="sale">
        <% else %>
            <div id="header">
        <% end %>
            <div class="banner">
            <% if session["from_steam"] %>
                <% if @empPromo %>
                    <h3 class="emp-special">Receive a bonus gift with your first purchase of EMP for TERA and Closers during the <a href="/back-to-school">Back to School</a> promotional period.</h3>
                <% end %>
                <a class="buyemp" href="/<%=session['from_steam']%>/steam-emp">Continue to Buy EMP</a>
            <% else %>
                <% if @empPromo %>
                    <h3 class="emp-special">Receive a bonus gift with your first purchase of EMP for TERA and Closers during the <a href="/back-to-school">Back to School</a> promotional period.</h3>
                <% end %>
                <a class="buyemp" href="/closers/emp">Continue to Buy EMP</a>
            <% end %>
            </div>
            <h1>AMAZING LIMITED-TIME DISCOUNTS &amp; FREEBIES, EVERY DAY!</h1>
            <div id="timer-section">
                <div id="hours" class="time"></div>
                <div id="minutes" class="time"></div>
                <div id="seconds" class="time"></div>
            </div>
        </div>
        <div id="items">
            <% @items.each_with_index do |item, index| %>
                <% if item.tags.include?("tag:free") %>
                    <% if item.tags.include?("tag:special-deal") || item.tags.include?("category:special-deal") %>
                        <div class="item special">
                            <div class="special-deal">Special Deal</div>
                    <% else %>
                        <div class="item">
                    <% end %>
                        <img src=<%= item.img_url %> />
                        <h3><%= item.name %></h3>
                        <div class="description"><%= item.long_description %><br /></div>
                        <div class="free">FREE</div>
                        <div class="code">
                            <small>Redeem Code In <span>Closers Game Launcher</span></small>
                            <img id="scissors" src="https://static.enmasse.com/images/closers/daily-deals/scissors.png" /><span id="free-code"><%= item.short_description %></span>
                        </div>
                    </div>
                <% else %>
                    <% if item.tags.include?("tag:special-deal") || item.tags.include?("category:special-deal") %>
                        <div class="item special">
                            <div class="special-deal">Special Deal</div>
                    <% else %>
                        <div class="item">
                    <% end %>
                        <img src=<%= item.img_url %> />
                        <h3><%= item.name %></h3>
                        <div class="description">
                            <div class="descrip_inner <%= 'over' if item.long_description.length > 160 %>">
                                <%#= item.long_description[0...160] %>
                                <%= item.long_description %>
                            </div>
                           
                            <% if item.long_description.length > 160 %>
                                <span class="hover-info">
                                    ...Read More
                                    <div id="aa-reveal" class="hover-reveal">
                                        <%= item.long_description %>
                                    </div>
                                </span>
                            <% end %>
                        </div>
                        <% if item.price.to_f > 0 %>
                            <div class="price"><img src="https://static.enmasse.com/images/Gifting/emp-icon.png" /><%= item.price %>
                                <% if item.details.to_f / (item.details.to_f + item.price.to_f) > 0 && item.details.to_f / (item.details.to_f + item.price.to_f) < 0.2 %>
                                    <div class="discount yellow"><%= (item.details.to_f / (item.details.to_f + item.price.to_f) * 100).round(0) %>% <br />Off</div>
                                <% elsif item.details.to_f / (item.details.to_f + item.price.to_f) >= 0.2 %>
                                    <div class="discount green"><%= (item.details.to_f / (item.details.to_f + item.price.to_f) * 100).round(0) %>% <br />Off</div>
                                <% end %>
                            </div>
                            <a class="yellow-btn buy-item" data-game="Closers" data-name="<%= item.name %>" data-image="<%= item.img_url %>" data-user="<%= @gameaccounts %>" data-price="<%= item.price %>" data-discount="<%= item.details %>" data-amount="<%= item.pretty_name[0] + "x" %>" data-id=<%= item.id %>>BUY NOW</a>
                        <% else %>
                            <div class="price">FREE</div>
                            <a class="yellow-btn buy-item free" data-game="Closers" data-name="<%= item.name %>" data-image="<%= item.img_url %>" data-user="<%= @gameaccounts %>" data-price="<%= item.price %>" data-discount="<%= item.details %>" data-amount="<%= item.pretty_name[0] + "x" %>" data-id=<%= item.id %>>CLAIM</a>
                        <% end %>
                    </div>
                <% end %>
            <% end %>
        </div>

        <div class="action_bar">
			<div class="inner">
				<div class="leftCol">
					<h4>Need More EMP?</h4>
                    <% if session["from_steam"] %> 
                        <a class="purple_btn" href="/<%=session['from_steam']%>/steam-emp">
                            <span>Buy EMP</span>
                        </a>
                    <% else %>
                        <a class="purple_btn" href="/closers/emp">
                            <span>Buy EMP</span>
                        </a>
                    <% end %>
				</div>
                <% if session["from_steam"] %> 
                <% else %>
				<div class="rightCol" style="display: none;">
					<h4>Want More Deals?</h4>
					<a class="purple_btn" href="http://closers.enmasse.com/store/limited-time-bundles"><!-- Add disabled class to disable -->
						<span>Limited Time Deals</span>
					</a>
				</div>
                <% end %>
               <!-- <div class="row">
                    <div class="disclaimer twelve columns">
                    <%#= EMEGlobalAssets.snippet("copyright", {:game => "eme"}) %>
                    <a href="https://www.enmasse.com/legal/privacy-policy">Privacy Policy</a>
                    </div>
                </div>-->
			</div>
		</div>
    </main>

    <%= EMEGlobalAssets.snippet("footer") %>
    
    <%#= erb :"shared/item-modal" %>

    <div id="confirmation">
        <div id="confirm" class="box">
            <h3 style="background: #2e2e2e;">Confirm Purchase<span class="close">X</span></h3>
            <div class="wrap">
                <img class="thumb" src="">
                <div class="info">
                    <div class="text">You are about to purchase one <b>Closers Golden Gift Box</b> from the <i>Closers</i> Web store for 12800 EMP. Please confirm that you wish to purchase and apply this item to your account at this time. This product is for <i>Closers</i> PC only.</div> 
                    <ul>
                        <li>Original Price: <img src="https://static.enmasse.com/images/Gifting/emp-icon.png" /> <div id="original"></div></li>
                        <li>Discount: <img src="https://static.enmasse.com/images/Gifting/emp-icon.png" /> <div id="discount"></div></li>
                        <li><b>Total: <img src="https://static.enmasse.com/images/Gifting/emp-icon.png" /> <div id="total"></div></b></li>
                    </ul>
                    <div class="button-group">
                        <button class="close">Cancel</button>
                        <button id="buynow" class="blue">Buy Now</button>
                    </div>
                </div>
            </div>
        </div>
        <div id="purchase" class="box">
            <h3 style="background: #4b8341;"><span class="title">Purchase Successful</span><span class="close">X</span></h3>
            <div class="wrap">
                <img class="thumb" src="">
                <div class="info">
                    <div class="text"></div>
                </div>
            </div>
        </div>
        <div id="failed" class="box">
            <h3 style="background: #ad3434;"><span class="title">Purchase Failed</span><span class="close">X</span></h3>
            <div class="wrap">
                <img class="thumb" src="">
                <div class="info">
                    <div class="text"></div>
                    <div class="button-group">
                        <button class="close">Cancel</button>
                        <button class="buyemp blue">Buy EMP</button>
                    </div>
                </div>
            </div>
        </div>
        <div id="loginfailed" class="box">
            <h3 style="background: #ad3434;">Hold On a Second!<span class="close">X</span></h3>
            <div class="wrap">
                <img class="thumb" src="">
                <div class="info">
                    <div class="text"></div>
                    <div class="button-group">
                        <button class="close">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%= js  :app %>

    <script>
      document.body.className = document.body.className.replace("no-js","js");
    </script>
    <%= EMEGlobalAssets.snippet("sso-init", {:account_server => SimpleSSO::ACCOUNT_SERVER}) %>

  </body>
</html>