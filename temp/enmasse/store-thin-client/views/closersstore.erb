<%
  @sale_start = Time.new(2018,  05, 15, 10, 00, 00, "-08:00")
  @sale_end =   Time.new(2018,  05, 21, 10, 00, 00, "-08:00") # year, month, day, hour, minute, second

  @saleperiod = ((Time.now > @sale_start) && (Time.now < @sale_end))
%>

<%
  @empPromo_start = Time.new(2019,  8, 28, 10, 00, 00, "-08:00")
  @empPromo_end =   Time.new(2019,  9, 17, 12, 59, 00, "-08:00")

  @empPromo = ((Time.now > @empPromo_start) && (Time.now < @empPromo_end))
%>

<!DOCTYPE html>
<!--[if IEMobile 7 ]> <html dir="ltr" lang="en-US"class="no-js iem7"> <![endif]-->
<!--[if lt IE 7 ]> <html dir="ltr" lang="en-US" class="no-js ie6 oldie"> <![endif]-->
