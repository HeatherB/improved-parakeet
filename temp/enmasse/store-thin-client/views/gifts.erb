<%
  @holiday = 'wintera'
%>
<section id="wide_body" class="row <%= @holiday %>">
  <span id="possible" class="hidden" data-possible='<%= @possible.to_json.gsub("'", "&apos;") %>'></span>

  <% if @game_accounts && @game_accounts.empty? %>
    <div class="warn-alert">
      <span class="icon"></span>Please add <em><%= @game %></em> to your En Masse account via your <a href="<%= SimpleSSO::ACCOUNT_SERVER_SECURE_URL %>">Account Overview</a> page.
    </div>
  <% end %>

  <div class="gifting">

    <div class="reminder">
      <h3>Last chance to purchase golden gift boxes, sales end on January 3rd, 2019!</h3>
      <h4>Gifting shuts down until next year in...</h4>
      <div id="countdown">
        <div class="timer" id="hours">54</div>
        <div class="timer" id="minutes">5</div>
        <div class="timer" id="seconds">12</div>
      </div>
    </div>

    <% if @holiday === 'anniversary' %>
      <h1 class="text-align-center">Welcome to the <em><%= @game %></em> Sixth Anniversary—Celebration of Giving!</h1>
    <% end %>

    <% if @holiday === 'wintera' %>
      <div class="inner intro">
        <p>Welcome to the Gifting Center for <em><% if @game.capitalize != "Kritika" %><%= @game.upcase %><% else %><em>Kritika Online</em><% end %></em>. The holiday season is upon us and the spirit of giving is in the air. What better way to celebrate than by earning some of 
        <% if @game.capitalize == "Kritika" %>
          <a href="https://kritika.enmasse.com/news/posts/golden-gift-box-2018">
        <% elsif @game.capitalize == "Closers" %>
          <a href="https://closers.enmasse.com/news/posts/golden-gift-boxes-2018">
        <% elsif @game.capitalize == "Tera" %>
          <a href="http://tera.enmasse.com/news/posts/golden-gift-boxes-are-back-for-the-holidays">
        <% end %>
        this year’s most popular <% if @game.capitalize != "Kritika" %><em><%= @game.upcase %></em><% else %><em>Kritika Online</em><% end %> items
        </a>
        by buying and sending golden gift boxes to your friends?</p>
        <% if @game.downcase == 'tera' %>
          <a href="/tera" class="colorbtn">Buy More Gift Boxes</a>
        <% end %>
        <% if @game.downcase == 'closers' %>
          <a href="/closers/items" class="colorbtn">Buy More Gift Boxes</a>
        <% end %>
        <% if @game.downcase == 'kritika' %>
          <a href="/kritika/items" class="colorbtn">Buy More Gift Boxes</a>
        <% end %>
        <a href="#" class="colorbtn gifting-faq">See How Gifting Works</a>
      </div>
      <div class="heading">
        <h2>Gifting Rewards</h2>
        <p>Checkout the great rewards you get for gifting this season:</p>
      </div>
    <% elsif @holiday === 'anniversary' %>
      <h1><em><%= game %>'</em>s got a lot going on this month, celebrating all the cool things we've done together over the last five years. And what better way to celebrate than with free stuff?</h1>
      <h2>Here's how it works:</h2>
      <ol>
        <li>1) Buy Fifth Anniversary gift boxes in the <a href="/<%= @game %>#wide_body"><em><% if @game.capitalize != "Kritika" %><%= @game.upcase %><% else %>Kritika Online<% end %></em> store.</a></li>
        <li>2) You can open a box for yourself to find one of dozens of prizes, such as valuable consumables, inner armor, mounts, costumes, or even EMP jackpots; or </li>
        <li>3) You can give boxes to your friends and earn special rewards, depending on how many gifts you send:
          <ul class="circle">
            <li>Send 1 box to a friend, and you receive Kelsaik's Crown (a permanent cosmetic accessory for use by a single character).</li>
            <li>Send 3 boxes, and you receive a 30-day Elite Status voucher!</li>
            <li>Send 5 boxes, and you earn a Fiery Halo (a permanent cosmetic accessory for use by a single character).</li>
            <li>Send 10 boxes, and you earn an account-bound, permanent Cheeks pet. This fan-favorite companion gives all of your characters a special popo-pocket of 72 extra inventory slots!</li>
            <li>Send 15 boxes, and you earn an account-bound Ultraplasm weapon skin. This out-of-this-world item gives any weapon you equip a menacing crimson glow. (Note: this weapon skin does not work on runeglaives.)</li>
          </ul>
        </li>
      </ol>
    <% else %>
      <h1>Give a Sweet Gift of Surprise!</h1>

      <ul class="disc">
        <li>Buy a <a href="/<%= @game %>/item/blackbox/black-velvet-party-box">Black Velvet party box</a> or <a href="/<%= @game %>/item/whitebox/white-satin-party-box">White Satin party box</a></li>
        <li>The box will appear in the gifting center (below).</li>
        <li>Give party boxes to friends or open them for yourself—everyone loves gifts!</li>
        <li>Earn rewards by sending party boxes to friends and sweethearts.</li>
      </ul>

      <p>You can earn dyeable Princess Rida maid uniforms (one for every five gifts you send!), an Ember mount, and a Cheeks pet! It’s a great way to show people you care—and get something for yourself out of the deal, too!</p>
      <p>Hurry! You can only purchase party boxes until February 18 at 11 a.m. PST. You'll still be able to gift or open any gifts you've purchased or received, but the chance to buy more will be gone.</p>
    <% end %>

  </div>

  <% if @holiday === 'wintera' %>
    <ul id="rewards_carousel" class="emeslides">
      <li data-label="1">
        <img src="http://download.enmasse.com/store/<%= @game %>/2018-gifting/Rewards/Reward_1.jpg" alt="Gifting Reward" />

