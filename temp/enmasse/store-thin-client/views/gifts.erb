            </div>
          </div>
        <% end %>
      </li>

      <li data-label="10">
        <img src="http://download.enmasse.com/store/<%= @game %>/2018-gifting/Rewards/Reward_10.jpg" alt="Gifting Reward" />

        <% if @game.downcase == 'tera' %>
          <div class="carousel_about">
            <div class="heading">
              <span class="icon tenth"></span>
