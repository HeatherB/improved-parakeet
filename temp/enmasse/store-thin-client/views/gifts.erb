            </div>
          </div>
        <% elsif @game.downcase == 'kritika' %>
          <div class="carousel_about">
            <div class="heading">
              <span class="icon tenth"></span>
              <h3>
                <span class="label">1&mdash;Box Reward:</span> 
                Mysterious Key Bundle
              </h3>
            </div>
            <div class="copy">
              <p>Opens a sealed Mysterious Box.</p>
            </div>
          </div>
        <% end %>
      </li>

      <li data-label="5">
        <img src="http://download.enmasse.com/store/<%= @game %>/2018-gifting/Rewards/Reward_5.jpg" alt="Gifting Reward" />

        <% if @game.downcase == 'tera' %>
          <div class="carousel_about">
            <div class="heading">
              <span class="icon fifth"></span>
              <h3>
                <span class="label">5&mdash;Box Reward:</span> 
