<%
  @blackfriday_start = Time.new(2017,  11, 24, 9, 00, 00, "-07:00")
  @blackfriday_end =   Time.new(2017,  11, 28, 9, 00, 00, "-07:00")

  @blackfriday = ((Time.now > @blackfriday_start) && (Time.now < @blackfriday_end))
%>

