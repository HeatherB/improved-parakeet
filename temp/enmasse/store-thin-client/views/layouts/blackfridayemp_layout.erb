  <body class="no-js blackfridayemp">
    <%= EMEGlobalAssets.snippet("eme-bar", {:create_link => "#{SimpleSSO::ACCOUNT_SERVER_SECURE_URL}/#{@game}/sign-up" }) %>

    <main>
        <img class="header" style="height: 423px; width: 100%; object-fit: cover" src="https://static.enmasse.com/images/BlackFriday/EMP/header2.jpg" alt="Black Friday Sale" />
        <div class="intro">
            <div class="wrapper">
                <h1>Get premium items with your EMP purchase!</h2>
                <span class="desc">Starting at 9 a.m. PST on Nov. 24 and ending Nov. 28 at 9 a.m. PST.</span>
            </div>
        </div>

        <section class="deal">
            <div class="cost" style="background-image: url(https://static.enmasse.com/images/BlackFriday/EMP/Prices/250.jpg)">
                <div class="promo"><span>40%</span><br />Bonus + Gifts</div>
                <% if @blackfriday %><a href="/enmasse/emp" class="btn">Buy EMP</a><% end %>
            </div>
            <div class="wrap">
                <button class="show-btn hidden"><div class="before-arrow down"></div>Show Gift Details<div class="after-arrow down"></button>
                <div class="deals hidden">
                    <div class="item tera" style="background-image: url(https://static.enmasse.com/images/BlackFriday/EMP/Deals/tera1.jpg);">
                        <h2>Tera</h2>
                        <span>Elin Cutie Star Shopping Spree Box</span>
                        <div class="text">Open this box on or after November 30, 2017 to receive the Black Friday exclusive, Elin Cutie Star outfit and matching Blue Headset accessory.</div>
                    </div>
                    <div class="item kritika" style="background-image: url(https://static.enmasse.com/images/BlackFriday/EMP/Deals/kritika2.jpg);">
                        <h2>Kritika</h2>
                        <span>A Complete Costume Set!</span>
                        <div class="text">Choose 1 of 3 complete costumes, the Bractholme, Lotus Monastery, or the Roseguard!<br /> Plus get 20 Lucky Pandora Boxes. </div>
                    </div>
                    <div class="item closers" style="background-image: url(https://static.enmasse.com/images/BlackFriday/EMP/Deals/closers1.jpg);">
                        <h2 style="margin-bottom: -5px;">Closers</h2>
                        <span style="margin-bottom: 0;">Midnight Phase Wings 1-Star</span>
                        <div class="text">Snow Fox Accessory Box<br /> Ultimate Equalizer<br /> Enhancement Fortifier<br /> Dioxin Cleaner x2<br /> Color Contact Lens 4-Pack<br /></div>
                    </div>
                    <div class="item ava" style="background-image: url(https://static.enmasse.com/images/BlackFriday/EMP/Deals/ava1.jpg);">
                        <h2>Ava</h2>
                        <span>Fortune Star Pack Items!</span>
                        <div style="font-size: 16px;" class="text">Get the fourth tier of bonus sidearms from when each of the Fortune Star bundles was originally on sale, plus the items from the 12000, 4600, 2200, and 1000 AVA EMP reward tiers!</div>
                    </div>
                </div>
            </div>
        </section>
        <section class="deal">
            <div class="cost" style="background-image: url(https://static.enmasse.com/images/BlackFriday/EMP/Prices/100.jpg)">
                <div class="promo"><span>20%</span><br />Bonus + Gifts</div>
                <% if @blackfriday %><a href="/enmasse/emp" class="btn">Buy EMP</a><% end %>
            </div>
            <div class="wrap">
                <button class="show-btn hidden"><div class="before-arrow down"></div>Show Gift Details<div class="after-arrow down"></button>
                <div class="deals hidden">
                    <div class="item tera" style="background-image: url(https://static.enmasse.com/images/BlackFriday/EMP/Deals/tera1.jpg);">
                        <h2>Tera</h2>
                        <span>20x Opening Act Loot Boxes</span>
                        <div class="text">Get twenty loot boxes, each of which has a chance to contain an Elin Cutie Star Shopping Spree Box or other consumable items.</div>
                    </div>
                    <div class="item kritika" style="background-image: url(https://static.enmasse.com/images/BlackFriday/EMP/Deals/kritika2.jpg);">
                        <h2>Kritika</h2>
                        <span>45 Lucky Pandora Boxes</span>
                        <div class="text">Choose between the 1st or 2nd Lucky Pandora Box and start opening them for a variety of costumes, consumables, gold, and even a few days of Elite!</div>
                    </div>
                    <div class="item closers" style="background-image: url(https://static.enmasse.com/images/BlackFriday/EMP/Deals/closers2.jpg);">
                        <h2>Closers</h2>
                        <span>Snow Fox Accessory Box</span>
                        <div class="text">Ultimate Equalizer<br /> Enhancement Fortifier<br /> Dioxin Cleaner x2<br /> Color Contact Lens 4-Pack</div>
                    </div>
                    <div class="item ava" style="background-image: url(https://static.enmasse.com/images/BlackFriday/EMP/Deals/ava2.jpg);">
                        <h2>Ava</h2>
                        <span>Fortune Star Pack Items!</span>
                        <div style="font-size: 16px;" class="text">Get the third tier of bonus sidearms from when each of the Fortune Star bundles was originally on sale, plus the items from the 4600, 2200, and 1000 AVA EMP reward tiers!</div>
                    </div>
                </div>
            </div>
        </section>
        <section class="deal">
            <div class="cost" style="background-image: url(https://static.enmasse.com/images/BlackFriday/EMP/Prices/40.jpg)">
                <div class="promo"><span>15%</span><br />Bonus + Gifts</div>
                <% if @blackfriday %><a href="/enmasse/emp" class="btn">Buy EMP</a><% end %>
            </div>
            <div class="wrap">
                <button class="show-btn hidden"><div class="before-arrow down"></div>Show Gift Details<div class="after-arrow down"></button>
                <div class="deals hidden">
