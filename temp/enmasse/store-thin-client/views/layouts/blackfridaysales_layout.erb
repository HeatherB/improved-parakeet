<head>
    <title><%= @title %></title>
    <link rel="shortcut icon" href="https://eme01.enmasse-game.com/images/global_assets/globalfav.ico" sizes="16x16 24x24 32x32 48x48">
    <% if @item %>
    <link rel="canonical" href="<%= request.base_url %><%= @item.link %>"/>
    <% end %>
    <link rel="image_src" href="<%= img_url('ico_store.png') %>">
    <link rel="icon" href="https://eme01.enmasse-game.com/images/global_assets/globalfav.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-57x57.png') %>" sizes="57x57">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-72x72.png') %>" sizes="72x72">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-76x76.png') %>" sizes="76x76">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-114x114.png') %>" sizes="114x114">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-120x120.png') %>" sizes="120x120">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-144x144.png') %>" sizes="144x144">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-152x152.png') %>" sizes="152x152">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-180x180.png') %>" sizes="180x180">


    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%= erb :"shared/google-analytics" %>
    <style type="text/css">
      @font-face {
          font-family: 'serif6_beta_rgbold';
          src: url('/fonts/serif6beta-bold-webfont.eot');
          src: url('/fonts/serif6beta-bold-webfont.eot?#iefix') format('embedded-opentype'),
               url('/fonts/serif6beta-bold-webfont.woff') format('woff'),
               url('/fonts/serif6beta-bold-webfont.ttf') format('truetype'),
               url('/fonts/serif6beta-bold-webfont.svg#serif6_beta_rgbold') format('svg');
          font-weight: bold;
          font-style: normal;
      }
      @font-face {
          font-family: 'serif6_beta_rgitalic';
          src: url('/fonts/serif6beta-italic-webfont.eot');
          src: url('/fonts/serif6beta-italic-webfont.eot?#iefix') format('embedded-opentype'),
               url('/fonts/serif6beta-italic-webfont.woff') format('woff'),
               url('/fonts/serif6beta-italic-webfont.ttf') format('truetype'),
               url('/fonts/serif6beta-italic-webfont.svg#serif6_beta_rgitalic') format('svg');
          font-weight: normal;
          font-style: italic;
      }
    </style>
    <%= css :eme, :media => 'screen' %>
    <%= css :blackfridaysales, :media => 'screen' %>
    <%# stylesheet_link_tag "extralife" %>

    <!--[if lt IE 9]>
      <%= css 'tera/ie', :media => 'screen' %>
      <script>
        document.createElement('header');
        document.createElement('nav');
        document.createElement('section');
        document.createElement('article');
        document.createElement('aside');
        document.createElement('footer');
        document.createElement('hgroup');
      </script>
    <![endif]-->
  </head>
  <body class="no-js blackfridaysales">
    <%= EMEGlobalAssets.snippet("eme-bar", {:create_link => "#{SimpleSSO::ACCOUNT_SERVER_SECURE_URL}/#{@game}/sign-up" }) %>

    <main>
        <img class="header" style="height: 423px; width: 100%; object-fit: cover" src="https://static.enmasse.com/images/BlackFriday/Sales/header2.jpg" alt="Black Friday Sale" />
        <div class="intro">
            <div class="wrapper">
                <h1>We're offering <span class="purple">daily discounts</span> on items in all our games!</h2>
                <span class="desc">All sales start at 9 a.m. PST and conclude at 9 a.m. the following day.</span>
            </div>
        </div>
        <div id="sales-container">
            <section id="sales-tabs">
                <div class="tab selected" data-tab="friday">
                    <h3>Friday</h3>
                    <span>November 24</span>
                </div>
                <div class="tab" data-tab="saturday">
                    <h3>Saturday</h3>
                    <span>November 25</span>
                </div>
                <div class="tab" data-tab="sunday">
                    <h3>Sunday</h3>
                    <span>November 26</span>
                </div>
                <div class="tab" data-tab="monday">
                    <h3>Monday</h3>
                    <span>November 27</span>
                </div>
            </section>
            <section id="sales">
                <section class="sale-section friday selected">
                    <div class="sale" style="background-position: 0 0;">
                        <h2>Tera</h2>
                        <h4>Pets and Mounts!</h4>
                        <p>Up to <b>75% off</b> direct sale mounts and pets and <b>33% off</b> loot boxes containing rare pets and mounts.</p>
                        <p>All account services and consumables are <b>50% off</b>! Elite status vouchers are <b>25% off</b>!</p>
                        <p>Previous Black Friday items including the BFF Loot Box, the Blackheart Loot Box, and the Darkflame Loot Box are also available!</p>
                        <a href="https://store.enmasse.com/tera/items/sale" class="btn">Check it out!</a>
                    </div>
                    <div class="sale" style="background-position: 0 -313px;">
                        <h2>Closers</h2>
                        <h4>New Chibi Pet — Mini Alraune Blossom Pet</h4>
                        <p>Bundle includes rename ticket and pet food. Two bundles: one for an egg, and one for adult.</p>
                        <div class="visitstore">Visit the <br />in-game store to purchase</div>
                    </div>
                    <div class="sale" style="background-position: 0 -626px;">
                        <h2>Kritika Online</h2>
                        <h4>Pets and Weapon Skins</h4>
                        <p>Get up to <b>50% off</b> a variety of Pets and Weapon skins! Don’t miss your chance to grab the Celestial weapon skins, Puffle, and Bunabus all at <b>50% off</b>. We also have the beloved Kachu at <b>30% off</b>!</p>
                        <div class="visitstore">Visit the <br />in-game store to purchase</div>
                    </div>
                    <div class="sale" style="background-position: 0 -939px;">
                        <h2>AVA</h2>
                        <h4>sFortuna Fortune Stars</h4>
                        <p>Fortune Star weapon bundles are on sale for up to <b>72% off</b>!</p>
                        <p>Today’s big jackpot weapon is the <b>Stella Fortuna 9</b></p>
                        <a href="https://ava-shop.enmasse.com/" class="btn">Check it out!</a>
                    </div>
                </section>
                <section class="sale-section saturday">
                    <div class="sale" style="background-position: 0 0;">
                        <h2>Tera</h2>
                        <h4>Weapon Skins!</h4>
                        <p>Up to <b>75% off</b> weapon skins and <b>33% off</b> loot boxes containing rare weapon skins.</p>
                        <p>All account services and consumables are <b>50% off</b>! Elite status vouchers are <b>25% off</b>!</p>
                        <p>Previous Black Friday items including the BFF Loot Box, the Blackheart Loot Box, and the Darkflame Loot Box are also available!</p>
                        <a href="https://store.enmasse.com/tera/items/sale" class="btn">Check it out!</a>
                    </div>
                    <div class="sale" style="background-position: 0 -315px;">
                        <h2>Closers</h2>
                        <h4>New Verita Brigadier Premium Costume</h4>
                        <p><b>30% discount</b> on the costume — including the limited-time Young Irina Soaring Phase Light</p>
                        <div class="visitstore">Visit the <br />in-game store to purchase</div>
                    </div>
                    <div class="sale" style="background-position: 0 -630px;">
                        <h2>Kritika Online</h2>
                        <h4>Costumes</h4>
                        <p>Get up to <b>50% off</b> a variety of Costumes! Suit up at half off with the Dragoon, Streetwise, K-School attire, plus many more!</p>
                        <div class="visitstore">Visit the <br />in-game store to purchase</div>
                    </div>
                    <div class="sale" style="background-position: 0 -945px;">
                        <h2>AVA</h2>
                        <h4>Medal of Valor Fortune Stars</h4>
                        <p>Fortune Star weapon bundles are on sale for up to <b>72% off</b>!</p>
                        <p>Today’s big jackpot weapon is the <b>M24S, Medal of Valor</b>.</p>
                        <a href="https://ava-shop.enmasse.com/" class="btn">Check it out!</a>
                    </div>
                </section>
                <section class="sale-section sunday">
                    <div class="sale" style="background-position: 0 0;">
                        <h2>Tera</h2>
                        <h4 style="margin-bottom: 10px;">Costumes and Accessories!</h4>
                        <p>Up to <b>85% off</b> direct sale costumes and accessories and <b>33% off</b> loot boxes containing rare costumes and accessories.</p>
                        <p>All account services and consumables are <b>50% off</b>! Elite status vouchers are <b>25% off</b>!</p>
                        <p>Previous Black Friday items including the BFF Loot Box, the Blackheart Loot Box, and the Darkflame Loot Box are also available!</p>
                        <a href="https://store.enmasse.com/tera/items/sale" class="btn">Check it out!</a>
                    </div>
                    <div class="sale" style="background-position: 0 -315px;">
                        <h2>Closers</h2>
                        <p>Tuning Package Bundles <b>30% off</b></p>
                        <p>Enforcement Package bundles <b>40% off</b></p>
                        <div class="visitstore">Visit the <br />in-game store to purchase</div>
                    </div>
                    <div class="sale" style="background-position: 0 -630px;">
                        <h2>Kritika Online</h2>
                        <h4>Gear Up</h4>
                        <p>Get up to <b>50% off</b> Fix-It Hammers, Whetstones, Resurrection Stones, and Potions. For this day only there is NO purchase limit so now is the time to stock up.</p>
                        <p>No purchase limit!</p>
                        <div class="visitstore">Visit the <br />in-game store to purchase</div>
                    </div>
                    <div class="sale" style="background-position: 0 -945px;">
                        <h2>AVA</h2>
                        <h4>Dreamcatcher Fortune Stars</h4>
                        <p>Fortune Star weapon bundles are being going on sale for up to <b>72% off</b>!</p>
                        <p>Today’s big jackpot weapon is the <b>M4A1 Dreamcatcher</b></p>
                        <a href="https://ava-shop.enmasse.com/" class="btn">Check it out!</a>
                    </div>
                </section>
                <section class="sale-section monday">
                    <div class="sale" style="background-position: 0 0;">
                        <h2>Tera</h2>
                        <h4>Best Sellers!</h4>
                        <p>Some of the best-selling items and hottest discounts from the sale will return for one day only!</p>
                        <p>All account services and consumables are <b>50% off</b>! Elite status vouchers are <b>25% off</b>!</p>
                        <p>Previous Black Friday items including the BFF Loot Box, the Blackheart Loot Box, and the Darkflame Loot Box are also available!</p>
                        <a href="https://store.enmasse.com/tera/items/sale" class="btn">Check it out!</a>
                    </div>
                    <div class="sale" style="background-position: 0 -315px;">
                        <h2>Closers</h2>
                        <h4>Debut of Union Academy Costume</h4>
                        <p>Amazing item at <b>10% discount</b> and includes half rim glasses for a limited time.</p>
                        <div class="visitstore">Visit the <br />in-game store to purchase</div>
                    </div>
                    <div class="sale" style="background-position: 0 -630px;">
                        <h2>Kritika Online</h2>
                        <h4>Kred Discounts</h4>
                        <p>Stock up on Kred for the next few months and buy it on discount!</p>
                        <p>10,000 Kred for <b>30% off</b></p>
                        <p>5,000 Kred for <b>20%</span> off</b></p>
                        <p>2,000 Kred for <b>10%</span> off</b></p>
                        <div class="visitstore">Visit the <br />in-game store to purchase</div>
                    </div>
                    <div class="sale" style="background-position: 0 -945px;">
                        <h2>AVA</h2>
                        <h4>ARGUS Fortune Stars</h4>
                        <p>Fortune Star weapon bundles are on sale for up to <b>72% off</b>!</p>
                        <p>Today’s big jackpot weapon is the <b>ARGUS 556 Commando</b></p>
                        <a href="https://ava-shop.enmasse.com/" class="btn">Check it out!</a>
                    </div>
                </section>
            </section>
        </div>
        <div class="emp-promo">
            <div class="col col1">Get gifts with purchase of any amount of EMP this weekend!</div>
            <div class="col col2"><a href="/black-friday/emp-deals" class="btn">Learn More</a></div>
            <div class="col col3"><span>40<sup>%</sup></span> Bonus EMP with new $250 bundle</div>
        </div>
    </main>

    <div class="img-loader">
        <div class="img1"></div>
        <div class="img2"></div>
        <div class="img3"></div>
        <div class="img4"></div>
    </div>


