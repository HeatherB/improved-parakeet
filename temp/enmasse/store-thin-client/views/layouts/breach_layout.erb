    <style type="text/css">
      @font-face {
        font-family: "Shentox";
        font-style: normal;
        font-weight: normal;
        src: url("/fonts/breach/Shentox.woff2") format("woff2"),
             url("/fonts/breach/Shentox.woff") format("woff");
      }
      @font-face {
        font-family: "ShentoxItalic";
        font-style: normal;
        font-weight: normal;
        src: url("/fonts/breach/ShentoxItalic.woff2") format("woff2"),
             url("/fonts/breach/ShentoxItalic.woff") format("woff");
      }
      @font-face {
        font-family: "ShentoxBoldItalic";
        font-style: normal;
        font-weight: normal;
        src: url("/fonts/breach/ShentoxBoldItalic.woff2") format("woff2"),
             url("/fonts/breach/ShentoxBoldItalic.woff") format("woff");
      }

      @font-face {
        font-family: "HailsGRBook";
        font-style: normal;
        font-weight: normal;
        src: url("/fonts/breach/HalisGRRegular.woff2") format("woff2"),
             url("/fonts/breach/HalisGRRegular.woff") format("woff");
      }
      @font-face {
        font-family: "HailsGRBold";
