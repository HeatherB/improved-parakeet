  <body class="no-js breach">
    <%= EMEGlobalAssets.snippet("eme-bar", {:create_link => "#{SimpleSSO::ACCOUNT_SERVER_SECURE_URL}/breach/sign-up" }) %>

     
     <div id="page-content">
      <div class="site-alert alert-block">
      <% if flash[:error] %>
        <div class="error"><span class="icon"></span><span class="alert-msg"><%= flash[:error] %></span></div>
      <% end %>
      <% if flash[:warn] %>
        <div class="warning"><span class="icon"></span><span class="alert-msg"><%= flash[:warn] %></span></div>
      <% end %>
      <% if flash[:message] %>
        <div class="info"><span class="icon"></span><span class="alert-msg"><%= flash[:message] %></span></div>
      <% end %>
     </div>

      <%= yield %>
