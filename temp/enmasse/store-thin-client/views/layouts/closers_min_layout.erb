<!doctype html>
<html>
  <head>
    <title><%= @title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%= erb :"shared/google-analytics" %>
    <%= css :ava, :emp, :app, :media => 'screen' %>

  </head>
  <body id="steam-emp">
    <div class="site-alert">
      <% if flash[:error] %>
        <div class="error"><span class="icon"></span><%= flash[:error] %></div>
      <% end %>
      <% if flash[:warn] %>
        <div class="warning"><span class="icon"></span><%= flash[:warn] %></div>
      <% end %>
      <% if flash[:message] %>
        <div class="info"><span class="icon"></span><%= flash[:message] %></div>
      <% end %>
    </div>
    <%= yield %>

    <%= js  :steam %>
  </body>
</html>
