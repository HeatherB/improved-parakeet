<%
  @blackfriday_start = Time.new(2017,  11, 24, 9, 00, 00, "-07:00")
  @blackfriday_end =   Time.new(2017,  11, 28, 9, 00, 00, "-07:00")

  @blackfriday = ((Time.now > @blackfriday_start) && (Time.now < @blackfriday_end))
%>

<!DOCTYPE html>
<!--[if IEMobile 7 ]> <html dir="ltr" lang="en-US"class="no-js iem7"> <![endif]-->
<!--[if lt IE 7 ]> <html dir="ltr" lang="en-US" class="no-js ie6 oldie"> <![endif]-->
<!--[if IE 7 ]>    <html dir="ltr" lang="en-US" class="no-js ie7 oldie"> <![endif]-->
<!--[if IE 8 ]>    <html dir="ltr" lang="en-US" class="no-js ie8 oldie"> <![endif]-->
<!--[if (gte IE 9)|(gt IEMobile 7)|!(IEMobile)|!(IE)]><!--><html dir="ltr" lang="en-US" class="no-js"><!--<![endif]-->
<head>
    <title><%= @title %></title>
    <link rel="shortcut icon" href="https://eme01.enmasse-game.com/images/global_assets/globalfav.ico" sizes="16x16 24x24 32x32 48x48">
    <% if @item %>
    <link rel="canonical" href="<%= request.base_url %><%= @item.link %>"/>
    <% end %>
    <link rel="image_src" href="<%= img_url('ico_store.png') %>">
    <link rel="icon" href="https://eme01.enmasse-game.com/images/global_assets/globalfav.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-57x57.png') %>" sizes="57x57">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-72x72.png') %>" sizes="72x72">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-76x76.png') %>" sizes="76x76">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-114x114.png') %>" sizes="114x114">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-120x120.png') %>" sizes="120x120">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-144x144.png') %>" sizes="144x144">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-152x152.png') %>" sizes="152x152">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-180x180.png') %>" sizes="180x180">


    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%= erb :"shared/google-analytics" %>
    <style type="text/css">
      @font-face {
          font-family: 'serif6_beta_rgbold';
          src: url('/fonts/serif6beta-bold-webfont.eot');
          src: url('/fonts/serif6beta-bold-webfont.eot?#iefix') format('embedded-opentype'),
               url('/fonts/serif6beta-bold-webfont.woff') format('woff'),
               url('/fonts/serif6beta-bold-webfont.ttf') format('truetype'),
               url('/fonts/serif6beta-bold-webfont.svg#serif6_beta_rgbold') format('svg');
          font-weight: bold;
          font-style: normal;
      }
      @font-face {
          font-family: 'serif6_beta_rgitalic';
          src: url('/fonts/serif6beta-italic-webfont.eot');
          src: url('/fonts/serif6beta-italic-webfont.eot?#iefix') format('embedded-opentype'),
               url('/fonts/serif6beta-italic-webfont.woff') format('woff'),
               url('/fonts/serif6beta-italic-webfont.ttf') format('truetype'),
               url('/fonts/serif6beta-italic-webfont.svg#serif6_beta_rgitalic') format('svg');
          font-weight: normal;
          font-style: italic;
      }
    </style>
    <%= css :eme, :media => 'screen' %>
    <%= css :gifting_front, :media => 'screen' %>
    <%# stylesheet_link_tag "extralife" %>

    <!--[if lt IE 9]>
      <%= css 'tera/ie', :media => 'screen' %>
      <script>
        document.createElement('header');
        document.createElement('nav');
        document.createElement('section');
        document.createElement('article');
        document.createElement('aside');
        document.createElement('footer');
        document.createElement('hgroup');
      </script>
    <![endif]-->
  </head>
  <body class="no-js giftingfront closers">
   <%= EMEGlobalAssets.snippet("eme-bar", {:create_link => "#{SimpleSSO::ACCOUNT_SERVER_SECURE_URL}/closers/sign-up" }) %>

    <img class="header" style="width: 100%" src="https://static.enmasse.com/images/Gifting/closersheader.jpg" alt="Gifting Header" />
    <main>
        <h1>Closers Golden Gift Boxes</h1>
        <h1 style="display:none;"><%= @items %></h1>
        <% @items.each_with_index do |item, index| %>
        <div class="gift">
            <img src="<%= item.image_url %>" alt="Gifting" />
            <div class="info">
                <h2><%= item.name %></h2>
                <div class="emp <% if item.details == '505' %>save10<% end %> <% if item.details == '2505' %>save20<% end %>"><%= item.price %></div>
                <button class="buygift closers" data-user="<%= @gameaccounts %>" data-price="<%= item.price %>" data-discount="<%= item.details %>" data-amount="<%= item.pretty_name[0] + "x" %>" data-id=<%= item.id %>>Buy Now</button>
            </div>
        </div>
        <% end %>
        <h4>The Closers Gifting Center gives you the ability<br /> to send purchased gifts or open received gifts.</h4>
        <a href="https://closers.enmasse.com/news/posts/tis-the-season-for-golden-gift-boxes" class="learn closers">Learn More</a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href="/closers/gifts" class="learn closers">Gifting Center</a>
        <small>Not sure you know enough about gifting?— See the <a href="http://support.enmasse.com/tera/2017-golden-gift-box-event">Golden Giftbox FAQ</a> for<br /> more details and a full list of prizes.</small>
    </main>
    <%#= erb :"shared/item-modal" %>

    <div id="confirmation">
        <div id="confirm" class="box">
            <h3 style="background: #2e2e2e;">Confirm Purchase<span class="close">X</span></h3>
            <div class="wrap">
                <img src="https://static.enmasse.com/images/Gifting/cofirmgift.png">
                <div class="info">
                    <div class="text">You are about to purchase one <b>Closers Golden Gift Box</b> from the <i>Closers</i> Web store for 12800 EMP. Please confirm that you wish to purchase and apply this item to your account at this time. This product is for <i>Closers</i> PC only.</div> 
                    <ul>
                        <li>Original Price: <img src="https://static.enmasse.com/images/Gifting/emp-icon.png" /> <div id="original">/div></li>
                        <li>Discount: <img src="https://static.enmasse.com/images/Gifting/emp-icon.png" /> <div id="discount"></div></li>
                        <li><b>Total: <img src="https://static.enmasse.com/images/Gifting/emp-icon.png" /> <div id="total"></div></b></li>
                    </ul>
                    <div class="button-group">
                        <button class="close">Cancel</button>
                        <button id="buynow" class="blue">Buy Now</button>
                    </div>
                </div>
            </div>
        </div>
        <div id="purchase" class="box">
            <h3 style="background: #4b8341;">Purchase Successful<span class="close">X</span></h3>
            <div class="wrap">
                <img src="https://static.enmasse.com/images/Gifting/cofirmgift.png">
                <div class="info">
                    <div class="text"></div>
                </div>
            </div>
        </div>
        <div id="failed" class="box">
            <h3 style="background: #ad3434;">Purchase Failed<span class="close">X</span></h3>
            <div class="wrap">
                <img src="https://static.enmasse.com/images/Gifting/cofirmgift.png">
                <div class="info">
                    <div class="text"></div>
                    <div class="button-group">
                        <button class="close">Cancel</button>
                        <button class="buyemp blue">Buy EMP</button>
                    </div>
                </div>
            </div>
        </div>
        <div id="loginfailed" class="box">
            <h3 style="background: #ad3434;">Hold On a Second!<span class="close">X</span></h3>
            <div class="wrap">
                <img src="https://static.enmasse.com/images/Gifting/cofirmgift.png">
                <div class="info">
                    <div class="text"></div>
                    <div class="button-group">
                        <button class="close">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%= EMEGlobalAssets.snippet("footer") %>

    <%= js  :app %>

    <%= erb :reloader if ENV['RACK_ENV'] != 'deployment' %>

    <script>
      document.body.className = document.body.className.replace("no-js","js");
    </script>
    <%= EMEGlobalAssets.snippet("sso-init", {:account_server => SimpleSSO::ACCOUNT_SERVER}) %>

  </body>
</html>