    <%= js  :app %>

    <script type="text/javascript">
    var allPay = $('.payee');
    var allCurrency = $('.currency-by-payment');
    var allEmp = $('.select-emp');

      $('.payee').on('click', function() {
        setOptions($(this), allPay);
        $('#select-emp').addClass('active');
        set = ( $(this).children('input').attr('id') == 'token' ) ? $('.select-emp#creditcard') : $('.select-emp#' + $(this).children('input').attr('id').replace('cpg', '') );
        $(set).show();
      });

      $('.backBTN').on('click', function(event) {
        event.preventDefault();
        resetOptions();
      });

      function setOptions(choice, allList) {
        allList.not(choice).addClass('notselected').removeClass('selected');
        choice.addClass('selected').removeClass('notselected');
        $('.backBTN').addClass("show");
      }

      function resetOptions() {
        $('.backBTN').removeClass("show");
        allPay.removeClass('selected').removeClass('notselected');
        allCurrency.removeClass('selected').removeClass('notselected');
        allEmp.hide();
        $('#select-emp').removeClass('active');
        $('#billing-form').removeClass('active');
        $('#billing-info').hide();
      }
 
      $('.currency-by-payment').on('click', function() {
        setOptions($(this), allCurrency);
        var payment_type = $(this).children('input').attr('payment_type');
        if (payment_type == "XSOLLA" || payment_type == "XSOLLA_CREDIT" || payment_type == "BOACOMPRA") {
          $('#billing-info').hide();
        } else {
          $('#billing-info').show();
          $('#billing-form').addClass('active');
        }
        $(this).addClass("clicked");
        setTimeout(() => {
          $(this).removeClass("clicked");
        }, 1000);
      });
      

    </script>

    <%= erb :reloader if ENV['RACK_ENV'] != 'deployment' %>

