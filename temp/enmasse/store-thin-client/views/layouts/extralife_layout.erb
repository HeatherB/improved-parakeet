<head>
    <title>En Masse Store | Extra Life</title>
    <link rel="shortcut icon" href="/favicon.ico" sizes="16x16 24x24 32x32 48x48">
    <% if @item %>
    <link rel="canonical" href="<%= request.base_url %><%= @item.link %>"/>
    <% end %>
    <link rel="image_src" href="<%= img_url('ico_store.png') %>">
    <link rel="icon" href="<%= img_url('icons/favicon-32x32.png') %>" sizes="32x32">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-57x57.png') %>" sizes="57x57">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-72x72.png') %>" sizes="72x72">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-76x76.png') %>" sizes="76x76">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-114x114.png') %>" sizes="114x114">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-120x120.png') %>" sizes="120x120">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-144x144.png') %>" sizes="144x144">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-152x152.png') %>" sizes="152x152">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-180x180.png') %>" sizes="180x180">


    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%= erb :"shared/google-analytics" %>
    <style type="text/css">
      @font-face {
          font-family: 'serif6_beta_rgbold';
          src: url('/fonts/serif6beta-bold-webfont.eot');
          src: url('/fonts/serif6beta-bold-webfont.eot?#iefix') format('embedded-opentype'),
               url('/fonts/serif6beta-bold-webfont.woff') format('woff'),
               url('/fonts/serif6beta-bold-webfont.ttf') format('truetype'),
               url('/fonts/serif6beta-bold-webfont.svg#serif6_beta_rgbold') format('svg');
          font-weight: bold;
          font-style: normal;
      }
      @font-face {
          font-family: 'serif6_beta_rgitalic';
          src: url('/fonts/serif6beta-italic-webfont.eot');
          src: url('/fonts/serif6beta-italic-webfont.eot?#iefix') format('embedded-opentype'),
               url('/fonts/serif6beta-italic-webfont.woff') format('woff'),
               url('/fonts/serif6beta-italic-webfont.ttf') format('truetype'),
               url('/fonts/serif6beta-italic-webfont.svg#serif6_beta_rgitalic') format('svg');
          font-weight: normal;
          font-style: italic;
      }
    </style>
    <%= css :eme, :media => 'screen' %>
    <%= css :extralife, :media => 'screen' %>
    <%# stylesheet_link_tag "extralife" %>

    <!--[if lt IE 9]>
      <%= css 'tera/ie', :media => 'screen' %>
      <script>
        document.createElement('header');
        document.createElement('nav');
        document.createElement('section');
        document.createElement('article');
        document.createElement('aside');
        document.createElement('footer');
        document.createElement('hgroup');
      </script>
    <![endif]-->
  </head>
  <body class="no-js extralife">
    <%= EMEGlobalAssets.snippet("eme-bar", {:create_link => "#{SimpleSSO::ACCOUNT_SERVER_SECURE_URL}/#{@game}/sign-up" }) %>

    <img class="header-img" src="http://static.enmasse.com/store/extralife/header.png" />

    <main>
        <div class="learnmore">
            <h1>Benefits go to the Extra Life charity:</h1>
            <a target="_blank" class="learnmorebtn" href="https://www.extra-life.org/index.cfm?fuseaction=donorDrive.team&teamID=36372">Learn More</a>
        </div>

        <div class="pack">
            <h2><em>Tera</em> Extra Life Pack</h2>
            <div class="extra-border"><img src="http://static.enmasse.com/store/extralife/tera-pack.jpg" /></div>
            <div class="buy">
                <div class="price">$19.95</div>
                <div id="xsolla-11" class="button xsolla" data-projectid="24404" data-productid="3859">Buy Now</div>
            </div>
        </div>
        <div class="productdesc">
            <h3>Product Description</h3>
            A bundle of <em>TERA</em> items including a rare halo, unicorn mount, teddy bear backpack, and scintillating disco balls.
        </div>
        <table class="items">
            <tr><th colspan="4">Guaranteed Items</th></tr>
            <tr>
                <td><img src="http://static.enmasse.com/store/extralife/horse-icon.jpg" /></td>
                <td><h4>Rainbow Mount</h4>As pure and beautiful as rain on a sunny day, this polychromatic unicorn mount makes every day special.</td>
                <td>Character-Bound</td>
                <td>x1</td>
            </tr>
            <tr>
                <td><img src="http://static.enmasse.com/store/extralife/halo-icon.jpg" /></td>
                <td><h4>Blue Angel Halo</h4>Let your angelic beneficence shine blue.</td>
                <td>Character-Bound</td>
                <td>x1</td>
            </tr>
            <tr>
                <td><img src="http://static.enmasse.com/store/extralife/teddy.jpg" /></td>
                <td><h4>Billy-bob Bear</h4>He’s got your back, through thick and thin.</td>
                <td>Character-Bound</td>
                <td>x1</td>
            </tr>
            <tr>
                <td><img src="http://static.enmasse.com/store/extralife/orb-icon.jpg" /></td>
                <td><h4>Disco Ball</h4>Won't you take me to...Funkytown? Consumed after use.</td>
                <td>Character-Bound</td>
                <td>x20</td>
            </tr>
        </table>

        <div class="pack">
            <h2><em>Kritika Online</em> Extra Life Black Animal New Player Pack</h2>
            <div class="extra-border"><img src="http://static.enmasse.com/store/extralife/kritika-reg.jpg" /></div>
            <div class="buy">
                <div class="price">$10.00</div>
                <div class="selection">
                    <span>Choose Your Class:</span>
                    <select class="xsolla-select">
                        <option disabled selected value>Select one-- </option>
                        <option value="Psion">Psion</option>
                        <option value="Warrior">Warrior</option>
                        <option value="Rogue">Rogue</option>
                        <option value="Reaper">Reaper</option>
                        <option value="Gunmage">Gunmage</option>
                    </select>
                </div>
                <div id="xsolla-1" class="button xsolla disabled Warrior" data-projectid="24404" data-productid="3848">Buy Now</div>
                <div id="xsolla-2" class="button xsolla Gunmage hidden" data-projectid="24404" data-productid="3849">Buy Now</div>
                <div id="xsolla-3" class="button xsolla Rogue hidden" data-projectid="24404" data-productid="3851">Buy Now</div>
                <div id="xsolla-4" class="button xsolla Reaper hidden" data-projectid="24404" data-productid="3850">Buy Now</div>
                <div id="xsolla-5" class="button xsolla Psion hidden" data-projectid="24404" data-productid="3847">Buy Now</div>
            </div>
        </div>
        <div class="productdesc">
            <h3>Product Description</h3>
            A bundle of items for new <em>Kritika Online</em> players including starter goodies and an exclusive black animal costume. 
        </div>
        <table class="items">
            <tr><th colspan="4">Guaranteed Items</th></tr>
            <tr>
                <td><img src="http://static.enmasse.com/store/extralife/head.jpg" /></td>
                <td><h4>Black Animal Costume</h4>Black Tiger costume for Warriors and Gunmages. Black Penguin Costume for Rogues, Reapers, and Psions.</td>
                <td>Character-Bound</td>
                <td>x1</td>
            </tr>
            <tr>
                <td><img src="http://static.enmasse.com/store/extralife/rabbit.jpg" /></td>
                <td><h4>Smart Start Pack</h4>Chocked full of useful gear for new players: potions, resurrection stones, and three days of Elite Status.</td>
                <td>Character-Bound</td>
                <td>x1</td>
            </tr>
        </table>

        <div class="pack">
            <h2><em>Kritika Online</em> Extra Life Black Animal Veteran Pack</h2>
            <div class="extra-border"><img src="http://static.enmasse.com/store/extralife/kritika-extra.jpg" /></div>
            <div class="buy">
                <div class="price">$10.00</div>
                <div class="selection">
                    <span>Choose Your Class:</span>
                    <select class="xsolla-select">
                        <option disabled selected value>Select one-- </option>
                        <option value="Psion">Psion</option>
                        <option value="Warrior">Warrior</option>
                        <option value="Rogue">Rogue</option>
                        <option value="Reaper">Reaper</option>
                        <option value="Gunmage">Gunmage</option>
                    </select>
                </div>
                <div id="xsolla-6" class="button xsolla Warrior disabled" data-projectid="24404" data-productid="3853">Buy Now</div>
                <div id="xsolla-7" class="button xsolla Gunmage hidden" data-projectid="24404" data-productid="3854">Buy Now</div>
                <div id="xsolla-8" class="button xsolla Rogue hidden" data-projectid="24404" data-productid="3856">Buy Now</div>
                <div id="xsolla-9" class="button xsolla Reaper hidden" data-projectid="24404" data-productid="3855">Buy Now</div>
                <div id="xsolla-10" class="button xsolla Psion hidden" data-projectid="24404" data-productid="3852">Buy Now</div>
            </div>
        </div>
        <div class="productdesc">
            <h3>Product Description</h3>
            A bundle of items for <em>Kritika Online</em> veterans including two costume accents, an emblem, and an exclusive black animal costume. 
        </div>
        <table class="items">
            <tr><th colspan="4">Guaranteed Items</th></tr>
            <tr>
                <td><img src="http://static.enmasse.com/store/extralife/head.jpg" /></td>
                <td><h4>Black Animal Costume</h4>Black Tiger costume for Warriors and Gunmages. Black Penguin Costume for Rogues, Reapers, and Psions.</td>
                <td>Character-Bound</td>
                <td>x1</td>
            </tr>
            <tr>
                <td><img src="http://static.enmasse.com/store/extralife/chest.jpg" /></td>
                <td><h4>Lucky Pandora Box 2</h4>Contains one of many excellent prizes: scrolls, fix-it hammers, Roseguard costume pieces, or up to 5 million gold!</td>
                <td>Character-Bound</td>
                <td>x2</td>
            </tr>
            <tr>
                <td><img src="http://static.enmasse.com/store/extralife/cat.jpg" /></td>
                <td><h4>Stylish Accent Box</h4>Contains a random costume accent.</td>
                <td>Character-Bound</td>
                <td>x2</td>
            </tr>
            <tr>
                <td><img src="http://static.enmasse.com/store/extralife/crest.jpg" /></td>
                <td><h4>Enigmatic Emblem Box</h4>Contains a random emblem.</td>
                <td>Character-Bound</td>
                <td>x1</td>
            </tr>
        </table>
    </main>


