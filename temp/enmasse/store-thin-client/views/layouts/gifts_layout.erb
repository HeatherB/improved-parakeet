  <head>
    <title><%= @title %></title>
    <link rel="shortcut icon" href="<%= asset_path("gifting/wintera/#{@game}/icons/favicon.ico") %>" sizes="16x16 24x24 32x32 48x48">
    <% if @item %>
    <link rel="canonical" href="<%= request.base_url %><%= @item.link %>"/>
    <% end %>
    <link rel="image_src" href="<%= img_url('ico_store.png') %>">
    <link rel="icon" href="<%= img_url("gifting/wintera/#{@game}/icons/favicon-32x32.png") %>" sizes="32x32">
    <link rel="apple-touch-icon" href="<%= img_url("gifting/wintera/#{@game}/icons/apple-icon-57x57.png") %>" sizes="57x57">
    <link rel="apple-touch-icon" href="<%= img_url("gifting/wintera/#{@game}/icons/apple-icon-72x72.png") %>" sizes="72x72">
