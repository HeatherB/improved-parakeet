        document.createElement('aside');
        document.createElement('footer');
        document.createElement('hgroup');
      </script>
    <![endif]-->
  </head>
  <body class="<%= @game %> gifting">
    <%= EMEGlobalAssets.snippet("eme-bar", {:create_link => "#{SimpleSSO::ACCOUNT_SERVER_SECURE_URL}/#{@game}/sign-up" }) %>
    


    <div id="page-content">
      <div id="page_container">
        <div class="breadcrumbs_wrapper">
          <%= erb :breadcrumbs %>
        </div>
        <div class="site-alert">
          <% if flash[:error] %>
            <div class="error"><span class="icon"></span><%= flash[:error] %></div>
          <% end %>
          <% if flash[:warn] %>
            <div class="warning"><span class="icon"></span><%= flash[:warn] %></div>
          <% end %>
          <% if flash[:message] %>
            <div class="info"><span class="icon"></span><%= flash[:message] %></div>
          <% end %>
        </div>
        
        <%= yield %>
      </div>

      
