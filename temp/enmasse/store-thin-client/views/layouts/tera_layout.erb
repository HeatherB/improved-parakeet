<% skip_sub_menu = defined?(skip_sub_menu) ? skip_sub_menu : false %>
<% gifting_layout = defined?(gifting_layout) ? gifting_layout : false %>

<%
  @takeover_start = Time.new(2014, 12, 11, 13, 00, 00, "-07:00")
  @takeover_end   = Time.new(2015, 1,   6, 11, 00, 00, "-07:00")
%>

<%
  @fridayAlert_start = Time.new(2016, 11, 25, 10, 00, 00, "-08:00")
  @fridayAlert_end   = Time.new(2016, 11, 29, 10, 00, 00, "-08:00")
%>

<%
  @bestSellers_start = Time.new(2017, 5, 25, 10, 00, 00, "-07:00")
  @bestSellers_end   = Time.new(2017, 5, 30, 8, 00, 00, "-07:00")
%>

