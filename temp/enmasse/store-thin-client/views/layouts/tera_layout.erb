    <link rel="icon" href="<%= img_url('icons/favicon-32x32.png') %>" sizes="32x32">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-57x57.png') %>" sizes="57x57">
    <link rel="apple-touch-icon" href="<%= img_url('icons/apple-touch-icon-72x72.png') %>" sizes="72x72">
