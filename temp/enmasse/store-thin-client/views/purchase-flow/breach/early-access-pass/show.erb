<div class="breach-shop" id="breach-shop">
  <section id="shop_heading">
    <div class="inner">
      <h1>Breach Store</h1>
      <!--<h3 style="color: #fa6705; text-transform: uppercase; font-family: 'Shentox';">Last chance for Founder's Packs! Get yours before February 19!</h3>-->
      <p>Check back here for exclusive packs and passes to unlock even more of what Breach has to offer.</p>
    </div>
  </section>
  <section id="shopping_bundles">

  <form id="shop_initiate_form" method="POST" action="/breach/early-access-pass/confirm">
    <input type="hidden" value="" id="product_id" name="product_id"/>
  </form>

    <div class="shop_bundle" id="early_access_pass">
      <div class="inner">
        <h2 class="heading">EARLY ACCESS PASS</h2>
        <ul class="shop-blocks">
          <li class="boost-30day">
            <h3>30-DAY XP and GOLD BOOST</h3>
          </li>
          <li class="qcpoints-2000">
            <h3>2000 QC POINTS</h3>
          </li>
          <li class="early-access">
            <h3>INSTANT EARLY ACCESS</h3>
          </li>
        </ul>

        <p>The <span class="import">Early Access Pass</span> makes it easy for you to jump into Breach ahead of the official launch with instant early access, and gives you a massive boost so you can level and acquire gold quickly. Plus, with the included <span class="import">2000 QC points</span> (a $20 value), you can unlock new classes, skins, equipment, and more boosts.</p>

        <% if !session[:account_id] # IF NOT LOGGED IN  %>
          <div class="purchase_block loggedout">
            <div class="btn-plate">
              <a href='/' class="sign-in login-popup-link">SIGN IN to purchase</a>
              <div class="price-block offer">
                <div>
                  <div class="price">$9.99</div>
                </div>
              </div>
              <div class="savings_bubble best">
                <div class="inner">Save Over* <span>60%</span></div>
              </div>
            </div>
          </div>
        <% else %>
          <div class="purchase_block purchase_initiate_button" data-product-id="breach_early_access_dlc">
            <div class="btn-plate">
              Order Now
              <div class="price-block offer">
                <div>
                  <div class="price">$9.99</div>
                </div>
              </div>
              <div class="savings_bubble best">
                <div class="inner">Save Over* <span>60%</span></div>
              </div>
            </div>
          </div>
        <% end %>

      </div>
    </div>

    
    <div class="disclaimer">  
       <p>&nbsp;</p> 
    </div>
    
    <!--<div class="help">
      <p>Read our <a href="/">Buy FAQ.</a>
      </p>
    </div>-->
  </section>

</div>