<div class="page_container <%= @game if defined?(@game) %> <%= 'selection_view' if session[:account_id] %>">


     <div class="header">
        <div class="game-logo">
          <img src="https://eme03.enmasse-game.com/images/breach/sign-up/breach-logo.png" alt="QC Points" />
        </div>
      </div><!-- end of header -->


      <% if !session[:account_id] # IF NOT LOGGED IN %>

        <div class="note">
          <h2>Purchase QC Points</h2>
          <p>To purchase QC Points, you need to sign into your En Masse Account.</p>
          <p>To create an En Masse Account for free, <a href="https://account.enmasse.com/breach/sign-up">click here.</a></p>
        </div><!-- end of note -->
        <div class="loginBTN">
          <a href='/' class="sign-in login-popup-link">SIGN IN</a>
        </div>

      <% else %>

        <div id="qcpoints-billing">
          <h2>Confirm your Purchase</h2>
          <div class="purchase-recap">
            <div id="selected-amt">
              <span><%= @billing.name %></span>
            </div>
            <div id="selected-amt-price">
              $<span><%= sprintf "%.2f", @billing.price %></span> USD
            </div>
          </div>


          <!--<form id="qc-billing" action="/<%= @game %>/qcpoints/confirm/" method="post">-->
          <div id="purchase-confirmation"><!-- these three lines are needed for form processing -->
            <form id="payform" name="payform">
              <div id="hidden-fields" data-action-url="<%= @billing.payment_url %>"></div>



            <% if @billing.errors.any? && @show_errors %>
              <div id="error-explanation">
                <div class="error">
                  <% @billing.errors.full_messages.each do |msg| %>
                    <article><%= msg %></article>
                  <% end %>
                </div>
              </div>
            <% end %>

            

              <div class="submitBTN">
                <input type="submit" class="button-secondary confirm disabled" value="Confirm Order" onclick="_gaq.push(['_trackEvent', 'Purchase Funnels', 'Submit Order Review', 'QC Points']);" />
              </div>
              <p>This button opens a pop-up window for your chosen payment method. If you have a pop-up blocker installed,
          please temporarily disable it to allow the window to open so you may complete your purchase.</p>
          <p>Questions about QC Points?, checkout this <a href="https://support.qcgamedev.com/hc/en-us/articles/360022077891" target="_blank">Help Center Article</a>.</p>


          </div>
    </form>
  </div>


<!--
          <div id="gofillup-screen" style="display:none;">
    <a href="#close" id="gofillup-screen-close" title="Close" class="close">X</a>
    <iframe width="100%" height="100%" name="gofillup-iframe" id="gofillup-iframe"></iframe>
  </div>

-->

        </div><!-- end of qcpoints-billing -->

      <% end %><!-- end of login check -->
    </div><!-- end of page container -->




    <script type="text/javascript">
  window.onload = function () {
    _gaq.push(['_trackEvent', 'Purchase Funnels', 'View Order Review Screen', 'QC Points']);
  }
</script>
