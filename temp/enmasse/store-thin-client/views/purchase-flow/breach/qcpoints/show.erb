<div class="page_container <%= @game if defined?(@game) %> <%= 'selection_view' if session[:account_id] %>">


     <div class="header">
        <div class="game-logo">
          <img src="https://eme03.enmasse-game.com/images/breach/sign-up/breach-logo.png" alt="QC Points" />
        </div>
      </div><!-- end of header -->


      <% if !session[:account_id] # IF NOT LOGGED IN %>

        <div class="note">
          <h2>Purchase QC Points</h2>
          <p>To purchase QC Points, you need to sign into your En Masse Account.</p>
          <p>To create an En Masse Account for free, <a href="https://account.enmasse.com/breach/sign-up">click here.</a></p>
        </div><!-- end of note -->
        <div class="loginBTN">
          <a href='/' class="sign-in login-popup-link">SIGN IN</a>
        </div>

      <% else %>

        <div id="qcpoints-purchase">
          <h2>Purchase QC Points</h2>
          <p>Select the amount of points you would like to purchase.</p>
          <small>QC Points allow you to buy items in Breach. <a href="https://support.qcgamedev.com/hc/en-us/articles/360022077891" target="_blank">Learn More</a></small>



          <form id="purchase_initiate_form" method="POST" action="/breach/qcpoints/confirm">
            <input type="hidden" value="" id="product_id" name="product_id"/>
          </form>

          <ul>
            <li class="purchase_initiate_button" data-product-id="QC_POINTS_500">
              <div class="inner">
                <h3>QC Points</h3>
                <h4>500</h4>
                <div class="purchase_block">
                  <!--<div class="bundle_button" id="XS-pay2play-widget-1" data-id="Breach-Supporter" data-project_id="36119">
                      <div class="price-block offer">
                          <div class="price">$4.99</div>
                      </div>
                  </div>-->
                  <div class="btn-plate">
                      <div class="price-block offer">
                        <div>
                          <div class="price">$4.99</div>
                        </div>
                      </div>
                  </div>
                </div>
              </div>
            </li>

            <li class="purchase_initiate_button" data-product-id="QC_POINTS_1000">
              <div class="inner">
                <h3>QC Points</h3>
                <h4>1,040 <span class="bonus">(1,000 +40 Bonus)</span></h4>
                <div class="purchase_block">
                  <!--<div class="bundle_button" id="XS-pay2play-widget-2" data-id="Breach-Supporter" data-project_id="36119">
                      <div class="price-block offer">
                          <div class="price">$9.99</div>
                      </div>
                  </div>-->
                  <div class="btn-plate">
                      <div class="price-block offer">
                        <div>
                          <div class="price">$9.99</div>
                        </div>
                      </div>
                  </div>
                </div>
              </div>
            </li>
            
            <li class="purchase_initiate_button" data-product-id="QC_POINTS_2000">
              <div class="inner">
                <h3>QC Points</h3>
                <h4>2,100 <span class="bonus">(2,000 +100 Bonus)</span></h4>
                <div class="purchase_block">
                  <!--<div class="bundle_button" id="XS-pay2play-widget-3" data-id="Breach-Supporter" data-project_id="36119">
                      <div class="price-block offer">
                          <div class="price">$19.99</div>
                      </div>
                  </div>-->
                  <div class="btn-plate">
                      <div class="price-block offer">
                        <div>
                          <div class="price">$19.99</div>
                        </div>
                      </div>
                  </div>
                </div>
              </div>
            </li>

            <li class="purchase_initiate_button" data-product-id="QC_POINTS_5000">
              <div class="inner">
                <h3>QC Points</h3>
                <h4>5,500 <span class="bonus">(5,000 +500 Bonus)</span></h4>
                <div class="purchase_block">
                  <!--<div class="bundle_button" id="XS-pay2play-widget-4" data-id="Breach-Supporter" data-project_id="36119">
                      <div class="price-block offer">
                          <div class="price">$49.99</div>
                      </div>
                  </div>-->
                  <div class="btn-plate">
                      <div class="price-block offer">
                        <div>
                          <div class="price">$49.99</div>
                        </div>
                      </div>
                  </div>
                </div>
              </div>
            </li>

            <li class="best-value purchase_initiate_button" data-product-id="QC_POINTS_10000">
              <div class="value-flag">
                <!--<span>Best Value</span>-->
              </div>
              <div class="inner">
                <h3>QC Points</h3>
                <h4>11,500 <span class="bonus">(10,000 +1,500 Bonus)</span></h4>
                <div class="purchase_block">
                  <!--<div class="bundle_button" id="XS-pay2play-widget-5" data-id="Breach-Supporter" data-project_id="36119">
                      <div class="price-block offer">
                          <div class="price">$99.99</div>
                      </div>
                  </div>-->
                  <div class="btn-plate">
                      <div class="price-block offer">
                        <div>
                          <div class="price">$99.99</div>
                        </div>
                      </div>
                  </div>
                </div>
              </div>
            </li>
          </ul>
          <p class="find-out-more"><a target="_blank" href="https://support.qcgamedev.com/hc/en-us/articles/360022077891">Why can't I purchase QC Points with my EMP?</a></p>
        </div><!-- end of qcpoints-purchase -->

      <% end %><!-- end of login check -->
    </div><!-- end of page container -->
