<section id="wide_body" class="row">
  <% if @billing.errors.any? %>
    <div id="error-explanation">
      <h2><%= @billing.errors.count %> error<%= "s" if @billing.errors.count != 1 %> prohibited this post from being saved:</h2>
      <ul>
      <% @billing.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  <div id="purchase-confirmation">
    <div class="content-block rounded">
      <div class="purchase-tracker">
        <ul>
          <li class="num lightup"><span>1</span>Choose Products</li>
          <li class="arrow lightup">&rarr;</li>
          <li class="num lightup"><span>2</span>Review Order</li>
          <li class="arrow">&rarr;</li>
          <li class="num"><span>3</span>Enter Payment Details</li>
          <li class="arrow">&rarr;</li>
          <li class="num"><span>4</span>View Receipt</li>
        </ul>
      </div>

      <form id="payform" name="payform">
        <div id="hidden-fields" style="/*display:none;*/" data-action-url="<%= @billing.payment_url %>"></div>

        <% if @billing.subscription? %>
          <%= erb :"purchase-flow/subs/confirm" %>
        <% else %>
          <%= erb :"purchase-flow/emp/confirm" %>
        <% end %>
        
        <p class="text-align-center">This button will open a pop-up window. If you are using a pop-up blocker, please allow this window to open to continue your purchase.</p>
      </form>
    </div>
  </div>
  <div id="gofillup-screen" style="display:none;">
    <a href="#close" id="gofillup-screen-close" title="Close" class="close">X</a>
    <iframe width="100%" height="100%" name="gofillup-iframe" id="gofillup-iframe"></iframe>
  </div>
</section>
