  <div class="page_container confirm">
    <div class="header">
      <% if @game %>
      <div class="game-logo">
        <img src="<%= img_url("emp/#{@game}-logo.png") %>" alt="<%= @game %>" />
      </div>
      <% else %>
      <div class="game-logo">
        <img src="<%= img_url('emp/enmasse-logo.png') %>" class="eme" alt="en masse" />
      </div>
      <% end %>
      <div class="steps_progress">
        <img src="<%= img_url('emp/steps_second.png') %>" alt="confirm" />
      </div>
    </div><!-- end of header -->

    <div id="purchase-confirmation"><!-- these three lines are needed for form processing -->
      <form id="payform" name="payform">
        <div id="hidden-fields" style="/*display:none;*/" data-action-url="<%= @billing.payment_url %>"></div>

    <!-- Product thumb can be either 'emp' or 'elite' based on the type of purchase -->
    <div class="product-thumb <%= session['path'] %>"></div>
    <% if session["path"] == "elite" %>
      <p>Elite Status <small><a href="/<%= @game %>/<%= session['path'] %>/#paymentList">Edit</a></small></p>
    <% else %>
    <h2>Please Confirm your Order</h2>
    <section id="select-emp">
      <% if @billing.item? %>
        <h2 class="heading"><%= @billing.item.name %></h2>
        <p class="editBTN"><a href="/<%= @game %>/<%= session['path'] %>/#paymentList">Edit</a></p>
      <% else %>
        <h2 class="heading">EMP Amount</h2>
        <p class="editBTN"><a href="/<%= @game %>/<%= session['path'] %>/#paymentList">Edit</a></p>
      <% end %>
      <div class="receipt-info">
        <div class="left-col">
          <span class="receipt-emp"><%= @billing.emp_amount %> EMP</span>
        </div>
        <div class="right-col">
          <span class="receipt-price">Price: $<%= sprintf "%.2f", @billing.price %></span>
        </div>
        <div class="ellipses"></div>
        <div class="left-col"></div>
        <div class="right-col">
          <% if (@billing.payment_method == "XSOLLA" || @billing.payment_method == "XSOLLA_CREDIT" || @billing.payment_method == "BOACOMPRA") %>
              <span class="receipt-total">Total: $<%= sprintf "%.2f + TAX", @billing.price.to_f %></span>
              <span class="receipt-total">(TAX will be determined in the next step)</span>
          <% else %>
            <span class="receipt-tax">Plus Tax: $<%= sprintf "%.2f", @tax_amount.to_f %></span>
            <span class="receipt-total">Total: $<%= sprintf "%.2f", @billing.price.to_f + @tax_amount.to_f %></span>
          <% end %>
        </div>
      </div>
    </section>
    <section id="billing-info">
      <% if (@billing.payment_method == "XSOLLA" || @billing.payment_method == "XSOLLA_CREDIT" || @billing.payment_method == "BOACOMPRA") %>
      <!-- no billing info to show -->
      <% else %>
      <h2 class="heading">Billing Info</h2>
      <p class="editBTN"><a href="/<%= @game %>/<%= session['path'] %>/#billingInfo">Edit</a></p>
      <div class="receipt-info">
        <div class="left-col">
          <ul>
            <% if @billing.country == "USA" || @billing.country == "CAN" %>
              <li>City: <%= @billing.city %></li>
              <li>State: <%= (@billing.state == "^") ? "" : "#{@billing.state}" %>
              <li>Zip: <%= @billing.zip %></li>
            <% end %>
            <li>Country: <%= @billing.country %>
          </ul>
        </div>
        <div class="right-col"></div>
      </div>
      <% end %>
      <div class="submitBTN">
        <input type="submit" class="button-secondary confirm" value="<%= (@billing.payment_method.downcase == 'token') ? 'Complete Transaction' : 'Confirm Order' %>" onclick="_gaq.push(['_trackEvent', 'Purchase Funnels', 'Submit Order Review', 'Virtual Currency']);" />
        <!--<div class="processing"><span class="loading"></span> Processing...</div>-->
        <p>This button opens a pop-up window for your chosen payment method. If you have a pop-up blocker installed, please temporarily disable it to allow the window to open so you may complete your purchase.</p>
      </div>
    </section>
    <% end %>
    </form>
  </div>
    <div id="gofillup-screen" style="display:none;">
      <a href="#close" id="gofillup-screen-close" title="Close" class="close">X</a>
      <iframe width="100%" height="100%" name="gofillup-iframe" id="gofillup-iframe"></iframe>
    </div>
  </div>


<script type="text/javascript">
  window.onload = function(){
    _gaq.push(['_trackEvent', 'Purchase Funnels', 'View Order Review Screen', 'Virtual Currency']);
  }
</script>