  <div class="page_container receipt">
    <div class="header">
      <% if @game %>
      <div class="game-logo">
        <img src="<%= img_url("emp/#{@game}-logo.png") %>" alt="<%= @game %>" />
      </div>
      <% else %>
      <div class="game-logo">
        <img src="<%= img_url('emp/enmasse-logo.png') %>" class="eme" alt="en masse" />
      </div>
      <% end %>
      <div class="steps_progress">
        <img src="<%= img_url('emp/steps_fourth.png') %>" alt="receipt" />
      </div>
    </div><!-- end of header -->

    <h2>EMP Purchase Successful!</h2>
    <section class="receipt-details">
      <p>We will send your order details to the email address provided. Charge(s) will appear on your credit card statement as "ENMASSE ENT". Note: If your account EMP balance does not update immediately, please allow a few minutes for your transaction to finish processing.</p>
      <span><strong>Order Number:</strong> <%= @billing.purchase_info['cashno'] %></span>
      <span><strong>Date:</strong> <%= Time.now().strftime("%b %d, %Y") %></span>
    </section>
    <section id="select-emp">
      <% if @billing.item? %>
        <h2 class="heading"><%= @billing.item.name %></h2>
      <% else %>
        <h2 class="heading">EMP Amount</h2>
      <% end %>
      <div class="receipt-info">
        <div class="left-col">
          <span class="receipt-emp"><%= @billing.emp_amount %> EMP</span>
        </div>
        <div class="right-col">
          <span class="receipt-price">Price: $<%= sprintf "%.2f", @billing.purchase_info['payamt'].to_f %></span>
        </div>
        <div class="ellipses"></div>
        <div class="left-col"></div>
        <div class="right-col">
          <span class="receipt-tax">Plus Tax: $<%= sprintf "%.2f", @billing.purchase_info['taxamt'].to_f %></span>
          <span class="receipt-total">Total: <%= sprintf "%.2f", @billing.purchase_info['payamt'].to_f + @billing.purchase_info['taxamt'].to_f %></span>
        </div>
      </div>
    </section>
    <section id="billing-info">
      <% if (@billing.payment_method == "XSOLLA" || @billing.payment_method == "XSOLLA_CREDIT") %>
      <!-- no billing info to show -->
      <% else %>
      <h2 class="heading">Billing Info</h2>
      <div class="receipt-info">
        <div class="left-col">
          <ul>
            <% if @billing.country == "USA" %>
            <li>City: <%= @billing.city %></li>
            <li>State: <%= (@billing.state == "^") ? "" : "#{@billing.state}" %></li>
            <li>Zip: <%= @billing.zip %></li>
            <% end %>
            <li>Country: <%= @billing.country %></li>
          </ul>
        </div>
        <div class="right-col"></div>
      </div>
      <% end %>
    </section>
    <section id="payment-info">
      <h2 class="heading">Payment Info</h2>
      <div class="receipt-info">
        <div class="left-col">
          <% if @billing.paypal? %>
            <div class="paypal-logo"></div>
          <% elsif @billing.xsolla? %>
            <div class="xsolla-logo">xsolla logo</div>
          <% elsif @billing.xsolla_creditcard? %>
            <div class="xsolla-credit-logo"></div>
          <% elsif @billing.boacompra? %>
            <div class="boacompra-logo">boacompra logo</div>
          <% elsif @billing.creditcard? %>
          <ul>
            <li>Credit Card: <%= @billing.purchase_info['cardtype'] %></li>
            <li>Card Number: ************<%= @billing.purchase_info['cardacct'] %></li>
            <li>Expires: <%#= @billing.purchase_info['cardexpdate'].slice(0,2)  %>/<%#= @billing.purchase_info['cardexpdate'].slice(2,2)  %></li>
          </ul>
          <% end %>
        </div>
        <div class="right-col"></div>
      </div>
      <div class="submitBTN">
        <a href="/<%= @game %>/">Back To Store</a>
      </div>
    </section>
  </div>

  <% if @billing.subscription? # Sub flow %>

    <% if @billing.auth_flag # update sub flow %>
      <script type="text/javascript">
        _gaq.push(['_trackEvent', 'Purchase Funnels', 'View Billing/Payment Update Confirmation', 'Subscription', <%= sprintf '%.2f', @billing.purchase_info['payamt'].to_f %>]);
      </script>
    <% else # new sub flow %>
      <script type="text/javascript">
        _gaq.push(['_trackEvent', 'Purchase Funnels', 'View Receipt', 'Subscription', <%= sprintf '%.2f', @billing.purchase_info['payamt'].to_f %>]);
      </script>
    <% end %>

  <% else # emp flow %>
    <script type="text/javascript">
      _gaq.push(['_trackEvent', 'Purchase Funnels', 'View Receipt', 'Virtual Currency', <%= sprintf '%.2f', @billing.purchase_info['payamt'].to_f %>]);
    </script>
  <% end %>

  <script type="text/javascript">
    _gaq.push(['_addTrans',
     "<%= @billing.purchase_info['cashno'] %>",                                                                   // order number
     'EME Store',                                                                                                 // affiliation or store name
     "<%= sprintf '%.2f', @billing.purchase_info['payamt'].to_f + @billing.purchase_info['taxamt'].to_f %>",      // total without tax and shipping - required
     "<%= @billing.purchase_info['taxamt'] %>",                                                                   // tax
     "0.00",                                                                                                      // shipping
     "<%= @billing.city.capitalize %>",                                                                           // city of purchaser
     "<%= @billing.state.capitalize %>",                                                                          // state or province of purchaser
     "<%= @billing.country.capitalize %>"                                                                         // country
    ]);
    <% if @billing.subscription? %>
      _gaq.push(['_addItem',
         "<%= @billing.purchase_info['cashno'] %>",                               // order number - necessary to associate item with transaction
         "<%= @billing.amount_id %>",                                             // item ID - if we don"t have one, just use the name but replace spaces with dashes
         "Elite Subscription",                                                    // product name
         "<%= @billing.purchase_info['payamt'] %>",                               // category or variation
         "<%= sprintf '%.2f', @billing.purchase_info['payamt'].to_f %>",          // unit price - required
         "1"                                                                      // quantity - required
      ]);
    <% else %>
      _gaq.push(['_addItem',
         "<%= @billing.purchase_info['cashno'] %>",                               // order number - necessary to associate item with transaction
         "<%= @billing.emp_amount %>-emp",                                        // item ID - if we don"t have one, just use the name but replace spaces with dashes
         "<%= @billing.emp_amount %> EMP",                                        // product name
         "Virtual Currency",                                                      // category or variation
         "<%= sprintf '%.2f', @billing.purchase_info['payamt'].to_f %>",          // unit price - required
         "1"                                                                      // quantity - required
      ]);
    <% end %>
    _gaq.push(['_trackTrans']);
  </script>