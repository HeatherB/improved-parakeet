<section id="wide_body" class="row">
  <% if !@errors.empty? %>
    <%= @errors %>
  <% else %>
    <div class="wrapper">
      <div class="content">
        <div class="emp-header">
          <div class="emp-logo"></div>
        </div>
        <div class="copy reciept">
        <% if @finalized %>
          <p>Purchase Completed!</p>

          <div class="steps">
            <span class="hr"></span>
            <ul>
              <li class="one">1.) Choose Products</li>
              <li class="two">2.) Edit Payment Details</li>
              <li class="three light">3.) View Receipt</li>
            </ul>
            <span class="hr"></span>
          </div>

          <p style="line-height:1.2em;">You will receive an email with your order details at the address you provided. <strong>You will need to refresh your EMP to see your new balance.</strong> Note: Please allow a few minutes for your transaction to process.</p>

          <div class="row">
            <div class="order">
              <ul>
                <li>Order Number: <%= @query_transx["response"]["params"]["transid"] %></li>
                <li>Date: <%= Time.now.strftime('%B %e, %Y') %></li>
              </ul>
              <div class="bar"></div>
              <table>
                <tr>
                  <td>Price:</td>
                  <td>$<%= sprintf("%.2f", @item.purchase_amount.to_i / 100.0) %></td>
                </tr>
                <tr>
                  <td>Tax:</td>
                  <td>$<%= sprintf("%.2f", @query_transx["response"]["params"]["items"][0]["vat"].to_i / 100.0) %></td>
                </tr>
              </table>
              <div class="bar"></div>
              <table>
                <tr>
                  <td>Total:</td>
                  <td>$<%= sprintf("%.2f", (@query_transx["response"]["params"]["items"][0]["amount"].to_i + @query_transx["response"]["params"]["items"][0]["vat"].to_i) / 100.0) %></td>
                </tr>
              </table>
            </div>

            <div class="select-emp">
              <div class="emp-price"><div>Price:</div> <span><sup>$</sup><%= @item.cost.to_i %></span></div>
              <label for="cur-<%= @item.id %>" class="amount-<%= @item.position %>">
                <div class="inner">
                  <ul>
                    <li class="emp-count"><%= @item.purchase_amount_total %></li>
                    <li class="bonus"><%= @item.purchase_amount_bonus == 0 ? "NO" : "<span>#{@item.purchase_amount_bonus}</span>" %> BONUS EMP</li>
                  </ul>
                </div>
              </label>
            </div>
          </div>
        <% end %>
        </div>
      </div>
      <div class="side-bar">
        <div class="steam-logo"></div>

        <div class="side-content">
          <h5>About En Masse Entertainment</h5>
          <p>Based in Seattle, Washington, the company’s mission is to publish great games and provide the best service. En Masse successfully brought its inaugural title, TERA—a revolutionary action-combat MMO—to western audiences in 2012, followed by the online shooters ZMR (Zombies Monsters Robots) and AVA (Alliance of Valiant Arms), and the 2017 release of Kritika Online, a hyper-stylish anime brawler. But "Great Games" aren't limited by platform; En Masse announced its expansion of TERA onto PlayStation® and XBox with console ports in 2017.</p>
          <p>At En Masse Entertainment, we believe everyone should follow their passion, and our passion is great games.</p>
          <div class="bar"></div>
        </div>
      </div>
    </div>
  <% end %>
</section>
