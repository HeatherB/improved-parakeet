<% if @game.downcase == 'breach' %>
  <div class="page_container <%= @game if defined?(@game) %> <%= 'selection_view' if session[:account_id] %>">
      <div class="header">
        <div class="game-logo">
          <img src="http://eme03.enmasse-game.com/images/breach/sign-up/breach-logo.png" alt="QC Points"/>
        </div>
      </div><!-- end of header -->
      <section id="wide_body" class="row purchase-failure">
        <div id="error-explanation">
          <div class="error">
            <% if @error_code == 201 %>
              <p>Payment failed to process: Please <a href="https://support.enmasse.com/hc/en-us/articles/360017538054-Purchasing-EMP-Issues">review the following FAQ</a> for details about your specific error.</p>
            <% else %>
              <p>Payment failed to process. Please <a href="https://support.enmasse.com/hc/en-us/articles/360017538054-Purchasing-EMP-Issues">review the following FAQ</a> for details about your specific error.</p>
            <% end %>
            <p>Error code: <%= @error_code %></p>
            <% if @error_msg %>
              <p>Error message: <%= @error_msg %></p>
            <% end %>
          </div>
        </div>
      </section>
    </div>
<% else %>
  <section id="wide_body" class="row purchase-failure">
    <div id="error-explanation">
      <div class="error">
        <% if @error_code == 201 %>
          <p>Payment failed to process: Please <a href="https://support.enmasse.com/hc/en-us/articles/360017538054-Purchasing-EMP-Issues">review the following FAQ</a> for details about your specific error.</p>
        <% else %>
          <p>Payment failed to process. Please <a href="https://support.enmasse.com/hc/en-us/articles/360017538054-Purchasing-EMP-Issues">review the following FAQ</a> for details about your specific error.</p>
        <% end %>
        <p>Error code: <%= @error_code %></p>
        <% if @error_msg %>
          <p>Error message: <%= @error_msg %></p>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
