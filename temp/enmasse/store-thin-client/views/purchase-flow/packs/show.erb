<section class="pack_pack">
	<h1>TERA BACK TO SCHOOL PACK</h1>
	<img src="http://eme02.enmasse-game.com/images/store/bts/packTera.jpg" alt="tera pack" />
	<div class="pack_details">
		<div class="heading">
			<h2>This Pack Includes</h2>
		</div>
		<dl>
			<dt>Account Services</dt>
			<dd>
				<ul>
					<li>Elite Status Voucher (30 Day)</li>
					<li>10x Strongbox Keys</li>
				</ul>
			</dd>
			<dt>Pet</dt>
			<dd>
				<ul>
					<li>Pet Wooley!</li>
				</ul>
			</dd>
			<dt>Weapon Skin</dt>
			<dd>
				<ul>
					<li>Silver Noblesse Smart Box</li>
				</ul>
			</dd>
			<dt>Costumes</dt>
			<dd>
				<ul>
					<li>2013 Kai Poly School Uniform (Female Only-Except Aman Female)</li>
					<li>Varsity Blue Dogs Costume</li>
				</ul>
			</dd>
			<dt>Accessories</dt>
			<dd>
				<ul>
					<li>Tortoise-Shell Brow Glasses (Face)</li>
					<li>Notes by Dolme (Head)</li>
					<li>Beary Important Case (Black)</li>
				</ul>
			</dd>
		</dl>
	</div>
	<div class="action">
		<div class="price_reveal">
			<span>$49.99</span>
		</div>
		<div class="one_per">One Purchase Per Account</div>
		<% if !session[:account_id] # IF NOT LOGGED IN  %>
	    	<div class="btn_blue">
	        	<a href='/' class="sign-in login-popup-link">SIGN IN to purchase</a>
	    	</div>
		<% else %>
			<form id="init_packs_form" method="POST" action="/<%= @game %>/packs/confirm">
		    	<!-- xsolla style button -->
		      	<button class="btn_blue" type="submit" data-project_id="47429" data-id="terabts2019">
		        	<span>Buy Now</span>
		      	</button>
		      <!-- end xsolla button -->

		     	<input type="hidden" value="terabts2019" id="product_id" name="product_id"/>
		   </form>
		<% end %>
	</div>
</section>