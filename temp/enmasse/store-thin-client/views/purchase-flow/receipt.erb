<section id="wide_body" class="row">
  <div class="header-block">
      <div class="emp-header"></div>
  </div>

  <div id="purchase-receipt">
    <div class="content-block rounded">
      <div class="purchase-tracker">
        <ul>
          <li class="num lightup"><span>1</span><%= (@billing.auth_flag) ? "Update Information" : "Choose Products" %></li>
          <li class="arrow lightup">&rarr;</li>
          <li class="num lightup"><span>2</span>Review Order</li>
          <li class="arrow lightup">&rarr;</li>
          <li class="num lightup"><span>3</span>Enter Payment Details</li>
          <li class="arrow lightup">&rarr;</li>
          <li class="num lightup"><span>4</span>View Receipt</li>
        </ul>
      </div>

      <div class="content">
        <% if @billing.auth_flag? %>
          <p>Your billing and credit card information has been updated to the information below:</p>
        <% else %>
          <h2>Purchase Completed!</h2>
          <p>You will be sent an email with your order details at the address provided. The charge(s) will appear on your credit card as "<strong>ENMASSE ENT</strong>". Note: Please allow a few minutes to process your transaction.</p>
          <ul class="disc">
            <li>Order Number: <%= @billing.purchase_info['cashno'] %></li>
            <li>Date: <%= Time.now().strftime("%b %d, %Y") %></li>
          </ul>
          <!-- Order number <%= @billing.purchase_info['cashno'] %> placed on <%= Time.now().strftime("%b %d, %Y") %>: -->

          <div class="content-block product">
            <!-- Product thumb can be either 'emp' or 'elite' based on the type of purchase -->
            <div class="product-thumb <%= 'elite' if @billing.purchase_info["pgcode"] =~ /SUBSCRIPTION/ %>"></div>
            <% if @billing.purchase_info["pgcode"] =~ /SUBSCRIPTION/ %>
              <p>Elite Status <span class="right">Price: $<%= @billing.purchase_info['payamt'] %></span></p>
            <% elsif @billing.emp? %>
              <p><%= @billing.emp_amount %> EMP <span class="right">Price: $<%= @billing.purchase_info['payamt'] %></span></p>
            <% elsif @billing.item? %>
              <p><%= @billing.item.name %> EMP <span class="right">Price: $<%= @billing.purchase_info['payamt'] %></span></p>
            <% end %>
          </div>

          <div class="pricing twelve columns">
            <table class="right text-right">
              <tr>
                <td>Price:</td>
                <td>$<%= sprintf "%.2f", @billing.purchase_info['payamt'].to_f %></td>
              </tr>
              <tr>
                <td>Plus Tax:</td>
                <td>$<%= sprintf "%.2f", @billing.purchase_info['taxamt'].to_f %></td>
              </tr>
            </table>
            <hr>
            <table class="right text-right">
              <tr>
                <td><strong>Total:</strong></td>
                <td><strong>$<%= sprintf "%.2f", @billing.purchase_info['payamt'].to_f + @billing.purchase_info['taxamt'].to_f %></strong></td>
              </tr>
            </table>
          </div>
        <% end %>
          
        <% if @billing.xsolla? %>
        <!-- no billing info to show -->
        <div class="content-block payment xsolla">
          <h3 class="title-bar-dark">Payment Info</h3>
          <div class="xsolla-logo">xsolla logo</div>
        </div>
        <% else %>
        <div class="content-block billing">
          <h3 class="title-bar-dark">Billing Info</h3>
          <ul>
            <% if @billing.country == "USA" %>
              <li>City: <%= @billing.city %></li>
              <li>State: <%= (@billing.state == "^") ? "" : "#{@billing.state}" %></li>
              <li>Zip: <%= @billing.zip %></li>
            <% end %>
            <li>Country: <%= @billing.country %></li>
          </ul>
        </div>

        <div class="content-block payment">
          <h3 class="title-bar-dark">Payment Info</h3>
          <% if @billing.paypal? %>
            <div class="paypal-logo"></div>
          <% elsif @billing.xsolla? %>
            <div class="xsolla-logo">xsolla logo</div>
          <% elsif @billing.creditcard? %>
            <ul>
              <li>Credit Card - <%= @billing.purchase_info['cardtype'] %></li>
              <li>************<%= @billing.purchase_info['cardacct'] %></li>
              <li>Expires: <%= @billing.purchase_info['cardexpdate'].slice(0,2)  %>/<%= @billing.purchase_info['cardexpdate'].slice(2,2)  %></li>
            </ul>
          <% end %>
        </div>
        <% end %>

        <div class="text-align-center">
          <p><a href="/<%= @game %>/">Continue Shopping</a></p>
        </div>
      </div>
    </div>
  </div>

  <% if @billing.subscription? # Sub flow %>

    <% if @billing.auth_flag # update sub flow %>
      <script type="text/javascript">
        _gaq.push(['_trackEvent', 'Purchase Funnels', 'View Billing/Payment Update Confirmation', 'Subscription', <%= sprintf '%.2f', @billing.purchase_info['payamt'].to_f %>]);
      </script>
    <% else # new sub flow %>
      <script type="text/javascript">
        _gaq.push(['_trackEvent', 'Purchase Funnels', 'View Receipt', 'Subscription', <%= sprintf '%.2f', @billing.purchase_info['payamt'].to_f %>]);
      </script>
    <% end %>

  <% else # emp flow %>
    <script type="text/javascript">
      _gaq.push(['_trackEvent', 'Purchase Funnels', 'View Receipt', 'Virtual Currency', <%= sprintf '%.2f', @billing.purchase_info['payamt'].to_f %>]);
    </script>
  <% end %>

  <script type="text/javascript">
    _gaq.push(['_addTrans',
     "<%= @billing.purchase_info['cashno'] %>",                                                                   // order number
     'EME Store',                                                                                                 // affiliation or store name
     "<%= sprintf '%.2f', @billing.purchase_info['payamt'].to_f + @billing.purchase_info['taxamt'].to_f %>",      // total without tax and shipping - required
     "<%= @billing.purchase_info['taxamt'] %>",                                                                   // tax
     "0.00",                                                                                                      // shipping
     "<%= @billing.city.capitalize %>",                                                                           // city of purchaser
     "<%= @billing.state.capitalize %>",                                                                          // state or province of purchaser
     "<%= @billing.country.capitalize %>"                                                                         // country
    ]);
    <% if @billing.subscription? %>
      _gaq.push(['_addItem',
         "<%= @billing.purchase_info['cashno'] %>",                               // order number - necessary to associate item with transaction
         "<%= @billing.amount_id %>",                                             // item ID - if we don"t have one, just use the name but replace spaces with dashes
         "Elite Subscription",                                                    // product name
         "<%= @billing.purchase_info['payamt'] %>",                               // category or variation
         "<%= sprintf '%.2f', @billing.purchase_info['payamt'].to_f %>",          // unit price - required
         "1"                                                                      // quantity - required
      ]);
    <% else %>
      _gaq.push(['_addItem',
         "<%= @billing.purchase_info['cashno'] %>",                               // order number - necessary to associate item with transaction
         "<%= @billing.emp_amount %>-emp",                                        // item ID - if we don"t have one, just use the name but replace spaces with dashes
         "<%= @billing.emp_amount %> EMP",                                        // product name
         "Virtual Currency",                                                      // category or variation
         "<%= sprintf '%.2f', @billing.purchase_info['payamt'].to_f %>",          // unit price - required
         "1"                                                                      // quantity - required
      ]);
    <% end %>
    _gaq.push(['_trackTrans']);
  </script>
</section>
