<% time = Time.new %>

<section id="wide_body" class="row">
  <% if !session[:account_id] # IF NOT LOGGED IN %>
    SHOW ERROR STUFFS
  <% else %>
    <div class="wrapper voucher reciept">
      <div class="content">
        <div class="emp-header">
          <div class="tera-logo"></div>ELITE STATUS VOUCHERS
        </div>
        <div class="copy">
          <p class="C8C6BD">What are Elite Status Vouchers?</p>
          <p>Your Elite Status Voucher should appear within the in-game item claim in the next few minutes. For details on how to access item claim and get your item, please check out our item claim guide.</p>

          <div class="steps ">
            <span class="hr"></span>
            <ul>
              <li class="one">1.) Choose Product</li>
              <li class="two light">2.) View Receipt</li>
            </ul>
            <span class="hr"></span>
          </div>

          <p class="C8C6BD">Date: <%= time.strftime("%B %d, %Y") %></p>

          <div class="cards">
              <div class="card <%= @item.id %>"></div>
              <p class="cost">Price: <span class="emp-icon"></span><span class="price"><%= @price %></span></p>
          </div>
        </div>
      </div>

      <div class="side-bar">
        <div class="steam-logo"></div>

        <div class="side-content">
          <h5>About En Masse Entertainment</h5>
          <p>Based in Seattle, Washington, the company’s mission is to publish great games and provide the best service. Beginning with the company’s inaugural MMO title, TERA, and continuing with the PC online shooter ZMR (Zombies Monsters Robots), En Masse has quickly built a track record of excellence and innovation.</p>
          <div class="bar"></div>
        </div>
      </div>
    </div>
  <% end %>
</section>
