<section id="wide_body" class="row">
  <% if !session[:account_id] # IF NOT LOGGED IN %>
    SHOW ERROR STUFFS
  <% else %>

    <div class="wrapper voucher">
      <div class="content">
        <div class="emp-header">
          <div class="tera-logo"></div>ELITE STATUS VOUCHERS
        </div>
        <div class="copy">
          <% if flash[:error] %>
            <div class="error"><%= flash[:error] %></div>
          <% end %>
          <div class="alert">
            <p>Please Select an account.</p>
          </div>
          <p class="C8C6BD">What are Elite Status Vouchers?</p>
          <p>Elite Status Vouchers allow you to do more of what you love--play TERA! Buying a voucher and using it in-game adds 30 days of Elite Status to your account, or you can save them, sell them, or trade them for others to use.</p>
          
          <div class="steps ">
            <span class="hr"></span>
            <ul>
              <li class="one light">1.) Choose Products</li>
              <li class="two">2.) View Receipt</li>
            </ul>
            <span class="hr"></span>
          </div>

          <form id="vouchers" action="/<%= @game %>/steam/voucher/purchase/" method="post">
            <% if @game_accounts.length > 0 %>
              <% if @game_accounts.length > 1 %>
                <select class="game-account-selector" name="game_account_id">
                  <option disabled="disabled" selected>Select an account</option>
                  <% @game_accounts.each do |ga| %>
                    <option value="<%= ga["id"] %>" data-active="<%= ga["subscription_active"] %>" ><%= ga["name"] %></option>
                  <% end %>
                </select>
              <% else %>
                <input type="hidden" name="game_account_id" value="<%= @game_accounts[0]["id"] %>" data-active="<%= @game_accounts[0]["subscription_active"] %>" />
              <% end %>
            <% end %>

            

            <p class="C8C6BD">Select Duration</p>
            <input type="hidden" name="item_id" value="" />
            <input type="hidden" name="item_price" value="" />

            <div class="cards">
              <div class="voucher<%= ' disabled' if @steam30.price > @emp %>">
                <div class="card elites30"></div>
                <button class="submit" data-item="<%= @steam30.id %>" data-price="<%= @steam30.price %>"<%= ' disabled' if @steam30.price > @emp %>><%= @steam30.price %></button>
              </div>

              <div class="voucher<%= ' disabled' if @steam90.price > @emp %>">
                <div class="card elites90"></div>
                <button class="submit" data-item="<%= @steam90.id %>" data-price="<%= @steam90.price %>"<%= ' disabled' if @steam90.price > @emp %>><%= @steam90.price %></button>
              </div>
            </div>

            <div class="text-align-center">
              <% if @emp < @steam30.price %>
                <p>You need more <a href="/tera/steam-emp">EMP</a> to purchase these items.</p>
              <% elsif @emp < @steam90.price %>
                <p>Need EMP? Click <a href="/tera/steam-emp">here</a> to buy more.</p>
              <% end %>
            </div>

          </form>
        </div>
      </div>

      <script type="text/javascript">
        window.onload = function() {
          $('.game-account-selector').on('change', function(){
            $('.alert').hide();
          })
          $('#vouchers button').on('click', function(e) {
            e.preventDefault();
            if ( ( $('.game-account-selector') && $.isNumeric($('.game-account-selector').val()) ) || !$('.game-account-selector').length ) {
              $('input[name=item_id]').val( $(this).data('item') );
              $('input[name=item_price]').val( $(this).data('price') );
              $('#vouchers').submit();
            } else {
              $('.alert').show();
            }
          })
        }
      </script>

      <div class="side-bar">
        <div class="steam-logo"></div>

        <div class="side-content">
          <h5>About En Masse Entertainment</h5>
          <p>Based in Seattle, Washington, the company’s mission is to publish great games and provide the best service. Beginning with the company’s inaugural MMO title, TERA, and continuing with the PC online shooter ZMR (Zombies Monsters Robots), En Masse has quickly built a track record of excellence and innovation.</p>
          <div class="bar"></div>
        </div>
      </div>
    </div>
  <% end %>
</section>
