<div data-item-id="<%= item.id %>" class="flip-container item">
  <a href="<%= item.link %>">
    <div class="flipper">
      <div class="front card">
        
        <h3 class="title-bar-dark"><%= item.pretty_name %></h3>
        <div class="item-image" style="background-image: url(<%= item.image_url %>);">
          <% if item.bundle? %>
            <div class="bundle"></div>
          <% elsif item.lootbox? %>
            <div class="loot-box"></div>
          <% end %>
          <% if item.flair %>
            <% if !@featured_page || (@featured_page && item.flair != "featured") %>
              <div class="item-alert badge-<%= item.flair %>"><%= item.flair.upcase %></div>
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="back item-content <%= (index < 2) ? 'right' : 'left' %>">
        <h4 class="title-bar-dark">
          <div class="item-image" style="background-image: url(<%= item.image_url %>);"></div>
          <%= item.pretty_name %>
        </h4>
        <div class="item-desc">
          <% if item.campaign_description %>
            <p class="sale-desc"><%= item.campaign_description %></p>
          <% end %>
          <%= item.long_description %><div class="detail-info">Read More &#187;</div>
        </div>
      </div>
    </div>
  </a>

  <div class="item-info">
    <div class="prices">
      <div>
      <% if item.emp? %>
        <span class="emp-icon medium"></span>
      <% elsif item.cash? %>
        <span class="usd-icon medium">$</span>
      <% end %>
        <span class="price" data-currency="<%= item.currency %>"><%= item.price %></span>
      </div>
      <% if item.prices[:elite] %>
        <div class="elite"><span class="emp-icon medium"></span><span class="elite-price" data-currency="<%= item.currency %>"><%= item.elite_price %></span></div>
      <% end %>
      <% if item.prices[:sale] %>
        <span class="full-price"><%= item.prices[:sale].original_amount %></span>
      <% end %>
    </div>
    <p>
      <% if item.emp? %>
      <button class="button-secondary checkout">Check Out</button>
      <% elsif item.cash? %>
      <button class="button-secondary purchase">Purchase</button>
      <% end %>
    </p>
  </div>

  <%= erb :"shared/item-modal-product-info", :locals => { :item => item } %>
</div>
