<div class="details">
  <h3 class="title-bar-dark" id="itemName"><%= item.name %></h3>
  <div class="purchase-info">
    <div class="purchase-image">
      <div class="item-image" style='background-image: url(<%= item.image_url %>);'>
        <% if item.bundle? %>
          <div class="bundle"></div>
        <% elsif item.lootbox? %>
          <div class="loot-box"></div>
        <% end %>
        <% if item.flair %>
          <div class="item-alert badge-<%= item.flair %>"><%= item.flair.upcase %></div>
        <% end %>
      </div>
    </div>
    <% if item.campaign_description %>
      <p class="sale-desc"><%= item.campaign_description %></p>
    <% end %>
    <%= item.long_description %>
  </div>

  <% if item.sale_price %>
    <div class="prices">
      <table>
        <tr>
          <td>Original Price:</td>
          <td><span class="emp-icon small"></span></td>
          <td><%= item.normal_price %></td>
        </tr>
        <tr>
          <td>Discount:</td>
          <td><span class="emp-icon small"></span></td>
          <td><%= item.sale_price - item.normal_price %></td>
        </tr>
      </table>
    </div>
  <% elsif item.elite_price %>
    <div class="prices">
      <table>
        <tr>
          <td>Normal Price:</td>
          <td><span class="emp-icon small"></span></td>
          <td><%= item.normal_price %></td>
        </tr>
        <tr>
          <td>Elite Discount:</td>
          <td><span class="emp-icon small"></span></td>
          <td><%= item.elite_price - item.normal_price %></td>
        </tr>
      </table>
    </div>
  <% end %>
</div>
