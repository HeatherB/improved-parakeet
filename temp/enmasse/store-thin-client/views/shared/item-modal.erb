<div id="foundation-modal" class="reveal-modal">
  <div class="row item-modal">
    <div class="desc"></div>
    <div id="modal-error"<%= ' style="display:none;"' unless flash[:modalerror] %>>
      <div class="error">
        <span class="icon"></span><span id="error-message"><%= flash[:modalerror] %></span>
      </div>
    </div>
    <div id="modal-warning"<%= ' style="display:none;"' unless flash[:modalwarn] %>>
      <div class="warning"><span class="icon"></span><%= flash[:modalwarn] %></div>
    </div>
    <% if flash[:modalmessage] %>
      <div class="info"><span class="icon"></span><%= flash[:modalmessage] %></div>
    <% end %>
    <% if @game_accounts && @game_accounts.length > 0 %>
      <div class="purchase-actions">
        <form id="purchase-item">
          <input type="hidden" value="" id="item-id" name="item_id">
          <input type="hidden" value="" id="item-price" name="item_price">
          <% if @game_accounts.length > 0 %>
            <div class="account">
              <p class="show-for-small">Game Account:</p>
              <select id="game-account-selector" name="game_account_id">
                <% if @game_accounts.length > 1 %>
                    <option disabled="disabled" value="0" selected>Select an account</option>
                <% end %>
                <% @game_accounts.each do |ga| %>
                  <% elite = ga["subscription_active"] %>
                  <option value="<%= ga["id"] %>" data-elite="<%= elite %>"><%= ga["name"] %><%= ' (Elite)' if elite %></option>
                <% end %>
              </select>
              <p class="hide-for-small">Game Account:</p>
            </div>
          <% end %>
          <hr>
          <ul>
            <li>
              <a class="button-secondary" id="buy-form-submit" href="#">Buy for PC <span class="emp-icon medium"></span><span id="buy-now-price"></span></a>
            </li>
            <li>
              <a href="#" class="close-modal">Close without buying</a>
            </li>
          </ul>
        </form>
      </div>
    <% elsif session[:account_id] #logged in (no game accounts) %>
      <hr>
      <div class="register">
        <p>You need to create a TERA game account to purchase this. <a href="<%= SimpleSSO::ACCOUNT_SERVER_SECURE_URL %>"></a></p>
      </div>
    <% else %>
      <hr>
      <div class="register">
        <p>Sign in below to purchase items!</p>
        <%= erb :"shared/login-form" %>
      </div>
    <% end %>
  </div>
  <a class="close-reveal-modal">&#215;</a>
</div>

<div id="success-modal" class="reveal-modal">
  <div class="row item-modal">
    <h3 class="title-bar-dark">Purchase Completed!</h3>
    <div class="desc">
      <div class="purchase-info">
        <div class="purchase-image">
          <div class="item-image"></div>
        </div>
        <p>Thank you for your purchase!</p>
        <h3>Transaction Info</h3>
        <ul>
          <li>Item: <span class="item-name"></span></li>
          <li>Price: <span class="emp-icon small" style="margin-bottom: -7px;"></span><span class="receipt-price"></span></li>
          <!--li>Transaction Number: <span class="trx-number"></span></li-->
        </ul>
        <h3>Claiming Your Item</h3>
        <p class="item-message">Your <strong class="item-name"></strong> should appear within the in-game item claim in the next few minutes. For details on how to access item claim and get your item, please check out our <a href="https://support.enmasse.com/hc/en-us/articles/360017874413-Claiming-Items-in-TERA" title="How do I claim my Premium Services and purchased/promotional items? - TERA Support">item claim guide</a>.</p>
        <p class="gift-message">You have purchased a Wintera golden gift box. You can open it or give it away through the <a href="/tera/gifts">Wintera gifting center</a>.</p>
        <p class="anni-gift-message">You have purchased a TERA 5th Anniversary golden gift box. You can open it or give it away through the <a href="/tera/gifts">TERA 5th Anniversary gifting center</a>.</p>
      </div>
    </div>
    <hr>
    <div class="purchase-actions">
      <a href="#" class="close-modal">Close this window</a>
    </div>
  </div>
  <a class="close-reveal-modal">&#215;</a>
</div>
