<%= erb :"shared/tera-filters" %>
<section id="wide_body" class="row">
  <% row_length = 4; i = 0 %>
  
  <% if @category && File.exists?(File.join(settings.root, "views/shared/cat-header/#{@category}.erb")) %>
    <%= erb :"shared/cat-header/#{@category}" %>
  <% end %>

  <div class="twelve columns">
    <%= erb :"shared/pagination", :locals => { :page_as => :param } %>
  </div>

  <% if @items.length == 0 %>
    <div class="row">
      <div class="content text-align-center">
        <% if(@category) == 'elite' %>
          <p><strong>There are currently no elite status discounts. Check back later for our next discount offers!</strong></p>
        <% else %>
          <p><strong>No items match your search.</strong></p>
        <% end %>
        <% if( (params[:race] && params[:race] != 'all') || (params[:class] && params[:class] != 'all') || (params[:duration] && params[:duration] != 'all' ) ) %>
          <form id="clear-filters">
            <input type="submit" value="Clear search filters">
          </form>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="item-container twelve columns">
      <% while i < @items.length do %>
        <%= erb :'shared/item-row', :locals => {:items => @items[i...(i+4)] } %>
        <% i += row_length %>
      <% end %>
    </div>
  <% end %>

  <div class="twelve columns">
    <%= erb :"shared/pagination", :locals => { :page_as => :param } %>
  </div>
</section>
