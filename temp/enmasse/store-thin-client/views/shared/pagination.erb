<% if defined?(@last_page) && @last_page > 1 %>
  <% page_as = :normal if !defined?(page_as) %>
  <div class="pagination">
    <% if @current_page > 1 %>
      <%= page_link( @current_page - 1, '&laquo;', page_as) %>
      <%= page_link( 1, 1, page_as) %>
    <% end %>
  
    <% if @current_page > 4 %>
      <span>&hellip;</span>
    <% end %>
  
    <% if @current_page > 3 %>
      <%= page_link( @current_page - 2, @current_page - 2, page_as) %>
    <% end %>

    <% if @current_page > 2 %>
      <%= page_link( @current_page - 1, @current_page - 1, page_as) %>
    <% end %>
  
    <span><%= @current_page %></span>
  
    <% if @current_page < @last_page - 1 %>
      <%= page_link( @current_page + 1, @current_page + 1, page_as) %>
    <% end %>

    <% if @current_page < @last_page - 2 %>
      <%= page_link( @current_page + 2, @current_page + 2, page_as) %>
    <% end %>
  
    <% if @current_page < @last_page - 3 %>
      <span>&hellip;</span>
    <% end %>
  
    <% if @current_page < @last_page %>
      <%= page_link( @last_page, @last_page, page_as) %>
      <%= page_link( @current_page + 1, '&raquo;', page_as) %>
    <% end %>
  </div>
<% end %>
