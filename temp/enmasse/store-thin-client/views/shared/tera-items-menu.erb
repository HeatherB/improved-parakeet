<% prams = request.query_string.gsub(/page=\d+/, '')
   prams = prams.gsub(/&&/, '&').gsub(/&$/, '')
   prams = '?' + prams if prams.length > 2 %>
<nav id="tera-item-menu" class="top-bar row">
  <ul>
    <li class="name">Select Category</li>
    <li class="toggle-topbar"><a href="#"></a></li>
  </ul>
  <section>
    <ul class="menu-tree">
      <li class="two columns has-dropdown has-flyout<%= ' active' if (@category == 'character') %>">
        <a href="/tera/items/character<%= prams %>">Character</a>
        <ul class="flyout">
          <li><a href="/tera/items/accessories<%= prams %>">Accessories</a></li>
          <li><a href="/tera/items/costumes<%= prams %>">Costumes</a></li>
          <li><a href="/tera/items/weapon-skins<%= prams %>">Weapon Skins</a></li>
        </ul>
      </li>
      <li class="two columns<%= ' active' if (@category == 'mounts') %>"><a href="/tera/items/mounts<%= prams %>">Mounts &amp; Pets</a></li>
      <li class="two columns<%= ' active' if (@category == 'consumables') %>"><a href="/tera/items/consumables<%= prams %>">Consumables</a></li>
      <li class="two columns<%= ' active' if (@category == 'loot-boxes') %>"><a href="/tera/items/loot-boxes<%= prams %>">Loot Boxes</a></li>
      <li class="two columns<%= ' active' if (@category == 'account-services') %>"><a href="/tera/items/account-services<%= prams %>">Account Services</a></li>
      <li class="two columns gold has-dropdown has-flyout<%= ' active' if (@category == 'elite') %>">
        <a href="/tera/items/elite<%= prams %>">Elite Discounts</a>
        <ul class="flyout">
          <li><a href="/tera/elite-status">Get Elite Status</a></li>
          <!--<li><a href="/tera/items/elite<%= prams %>">Elite Discounts</a></li>-->
        </ul>
      </li>
    </ul>
  </section>
</nav>
