<% if ENV['RACK_ENV'] == 'deployment' %>
  <script>
    try {
      _tera_client_proxy_
    }
    catch(err) {
      _tera_client_proxy_ = null;
    }

    window.onload = function() {
      BT.bt = new BT({url: 'https://bt.enmasse.com', uid: '<%= @user["id"] %>', res: 'EME Store', game: 'tera'});
      if (!_tera_client_proxy_) {// in browser
        BT.bt.t({md: 'In browser', act: 'load', label: 'Tera Daily Deals'});
        _gaq.push(['_trackEvent', 'Tera Daily Deals', 'Load in Browser', '/tera/dailydeals']); 
      } else {// in game
        BT.bt.t({md: 'In game', act: 'load', label: 'Tera Daily Deals'});
        _gaq.push(['_trackEvent', 'Tera Daily Deals', 'Load in Game', '/tera/dailydeals']); 
      }
    }
  </script>
<% end %>

<main class="tera_dailydeals">
	<div id="welcome-window-deals">
		<!--<section id="welcome-header">
			<div class="inner">
				<h1>TERA Daily Deals</h1>
			</div>
		</section>-->

		<!-- elite discount is 15% off -->


		<section id="welcome-main">
			<div class="inner">
				<div class="daily-deals">
				<% @items.each do |item| %>

					<!-- begin of deal -->
					<div class="daily-deal <%= 'elite-user' if @existing_sub %> <%= 'elite-item' if item.tags.include?('tag:elite_offer') %>" id="tera_dailydeal-<%= item.id %>">

						<% 
							@tags = item.tags 
							@tags.each do |tag| %>

						 	<% if tag == "tag:out_of_vault" %>
						 		<div class="dealTag cyan">
									<h4>Out of the Vault</h4>
								</div>
						 	<% end %>

						 	<% if tag == "tag:no_risk" %>
						 		<div class="dealTag magenta">
									<h4>No Risk; All Reward</h4>
								</div>
						 	<% end %>

						 	<% if tag == "tag:last_one_free" %>
						 		<div class="dealTag yellow">
									<h4>Last One's Free!</h4>
								</div>
						 	<% end %>

						 	<% if tag == "tag:elite_offer" %>
						 		<div class="dealTag white">
									<h4>ELITE-ONLY</h4>
								</div>
						 	<% end %>

						<% 	end %>

						<div class="deal-title">
							<p><%= item.name %></p>	
						</div>
						<div class="deal-img">
							<div class="deal-img-holder" style="background-image: url(<%= item.img_url %>);"></div>
						</div>


						 	<% if item.tags.include?("tag:out_of_vault")%>
						 		<div class="deal-copy hasTag">
									<p><%= item.long_description %></p>
								</div>
							<% elsif item.tags.include?("tag:no_risk")%>
						 		<div class="deal-copy hasTag">
									<p><%= item.long_description %></p>
								</div>
							<% elsif item.tags.include?("tag:last_one_free")%>
						 		<div class="deal-copy hasTag">
									<p><%= item.long_description %></p>
								</div>
							<% elsif item.tags.include?("tag:elite_offer")%>
						 		<div class="deal-copy hasTag">
									<p><%= item.long_description %></p>
								</div>
							<% else %>
								<div class="deal-copy">
									<p><%= item.long_description %></p>
								</div>
						 	<% end %>	




						<div class="deal-ft">
							<% if item.details.to_i > 0 %>
							<!-- we have a sale -->
								<% 
									fake_regular_price = item.price.to_i + item.details.to_i
									fake_sale_price =  item.price.to_i
									finalprice = fake_regular_price
								%>
								<% 
									#if item.price.to_i - item.details.to_i  > 0
									#	saleprice = item.price.to_i - item.details.to_i 
									#else
									#	saleprice = 0
									#end
									fake_remainder = fake_regular_price - fake_sale_price
									# 498 = 993 - 495

									percentOff = (fake_remainder.to_f / fake_regular_price.to_f) * 100 
									#498 / 993
									percentOff = percentOff.to_i 

									#finalprice = saleprice
								%>
								
							<% else %>
								<% finalprice = item.price %>
							<% end %>


							<% if item.details.to_i > 0 %>
								<div class="price-block sale">
									<span class="price-title">
										<% if item.tags.include?("tag:elite_offer") %>
										Elite Discount
										<% else %>
										Today's Deal
										<% end %>
									</span>
									<span class="emp-icon"></span>
									<span class="price-monies"><%= item.price %></span>
									<span class="price-discount"><%= percentOff %>% OFF</span>
								</div>
							<% end %>

							<div class="price-block <%= ' slashthru ' if item.details.to_i > 0 %>">
								<span class="price-title">
									<%= item.details.to_i > 0 ? "Regular Price" : "Today's Deal" %>
								</span>
								<span class="emp-icon"></span>
								<span class="price-monies"><%= finalprice %></span>
							</div>

							<% if @existing_sub %>
								<!-- user is elite 
								<h5>user is elite</h5>-->
								<% if item.tags.include?("tag:elite_offer") %>
									<!-- item is elite
									<h5>item is elite</h5> -->
								<% else %>
									<!-- item is not elite 
									<h5>item is not elite</h5>-->
								<% end %>
								<button type="button" class="buy-item-btn" data-game="TERA" data-name="<%= item.name %>" data-image="<%= item.img_url %>" data-user="<%= @gameaccounts %>" data-price="<%= item.price %>" data-discount="<%= item.details %>" data-amount="<%= item.pretty_name[0] + "x" %>" data-id="<%= item.id %>" >Get It</button>
							<% else %>
								<!-- user is not elite 
								<h5>user is not elite</h5>-->
								<% if item.tags.include?("tag:elite_offer") %>
									<!-- item is elite -->
									<!-- http://tera.enmasse.com/store/elite-status -->
									<button type="button" class="buy-elite-status">Become Elite</button>
								<% else %>
									<!-- item is not elite 
									<h5>item is not elite</h5>-->
									<button type="button" class="buy-item-btn" data-game="TERA" data-name="<%= item.name %>" data-image="<%= item.img_url %>" data-user="<%= @gameaccounts %>" data-price="<%= item.price %>" data-discount="<%= item.details %>" data-amount="<%= item.pretty_name[0] + "x" %>" data-id="<%= item.id %>" >Get It</button>
								<% end %>
							<% end %>


							<!--<button type="button" class="buy-item-btn" data-game="TERA" data-name="<%#= item.name %>" data-image="<%#= item.img_url %>" data-user="<%#= @gameaccounts %>" data-price="<%#= item.price %>" data-discount="<%#= item.details %>" data-amount="<%#= item.pretty_name[0] + "x" %>" data-id="<%#= item.id %>" >Get It</button>-->
							
						</div>
					</div>
					<!-- end of deal -->



				<% end %>

					
				</div>
			</div>
			<div id="sheer"></div>
		</section>
		<section id="welcome-footer">
			<div class="inner">
				<div id="deal-date-notify">
					<h4>CHECK BACK DAILY! ITEMS CAN CHANGE AT 10 A.M. PACIFIC</h4>
				</div>
				<!--<div id="deal-timer">
					<h4>Deals Expire in:</h4>
					<span id="tera-deal-hours"></span>
					<span id="tera-deal-minutes"></span>
					<span id="tera-deal-seconds"></span>
				</div>-->
				<h6>EMP: <span class="emp-icon"></span><span id="welcome-emp"><%= @emp %></span></h6>
				<div class="actions">
					<button type="button" class="buy-emp">Buy EMP</button>
				</div>
			</div>
		</section>

		<div id="pur_confirm" class="modal">
			<div class="modal_header">
				<div class="deal-label">Confirm Purchase:</div>
				<div class="deal-title"></div>
				<span class="close-modal"></span>
			</div>
			<div class="modal_content">
				<div class="deal-img">
					<div class="deal-img-holder"></div>
					<!--<img src="<%#= item.img_url %>" alt="<%#= item.name %>" />-->
				</div>
			</div>
			<div class="modal_foot">
				<div id="hidden_dd_form" style="display: none;">
					<form id="purchase_dd_item">
						<input type="hidden" value="" id="game_account_id" name="game_account_id" />
						<input type="hidden" value="" id="dd_name" name="dd_name" />
						<input type="hidden" value="" id="item_id" name="item_id" />
						<input type="hidden" value="" id="item_price" name="item_price" />
					</form>
				</div>
				<button id="buy-this-deal">
					<span class="emp-icon"></span>
					<div class="deal-price"></div>
				</button>
			</div>
		</div><!-- end of purchase confirm modal -->

		<div id="pur_success" class="modal">
			<div class="modal_header">
				<div class="deal-label">Purchase Successful:</div>
				<div class="deal-title"></div>
				<span class="close-modal"></span>
			</div>
			<div class="modal_content">
				<div class="deal-img">
					<div class="deal-img-holder"></div>
					<span class="starburst"></span>
				</div>
			</div>
			<div class="modal_foot">
				<p class="purchase_info">
					Your <span id="bought_item"></span> will appear in <b>Item Claim</b> in the next few minutes.
				</p>
				<!--<div class="close-modal success">OK</div>-->
			</div>
		</div><!-- end of purchase success modal -->

		<div id="pur_failed" class="modal">
			<div class="modal_header">
				<div class="deal-label">Purchase Failed:</div>
				<div class="deal-title"></div>
				<span class="close-modal"></span>
			</div>
			<div class="modal_content">
				<div class="deal-img">
					<div class="deal-img-holder"></div>
				</div>
			</div>
			<div class="modal_foot">
				<p class="purchase_info">
					Your attempt to purchase <span id="bought_item"></span> was not successful.
				</p>
				<p id="errorMsg"></p>
			</div>
		</div><!-- end of purchase fail modal -->
	</div><!-- end of welcome daily deals -->
	
</main>

<script type="text/javascript">
  var WelcomeWindowResize = (function() {
    function resizeWindow() {
      try {
        _tera_client_proxy_;
      }
      catch(err) {
        _tera_client_proxy_ = null;
      }
      if (_tera_client_proxy_) {
        _tera_client_proxy_.resize_to(968,540);
      }
    };

    return {
      init: function() {
        resizeWindow();
      }
    }
  }());
  window.onload = function() {
    WelcomeWindowResize.init();
  }
</script>
