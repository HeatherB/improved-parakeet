<% if ENV['RACK_ENV'] == 'deployment' %>
  <script>
    try {
      _tera_client_proxy_
    }
    catch(err) {
      _tera_client_proxy_ = null;
    }

    window.onload = function() {
      BT.bt = new BT({url: 'https://bt.enmasse.com', uid: '<%= @user["id"] %>', res: 'EME Store', game: 'tera'});
      if (!_tera_client_proxy_) {// in browser
        BT.bt.t({md: 'In browser', act: 'load', label: 'Tera Daily Deals'});
        _gaq.push(['_trackEvent', 'Tera Daily Deals', 'Load in Browser', '/tera/dailydeals']); 
      } else {// in game
        BT.bt.t({md: 'In game', act: 'load', label: 'Tera Daily Deals'});
        _gaq.push(['_trackEvent', 'Tera Daily Deals', 'Load in Game', '/tera/dailydeals']); 
      }
    }
  </script>
<% end %>
<main class="tera_giftingwindow">
	<div id="content">
        <div id="preview-window">
            <h1>SEND GIFTS TO UNLOCK THESE REWARDS <div id="learn-more" class="blue-btn">Learn More</div></h1>
            <img id="gift-img" data-tab="1" src="https://eme01.enmasse-game.com/store/tera/2018-gifting/welcome-window/background2.jpg" />
            <div class="tabs" data-tab="1">
                <div id="left-arrow"></div>
                <div class="text">
                    <h2>15-Box Reward: <span>Crown of Glory (Account-Bound)</h2>
                    <p>This token of bravery and honor is given to warriors only that have achieved 500 accumulated wins in the Defiance Run.
                    "The Imperial Crown doesn't mean the bearer is the strongest, but I wouldn't try </p>
                </div>
                <div id="right-arrow"></div>
            </div>
        </div>
        <div id="buy-gift-window" class="hidden">
            <div id="gifts-to-open" data-received="<%= @my_gifts["received_gifts"].select{|q| q["opened_by"].nil?}.length + @my_gifts["unsent_gifts"].length %>" class="<% if @my_gifts["received_gifts"].select{|q| q["opened_by"].nil?}.length + @my_gifts["unsent_gifts"].length == 0 %>none<% end %>"><span id="alert_num"><%= @my_gifts["received_gifts"].select{|q| q["opened_by"].nil?}.length + @my_gifts["unsent_gifts"].length %></span>
            </div>
            <h3 class="over">The gifting event is over, but you can still open your gifts over at <u>https://store.enmasse.com/tera/gifts</u> for a little while longer!</h3>
            <div class="buy-gifts-image">
                <div class="whats-in-the-box" href=""></div>
            </div>
            <h2>Number of Gift Boxes</h2>
            <button class="orange-btn buy-selection selected" data-num="1">1 BOX</button><button class="orange-btn buy-selection" data-num="2">2 BOXES</button><button class="orange-btn buy-selection" data-num="5">5 BOXES</button>
            <div class="buy-section">
                <div class="price">
                    Giftbox Price<br />
                    <span style="margin-top: 5px; display: block;"><span class="emp-icon"></span><span id="box-price">2495</span></span>
                </div>
                <button id="buy-btn" class="orange-btn">BUY GIFT BOX(s)</button>
            </div>
        </div>
        <div id="purchased-text">You have sent <span><%= @my_gifts["sent_count"] %></span> boxes. 
            <% if @my_gifts["sent_count"].to_i < 1 %>
                You’re <span>1</span> box(s) away from the next reward!
            <% elsif @my_gifts["sent_count"].to_i < 5 %>
                You’re <span><%= 5 - @my_gifts["sent_count"].to_i %></span> box(s) away from the next reward!
            <% elsif @my_gifts["sent_count"].to_i < 10 %>
                You’re <span><%= 10 - @my_gifts["sent_count"].to_i %></span> box(s) away from the next reward!
            <% elsif @my_gifts["sent_count"].to_i < 15 %>
                You’re <span><%= 15 - @my_gifts["sent_count"].to_i %></span> box(s) away from the next reward!
            <% elsif @my_gifts["sent_count"].to_i < 20 %>
                You’re <span><%= 20 - @my_gifts["sent_count"].to_i %></span> box(s) away from the next reward!
            <% end %>
        </div>
  <% if (@my_gifts[:error]) %>
  <%# elsif (@my_gifts["received_gifts"].nil? || @my_gifts["received_gifts"].select{|q| q["opened_by"].nil?}.length < 1) && (@my_gifts["unsent_gifts"].nil? || @my_gifts["unsent_gifts"].empty?) %>
  <% else %>
    <article class="twelve columns buy-more">
      <ul id="gifts_tracker">
        <li class="<%= 'active' if @my_gifts["sent_count"].to_i >= 1 %>" >1</li>
        <li class="<%= 'active' if @my_gifts["sent_count"].to_i >= 5 %>">5</li>
        <li class="<%= 'active' if @my_gifts["sent_count"].to_i >= 10 %>">10</li>
        <li class="<%= 'active' if @my_gifts["sent_count"].to_i >= 15 %>">15</li>
        <li class="<%= 'active' if @my_gifts["sent_count"].to_i >= 20 %>">20</li>
      </ul>
      <div class="purchased<%= ' whale' if (!@game_accounts.nil? && !@my_gifts.nil? && @my_gifts.key?("sent_count") && @my_gifts["sent_count"].to_i > 19) %>">
      <% if @game_accounts.nil? || @my_gifts.nil? %>
        <div class="bar"><span id="fill-0"></span></div>
      <% else %>
        <div class="bar">
          <% if @my_gifts["sent_count"] != nil && @my_gifts["sent_count"] > 0 %>
            <span class="left-section"></span>
            <span id="fill-<%= (@my_gifts["sent_count"] < 20) ? @my_gifts["sent_count"] : '20' %>"></span>
            <span id="countingplate-<%= (@my_gifts["sent_count"] < 20) ? @my_gifts["sent_count"] : '20' %>"></span>
            <span class="right-section"></span>
          <% else %>
            <span id="fill-0"></span>
          <% end %>
        </div>
      <% end %>

        <div class="markers">
          <span class="marker-1 <%= 'active' if @my_gifts["sent_count"].to_i >= 1 %>"></span>
          <span class="marker-2"></span>
          <span class="marker-3"></span>
          <span class="marker-4"></span>
          <span class="marker-5 <%= 'active' if @my_gifts["sent_count"].to_i >= 5 %>"></span>
          <span class="marker-6"></span>
          <span class="marker-7"></span>
          <span class="marker-8"></span>
          <span class="marker-9"></span>
          <span class="marker-10 <%= 'active' if @my_gifts["sent_count"].to_i >= 10 %>"></span>
          <span class="marker-11"></span>
          <span class="marker-12"></span>
          <span class="marker-13"></span>
          <span class="marker-14"></span>
          <span class="marker-15 <%= 'active' if @my_gifts["sent_count"].to_i >= 15 %>"></span>
          <span class="marker-16"></span>
          <span class="marker-17"></span>
          <span class="marker-18"></span>
          <span class="marker-19"></span>
          <span class="marker-20 <%= 'active' if @my_gifts["sent_count"].to_i >= 20 %>"></span>
        </div>
      </div>

    </article>
  <% end %>
  <div class="buy-emp-panel">
    <h6>EMP: <span class="emp-icon"></span><span id="welcome-emp"><%= @emp %></span></h6>
    <a class="buy-emp" href="#"><button type="button" class="buy-emp modal-blue-btn">Buy EMP</button></a>
  </div>
        <div id="overlay"></div>
        <div id="modal1" class="modal">
            <h2>Here's how the TERA Gifting Center works</h2>
            <div class="instructions">
                <p>1. Buy Golden Gift Boxes here or in the <em>TERA</em> Web Store.</p>
                <p>2. Go to the TERA Gifting Center and open your boxes;<br />
                or<br />
                Send boxes to friends to unlock special rewards.</p>
                <p>Receive your items from the in-game Item Claim.</p>
                <p>Some restrictions apply. Please reference the Golden Gift Box event FAQ for more details and a full list of prizes.</p>
            </div>
            <button class="green-btn close-modal">CONTINUE</button>
        </div>
        <div id="modal2" class="modal">
            <button class="close-btn close-modal">x</button>
            <img id="gift-img" class="gift-img" src="https://eme01.enmasse-game.com/store/tera/2018-gifting/welcome-window/modal2gifts.png" />
            <a href="#" class="gifting-center-link"><button class="modal-blue-btn">See My Gifts <span class="icon"></span></button></a>
        </div>
        <div id="modal3" class="modal">
            <button class="close-btn close-modal">x</button>
            <img class="gift-img-2" src="https://eme01.enmasse-game.com/store/tera/2018-gifting/welcome-window/modal3gifts.png" />
            <p>You are about to purchase <strong>FIVE GOLDEN GIFT BOXES</strong> from the TERA Web Store for <strong>9995 EMP</strong>.<br /><br />
            Please confirm that you wish to purchase and apply this item to your account at this time.</p>
            <h6>EMP Price: <span class="emp-icon"></span><span id="welcome-emp">998005</span></h6>
            <button id="buy-now" class="modal-blue-btn">Buy Now</button>
        </div>
        <div id="modal4" class="modal">
            <button class="close-btn close-modal">x</button>
            <img class="gift-img-2" src="https://eme01.enmasse-game.com/store/tera/2018-gifting/welcome-window/modal3gifts.png" />
            <p>You have successfully purchased <strong>FIVE GOLDEN GIFT BOXES</strong> from the TERA Web Store.<br /><br />
            Continue shopping or go to the gifting center to open your gifts or send it to a friend for rewards.</p>
            <a class="gifting-center-link" href="#"><button class="modal-blue-btn gifting-btn">Gifting Center <span class="icon"></span></button></a><button class="modal-blue-btn close-modal">Continue</button>
        </div>
        <div id="modal5" class="modal">
            <button class="close-btn close-modal">x</button>
            <h2>EACH GOLDEN GIFTBOX OFFERS A CHANCE AT THE ITEMS BELOW</h2>
            <div id="products">

            </div>
            <button class="modal-blue-btn close-modal">Continue</button>
        </div>
    </div>
    <div id="user-info" data-account="<%= @gameaccounts %>">
</main>

<script type="text/javascript">
  var WelcomeWindowResize = (function() {
    function resizeWindow() {
      try {
        _tera_client_proxy_;
      }
      catch(err) {
        _tera_client_proxy_ = null;
      }
      if (_tera_client_proxy_) {
        _tera_client_proxy_.resize_to(968,540);
      }
    };

    return {
      init: function() {
        resizeWindow();
      }
    }
  }());
  window.onload = function() {
    WelcomeWindowResize.init();
  }
</script>

<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.7.1/jquery.min.js"></script>
<script type="text/javascript" src="https://eme01.enmasse-game.com/store/tera/js/gifting-minified5.js"></script>
