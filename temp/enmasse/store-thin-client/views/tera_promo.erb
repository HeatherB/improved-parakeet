<%
  @promo_start = Time.new(2019,  8, 28, 10, 00, 00, "-08:00")
  @promo_end =   Time.new(2019,  9, 17, 12, 59, 00, "-08:00")

  @promo = ((Time.now > @promo_start) && (Time.now < @promo_end))
%>
<%
  @secondarypromo_start = Time.new(2018,  9, 19, 10, 00, 00, "-08:00")
  @secondarypromo_end =   Time.new(2018,  9, 25, 10, 00, 00, "-08:00")

  @secondarypromo = ((Time.now > @secondarypromo_start) && (Time.now < @secondarypromo_end))
%>
<%
  @promoAgain_start = Time.new(2018,  5, 29, 10, 00, 00, "-08:00")
  @promoAgain_end =   Time.new(2018,  6, 1, 10, 00, 00, "-08:00")

  @promoAgain = ((Time.now > @promoAgain_start) && (Time.now < @promoAgain_end))
%>
<%
  @changeBack_start = Time.new(2017,  7, 25, 19, 00, 00, "-08:00")

  @changeBack = (Time.now > @changeBack_start)
%>

  <%
  # Promo Gumball
  if @promo %>
  <div class="promotions row promo">
    <a href="https://store.enmasse.com/tera/packs" class="main" style="background-image: url(<%=img_url('store-promo-tera_pack_bts2019.jpg')%>);">
    <div class="caption">
      <h3><em>TERA</em> Back to School pack</h3>
      <p>Wooley will make all your mates' heads turn. Get this exclusively in the Back to School pack!</p>
    </div>
    </a>
  <%
  # Secondary Promo Gumball
  elsif @secondarypromo %>
   <div class="promotions row promo">
    <a href="https://store.enmasse.com/tera/items/thrallfootsteps" class="main" style="background-image: url(<%=img_url('store-promo-thrall-footsteps.jpg')%>);">
    <div class="caption">
      <h3>All Hail King Blingling!</h3>
      <p>New footsteps have hit the store, and they’ll make you feel like a king.</p>
    </div>
    </a>
  <% 
    # wierd extra case promo endcaps
  elsif @promoAgain %>
  <div class="promotions row promo">
    <a href="/tera/items/sixthanniversaryfootsteps" class="main" style="background-image: url(<%=img_url('store-promo-fireice.jpg')%>);">
    <div class="caption">
      <h3>A Walk Through Fire and Ice</h3>
      <p>Celebrate 6 years together with Fire and Ice Anniversary Footsteps.</p>
    </div>
    </a>
  <%
  # Default elite gumball
  else %>
  <div class="promotions row">
    <a href="http://tera.enmasse.com/store/elite-status" class="main" style="background-image: url(<%=img_url('store-promo-default.png')%>);">
    <div class="caption">
      <h3>Elite Perks</h3>
      <p>Reap the benefits every day!</p>
    </div>
    </a>
  <% end %>
 

 <!-- allow 'regular' adverts to change on timer -->
 <% if @changeBack %>
  <a href="http://tera.enmasse.com/store/elite-status" class="mini elite" style="background-image: url(<%=img_url('store-promo-default.png')%>);">
    <!--<div class="caption">
      <h3>Get Elite Status</h3>
      <h3 class="short">Go Elite</h3>
    </div>-->
  </a>
  <a href="/tera/emp" class="mini emp" style="background-image: url(<%=img_url('store-promo-default.png')%>);">
    <!--<div class="caption">
      <h3>Buy En Masse Points</h3>
      <h3 class="short">Buy EMP</h3>
    </div>-->
  </a>
<% else %>
<!-- before change back takes effect -->
  <a href="https://kritika.enmasse.com/store" class="mini elite" style="background-image: url(<%=img_url('store-promo-anni-krit.jpg')%>);">
    <!--<div class="caption">
      <h3>Get Elite Status</h3>
      <h3 class="short">Go Elite</h3>
    </div>-->
  </a>
  <a href="/tera/emp" class="mini emp" style="background-image: url(<%=img_url('store-promo-anni-krit.jpg')%>);">
    <!--<div class="caption">
      <h3>Buy En Masse Points</h3>
      <h3 class="short">Buy EMP</h3>
    </div>-->
  </a>
<% end %>
</div>
