<section id="wide_body" class="row">
  <div class="currencies">
    <div class="content-block">
      <div class="emp-header"></div>
      <div class="content">
        <h2>What Is EMP?</h2>
        <p>En Masse Points (EMP) let you buy</p>
        <ul class="disc">
          <li><strong>convenient improvements</strong> like character slots, XP boosts, and strongbox keys</li>
          <li><strong>customized looks</strong> like weapon skins&#8218; costumes&#8218; mounts&#8218; and more</li>
        </ul>
      </div>
    </div>

    <%= @virtual_currencies %>

    <%#= erb :virtual_currency_offers %>
    <div class="register">
      <% if !session[:account_id] %>
        <% if !@virtual_currencies.empty? %>
          <p><strong>Prices do not include tax.</strong> To see the final price and make a purchase, you must sign in.</p>
        <% end %>
        <%= erb :"shared/login-form" %>
      <% else %>
       <p><strong>Prices do not include tax.</strong> To see the final price, you will have to get your account activated.</p>
      <% end %>
    </div>

  </div>
</section>
