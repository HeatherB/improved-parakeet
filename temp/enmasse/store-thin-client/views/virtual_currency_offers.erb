<section>
  <ul>
    <% if @virtual_currencies.empty? %>
      <div class="error-alert"><span></span>We could not retrieve the EMP options. Logging in may resolve this error.</div>
    <% else %>
      <% @virtual_currencies.each do |vc| %>
        <% product = vc.prices.select{|p| p["currency"] == "USD"}.first %>
        <% if product %>
          <li>
            <input type="radio" name="toggle" id="<%= vc.id %>">
            <label for="<%= vc.id %>">
              <p class="emp-count"><span class="emp-icon"></span><%= vc.name %></p>
              <p class="emp-price">
                <% if( (product["price"].to_f - product["price"].to_i.to_f + 0.00001) < 0.0001 ) %>
                  $<%= product["price"].to_i %>
                <% else %>
                  $<%= "%.2f" % product["price"].to_f %>
                <% end %>
              </p>
              <div class="bonus">
                  <div class="ribbon-wrapper"><div class="ribbon"><%= vc.longDescription %></div></div>
              </div>
            </label>
          </li>
        <% end %>
      <% end %>
    <% end %>
  </ul>
</section>

<script>
  window.onload = function(){
    $(function() {
      $("input[name='toggle']").click( function(){
        $.cookie('selected-item', $("input[name='toggle']:checked").attr('id'));
      });
      if( $.cookie('selected-item')) {
        $("input#"+$.cookie('selected-item')).attr('checked', 'checked');;
      }
    });
  }
</script>
