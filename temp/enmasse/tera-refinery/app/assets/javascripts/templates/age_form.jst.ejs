<div class="item-overlay verify-age">
  <h5>Please enter your birthday: (MM/DD/YYYY)</h5>
  <form>
    <div class="form-line">
      <input class='mm' type='text' name='mm' placeholder='mm' id='mm' />
      <div class="error-bottom" id="error-month" style="display: none;"><img src="/assets/tooltips-alert-top.png"><p>Please enter a valid<br />month (MM)</p><img src="/assets/tooltips-alert-bottom.png"></div>
      <input class='dd' type='text' name='dd' placeholder='dd' id='dd'/>
      <div class="error-bottom" id="error-day" style="display: none;"><img src="/assets/tooltips-alert-top.png"><p>Please enter a valid<br />day (DD)</p><img src="/assets/tooltips-alert-bottom.png"></div>
      <input class='yy' type='text' name='yyyy' placeholder='yyyy' id='yyyy'/>
      <div class="error-bottom" id="error-year" style="display: none;"><img src="/assets/tooltips-alert-top.png"><p>Please enter a valid<br />year (YYYY)</p><img src="/assets/tooltips-alert-bottom.png"></div>
    
      <input type='submit' value='GO' />
    </div> 
  </form>
  <hr class="small" />
</div>
