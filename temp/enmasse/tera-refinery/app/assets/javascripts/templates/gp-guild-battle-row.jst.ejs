<tr class='my-guild'>
  <td class='col-0'><%= rank %></td>
  <td class='col-1'><%= guild_name %></td>
  <td class='col-2'><%= server_name %></td>
  <td class='col-3'>
    <span class='tiptop-e'>
      <%= battle_wins + battle_losses + battle_draws %>
      <div class='tooltip'>
        <div style='min-width:300px'>
          <h3 class='text-align-left'><%= guild_name %></h3>
          <p class='text-align-left'><em><%= server_name %></em></p>
          <hr style='margin-top:-10px' />
          <p class='text-align-left'>
            Wins: <strong><%= battle_wins %></strong> <%= win_percentage %><br/>
            Losses: <strong><%= battle_losses %></strong> <%= loss_percentage %><br/>
            Draws: <strong><%= battle_draws %></strong> <%= draw_percentage %><br/>
            Total Points: <strong><%= battle_points || 0 %></strong>
          </p>
        </div>
      </div>
    </span>
  </td>
</tr>
