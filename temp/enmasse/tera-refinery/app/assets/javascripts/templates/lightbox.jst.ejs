<div class="lightbox-overlay"></div>
<div class="lightbox-container"> <!-- full width, vertically centered -->
  <div class="lightbox-popup"> <!-- fixed width, margin 0 auto -->
    <div class="lightbox-header"> <!-- fixed position, height and width -->
      <div id="lightbox-window-actions"><a href="#" class="lightbox-close">Close</a></div>
      <div id="lightbox-title">&nbsp;</div>
      <div class="cl"></div>
    </div>

    <div class="lightbox-body"> <!-- fixed position, height and width -->
      <a href="#" class="lightbox-prev"></a>
      <div class="lightbox-item-container"></div> <!-- margin 0 auto, defines height -->
      <a href="#" class="lightbox-next"></a>
    </div>

    <div class="lightbox-footer clearfix"> <!-- fixed position, height and width -->
      <a href="#" class="lightbox-prev">&lt; Prev</a>
      <a href="#" class="lightbox-download-link" target="_blank">download</a>
      <a href="#" class="lightbox-next">Next &gt;</a>
    </div>

  </div>
</div>
