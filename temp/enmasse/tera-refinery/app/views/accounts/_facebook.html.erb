<div id="fb-root"></div>
<script type="text/javascript">
  window.fbAsyncInit = function() {
    FB.init({
      appId  : "<%= AMS::API.settings[:facebook]['id'] %>",
      status : true,
      cookie : true,
      xfbml  : true,
      version: 'v2.3'
    });


    FB.getLoginStatus(function(response) {
      if (response.status === 'connected') {
        if (response.authResponse) {
          if (response.authResponse.userID) {
            $(".signup-facebook-btn").before("<div class='facebook-picture'><img src='//graph.facebook.com/v2.0/" + response.authResponse.userID + "/picture' /></div>");
          }
        }
      }
    }, true);

