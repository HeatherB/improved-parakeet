    var permissions = 'email,user_birthday,user_friends';
    $('.signup-facebook-link').click(function(e) {
      e.preventDefault();
      FB.login(function(response) {
        if (response.authResponse) {
          if (response.status === 'connected') {
            var data = {mode: 'signup', blackbox: $('#blackbox').val()};
            var mailing_lists = $(":checkbox").filter(function() { return this.name.match(/^mailing_list_\d+$/) });
            for (var i = 0; i < mailing_lists.length; i++) {
              if (mailing_lists[i].checked) {
                data[mailing_lists[i].name] = 1
              }
            }
            //console.log(data);
            $.ajax({
              type: "POST",
              url: "/auth/facebook/callback",
              data: data
            }).done(function(data) {
              //console.log('the data is ' + data);
              if (data.result == true) {
                window.location.href = "/activate";
              }
              else {
                window.location.href = "/error";
              }
            });
          }
        }
      }, { scope: permissions });
    });
  };

  // Load the facebook SDK asynchronously
  (function(d, s, id) {
    var js, fjs = d.getElementsByTagName(s)[0];
    if (d.getElementById(id)) return;
    js = d.createElement(s); js.id = id;
    js.src = "//connect.facebook.net/en_US/sdk.js";
    fjs.parentNode.insertBefore(js, fjs);
  }(document, 'script', 'facebook-jssdk'));

</script>