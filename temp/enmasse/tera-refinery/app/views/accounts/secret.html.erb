<!DOCTYPE html>
<%= render :partial => '/refinery/html_tag' %>
  <%= render :partial => '/refinery/head' %>
  <body class="tera secret">
    <%#= EMEGlobalAssets.snippet("eme-bar", {:create_link => "https://#{Rails.application.config.account_server}/tera/sign-up", :game => "TERA"}) %>
    <%= EMEGlobalAssets.snippet("eme-bar", {:create_link => "https://#{Rails.application.config.account_server}/tera/sign-up", :eme_bar => true, :games_menu => true, :alinks => true}) %>

    <%= render :partial => '/accounts/facebook' %>

    <div id="page-content">
      <div id="page_container">
        <a href="/" id="header-logo"></a>

          <div class="white-box">
            <h2>COMPLETING ACCOUNT ACTIVATION</h2>
            <h3>Please provide the following security information.</h3>
            <p>We’ll use this info to verify your identity when you call customer support, so please make sure this is something you can easily remember. As a security precaution, this information will not be visible through normal account settings.</p>

            <%= form_tag '/accounts', :id => "question" do %>

            <div id="ohnoerrors"></div>

              <p>SELECT A SECRET QUESTION</p>
              <div class="select-wrapper">
                <%= select_tag(:secret_question_id, 
                  options_for_select(@secret_questions.collect { |q| [q.question, q.id] }),
                  :prompt => "Select question"
                ) %>
              </div>

              <p>SECRET ANSWER</p>
              <div class="input-wrapper">
                <%= text_field_tag "secret_answer", nil, placeholder: "Make this answer hard to guess.", size: 300, maxlength: 300 %>
              </div>

              <input type="submit" id="save-secret" value="Save Changes">
            <% end %>
          </div>

      </div>
      <br /><br />
      <%= render :partial => '/shared/footer' %>
    </div>

    <%= render :partial => '/shared/footer_js' %>
  </body>
</html>
