    box-sizing: border-box;
    padding-left: 120px;
    padding-top:20px;
    min-height:117px;

    position: relative;
    overflow: hidden;
  }
  #highlights .highlights:before {
    content: "";
    position: absolute;
    width: 102%;
    height: 513%;
    top: 60%;
    left: -30%;
    z-index: -1;
    background: url(<%= asset_path "brawler/class/highlight-splat.png" %>) top left no-repeat;
    -webkit-transform: rotate(30deg);
    -moz-transform: rotate(30deg);
    -ms-transform: rotate(30deg);
    -o-transform: rotate(30deg);
    transform: rotate(30deg);
  }
  #highlights .highlights:nth-child(2):before {
    left: 0%;
    top: 0%;
    -webkit-transform: rotate(0deg);
    -moz-transform: rotate(0deg);
    -ms-transform: rotate(0deg);
    -o-transform: rotate(0deg);
    transform: rotate(0deg);
  }
  #highlights .highlights:nth-child(3):before {
    left: -80%;
    top: 4%;
    -webkit-transform: rotate(75deg);
    -moz-transform: rotate(75deg);
    -ms-transform: rotate(75deg);
    -o-transform: rotate(75deg);
    transform: rotate(75deg);
  }
  #highlights .highlights:nth-child(4):before {
    left: -15%;
    top: 41%;
    -webkit-transform: rotate(15deg);
    -moz-transform: rotate(15deg);
    -ms-transform: rotate(15deg);
    -o-transform: rotate(15deg);
    transform: rotate(15deg);
  }
  #highlights .highlights:nth-child(5):before {
    left: -101%;
    top: -309%;
    -webkit-transform: rotate(150deg);
    -moz-transform: rotate(150deg);
    -ms-transform: rotate(150deg);
    -o-transform: rotate(150deg);
    transform: rotate(150deg);
  }
  #highlights .highlights:nth-child(6):before {
    left: 0%;
    top: 0%;
    -webkit-transform: rotate(0deg);
    -moz-transform: rotate(0deg);
    -ms-transform: rotate(0deg);
    -o-transform: rotate(0deg);
    transform: rotate(0deg);
  }
