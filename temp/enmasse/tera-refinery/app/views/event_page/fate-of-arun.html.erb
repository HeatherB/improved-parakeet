        <area shape="poly" coords="449,129,466,85,453,52,420,53,416,35,422,14,384,18,376,27,355,21,326,42,310,37,304,54,290,79,288,90,283,101,284,113,274,132,277,141,291,146,314,138,333,133,349,142,372,134,388,144,401,125,405,116,424,113" href="#arx-umbra" alt="" id="arx-umbra"/>
