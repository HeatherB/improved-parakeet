<div class="main" id="secrets-and-shadows">
  <div class="hero">
    <div class="wrapper">
      <% if (Time.now < @launch) %>
      <a id="trailer" class="trailer" data-url="https://www.youtube.com/embed/7mxCcxcI7fI" href="#">
      </a>
      <h1>Coming May 17, 2016</h1>
      <% else %>
      <a id="trailer" class="trailer" data-url="https://www.youtube.com/embed/Q1tXA9P5LxY" href="#">
      </a>
      <h1 style="margin:15px 0 0 240px;">AVAILABLE NOW!</h1>
      <% end %>

    </div>
  </div><!-- end of hero -->

  <nav id="main-nav">
    <div class="wrapper">
      <ul class="nav-social">
        <li>SHARE</li>
        <li><a href="https://www.facebook.com/sharer/sharer.php?u=http://tera.enmasse.com/secrets-and-shadows" id="share-facebook" target="_blank">Facebook</a></li>
        <li><a class="twitter-share-button"
    href="https://twitter.com/intent/tweet?text=Secrets%20get%20revealed%20and%20ninjas%20emerge%20from%20shadows%20in%20TERA%20Secrets%20and%20Shadows%20update.%20Pass%20it%20along!%20http://tera.enmasse.com/secrets-and-shadows"id="share-twitter" target="_blank">Twitter</a></li>
      </ul>
      <ul class="nav-page">
        <li><a href="#aboutninja" id="nav-aboutninja">Ninja Class</a></li>
        <li class="notyet">
          <% if (Time.now > @reveal_first) %>
          <a href="#shadow" id="nav-shadow">
          <% end %>
            In The Shadow of Fate
            <% if (Time.now < @reveal_first) %>
            <span class="tobeDate">Reveals April 19</span>
            <% end %>
          <% if (Time.now > @reveal_first) %>
          </a>
          <% end %>
        </li>
        <li class="notyet">
          <% if (Time.now > @reveal_second) %>
          <a href="#factory" id="nav-factory">
          <% end %>
            New Dungeons
            <% if (Time.now < @reveal_second) %>
            <span class="tobeDate dungeon">Reveals April 26</span>
            <% end %>
          <% if (Time.now > @reveal_second) %>
          </a>
          <% end %>
        </li>
        <li class="notyet">
          <% if (Time.now > @reveal_third) %>
          <a href="#mounts" id="nav-mounts">
