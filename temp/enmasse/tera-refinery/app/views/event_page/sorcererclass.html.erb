    <div class="wrapper">
      <h1>Video Guide</h1>
      <a id="trailersorcerer" class="trailer" data-url="https://www.youtube.com/embed/l8KGO1BrICc" href="#"></a>
    </div><!-- end of wrapper -->
  </div><!-- end of guide -->


