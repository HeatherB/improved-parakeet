<tr data-campaign-id="<%= campaign_row.id %>">
  <td>
    <%= campaign_row.candidate.name %>
  </td>
  <td>
    <%= campaign_row.guild.name %>
  </td>
  <td><%= campaign_row.continent_name %></td>
  <td class="votes" style="background-position: <%= 100.0-campaign_row.vote_percentage.to_f %>% center;<%= "display:none;" if @election.state == :registrations %>"><%= campaign_row.vote_percentage %></td>
  <td>
    <%= render :partial => "campaign_info", :object => campaign_row %>
  </td>
  <td style="display:none;"><%= campaign_row.server.name %></td>
</tr>
