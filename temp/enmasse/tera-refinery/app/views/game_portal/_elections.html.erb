<div id="election-tabs" class="tabset">
  <a href="#" id="etab" class="selected tablink">Popular Vote</a> - <a href="#" id="btab" class="tablink">Guild Combat</a>
  <div id="election-tab" class="tab">
    <p>Top four per continent will rule as vanarch.</p>
    <table id="elections-table" class="sorttable election-table">
      <thead>
        <tr>
          <th width="250"><span class="sorttable-header">Candidate</span></th>
          <th width="250"><span class="sorttable-header">Guild</span></th>
          <th width="220"><span class="sorttable-header">Continent</span></th>
          <th <%= " style='display:none;'" if @election.state == :registration %> width="400"><span class="sorttable-header">Votes</span></th>
          <th width="230">Campaign Info</th>
          <th style="display: none;" width="1"></th>
        </tr>
      </thead>
      <tbody>
        <%= render :partial => "campaign_row", :collection => @campaigns.select{|c| !c.is_battle_campaign? } %>
      </tbody>
    </table>
  </div>
  <div id="battle-tab" class="tab" style="display:none">
  <p>The top guild per continent will rule as Vanarch</p>
    <table id="battles-table" class="sorttable leaderboard election-table">
      <thead>
        <tr>
          <th width="250"><span class="sorttable-header">Candidate</span></th>
          <th width="250"><span class="sorttable-header">Guild</span></th>
          <th width="220"><span class="sorttable-header">Continent</span></th>
          <th <%= " style='display:none;'" if @election_state == :registration %> width="400"><span class="sorttable-header">Points</span></th>
          <th width="230">Campaign Info</th>
          <th style="display: none;" width="1"></th>
        </tr> 
      </thead>
      <tbody>
        <%= render :partial => "campaign_row", :collection => @campaigns.select{|c| c.is_battle_campaign? } %>
      </tbody>
    </table>
  </div>
</div>
