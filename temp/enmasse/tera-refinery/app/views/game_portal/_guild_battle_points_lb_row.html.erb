<% rank = (@lastpoints == guild_battle_points_lb_row.battle_points) ? @lastrank : ( guild_battle_points_lb_row_counter + 1 ) %>
<tr class="rank-<%= rank %>">
  <td class="col-0"><%= guild_battle_points_lb_row.battle_points > 0 ? rank : "&#8212;" %></td>
  <td class="col-1"><%# <img width="32" height="32" src="/images/sample_guild_logo.png" /> %><%= guild_battle_points_lb_row.name %></td>
  <td class="col-2"><%= guild_battle_points_lb_row.server.name %></td>
  <td class="col-3">
    <span class="tiptop-e">
    <%= guild_battle_points_lb_row.battle_points %>
    <%= render :partial => 'guild_stats_tooltip', :object => guild_battle_points_lb_row %>
    </span>
  </td>
</tr>
<% @lastrank = rank %>
<% @lastpoints = guild_battle_points_lb_row.battle_points %>
