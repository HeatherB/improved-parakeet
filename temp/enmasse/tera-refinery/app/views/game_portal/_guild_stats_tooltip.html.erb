<div class="tooltip">
  <div style="min-width:300px">
  <h3 class="text-align-left"><%= guild_stats_tooltip.name %></h3>
  <p class="text-align-left"><em><%= guild_stats_tooltip.server.name %></em></p>
  <hr style="margin-top:-10px" />
  <p class="text-align-left">
    Wins: <strong><%= guild_stats_tooltip.battle_wins %></strong> [<%= guild_stats_tooltip.win_percentage %>]<br/>
    Losses: <strong><%= guild_stats_tooltip.battle_losses %></strong> [<%= guild_stats_tooltip.loss_percentage %>]<br/>
    Draws: <strong><%= guild_stats_tooltip.battle_draws %></strong> [<%= guild_stats_tooltip.draw_percentage %>]<br/>
    Total Points: <strong><%= guild_stats_tooltip.battle_points %></strong>
  </p>
  </div>
</div>
