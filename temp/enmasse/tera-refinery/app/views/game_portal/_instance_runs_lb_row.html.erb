<tr>
  <td class="col-0"><%= instance_runs_lb_row_counter + 1 %></td>
  <td class="col-1">
  <%= instance_runs_lb_row.completion_participants.collect { |p|
    "<span class='tool-tip-container'><span class='tool-tip-text'>#{p.name}</span><span class='tool-tip'>Server: #{p.server.name}<br/>Class: #{p.character_class}</span></span>"
  }.join("&nbsp;&nbsp;|&nbsp;&nbsp;").html_safe %>
  </td>
  <td class="col-2"><%= instance_runs_lb_row.server.name %></td>
  <td class="col-3"><%= instance_runs_lb_row.completion_seconds %></td>
</tr>
