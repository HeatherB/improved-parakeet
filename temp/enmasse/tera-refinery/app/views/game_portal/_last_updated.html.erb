<% added_message = nil unless defined?(added_message) %>
<div class="clearfix"></div>
<% if @last_updated_at %>
  <hr/>
  <h3 class="text-align-center">Updated <%= time_ago_in_words(@last_updated_at) %> ago</h3>
  <p class="text-align-center">Leaderboard updated daily<%= " #{added_message}" if added_message %>.</p>
<% end %>
