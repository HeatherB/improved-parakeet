<div id="election-tabs" class="tabset">
  <div id="election-tab" class="tab">
    <table id="elections-table" class="sorttable election-table">
      <thead>
        <tr>
          <th width="250"><span class="sorttable-header">Ruling Vanarch</span></th>
          <th width="250"><span class="sorttable-header">Guild</span></th>
          <th width="220"><span class="sorttable-header">Continent</span></th>
          <th style="display: none;" width="1"></th>
          <th width="220"><span class="sorttable-header">Region</span></th>
          <th style="display: none;" width="1"></th>
        </tr>
      </thead>
      <tbody>
        <%= render :partial => "vanarch_row", :collection => @vanarchs %>
      </tbody>
    </table>
  </div>
  <div id="battle-tab" class="tab" style="display:none">
    <table id="battles-table" class="sorttable leaderboard election-table">
      <thead>
        <tr>
          <th width="250"><span class="sorttable-header"></span></th>
          <th width="250"><span class="sorttable-header"></span></th>
          <th width="220"><span class="sorttable-header"></span></th>
          <th width="400"><span class="sorttable-header"></span></th>
          <th width="230"></th>
          <th style="display: none;" width="1"></th>
        </tr> 
      </thead>
      <tbody>
      </tbody>
    </table>
  </div>
</div>