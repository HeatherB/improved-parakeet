<% content_for :title, "TERA Leaderboards" %>
<section id="body_content">
  <h1 class="tera-leaderboards">TERA Leaderboards</h1>
  <section id="wide_body" class="data-index-body">
      <div class="inner">
        <h2 class="centered-header">Leaderboard Categories</h2>
        <div class="link-row">
          <div class="link-block">
            <h3>Vanarch Elections</h3>
            <ul class="dungeon-list" style="background-image: none;">
              <li><a href="/data/elections">Current election</a></li>
            </ul>
          </div>
          <div class="link-block">
            <h3>Guild Battles</h3>
            <ul class="dungeon-list">
              <li><a href="/data/leaderboards/guild-battles/wins">Most battles won</a></li>
              <li><a href="/data/leaderboards/guild-battles/battles">Most battles fought</a></li>
              <li><a href="/data/leaderboards/guild-battles/points">Most battle points earned</a></li>
            </ul>
          </div>
          <div class="link-block">
            <h3>Dungeons</h3>
            <ul class="dungeon-list">
              <% @dungeons.each do |dungeon| %>
                <li><a href="/data/leaderboards/dungeons/<%= dungeon.clean_name %>/completions"><%= dungeon.name %></a></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <div class="bottom-decor"></div>
  </section>
</section>
