<% content_for :title, "TERA Dungeon Run Leaderboard" %>
<section id="body_content">
  <h1 class="dungeon-rankings">Dungeon Rankings</h1>
  <section id="wide_body">
    <div class="inner">
      <div class="dungeon-backgrounds" id="instance-banner-<%= @current_dungeon.clean_name %>">
        <div class="breadcrumbs">
          <a href="/data">Leaderboards</a> &gt; Dungeons &gt; <%= @current_dungeon.name %> &gt; <%= @board.capitalize %>
        </div>
        <h2>Select Dungeon:</h2>
        <ul class="dungeon-list">
          <% @dungeons.each do |dungeon| %>
            <li id='<%= dungeon.clean_name %>'<%= " class='selected'" if @current_dungeon.clean_name == dungeon.clean_name %>>
              <a href="/data/leaderboards/dungeons/<%= dungeon.clean_name + "/#{@board}" %>"><%= dungeon.name %></a>
            </li>
          <% end %>
        </ul>
        <h2>Select Filter:</h2>
        <div class="clearfix">
          <ul id="instance-filters">
            <li id="top-100"><span id="top-100-title">Top 100</span></li>
            <li id="top-100-colon">:</li>
            <li id="times-completed" class="selected">Times Completed</li>
            <li id="legendary-items" class="tool-tip-container"><span class="tool-tip-text">Legendary Items</span><span class="tool-tip">Coming Soon!</span></li>
            <li id="fastest-run" class="tool-tip-container"><span class="tool-tip-text">Fastest Run</span><span class="tool-tip">Coming Soon!</span></li>
          </ul>
        </div>
      </div>
      <% if @message && @message.content_for("Wide Body") && !@message.content_for("Wide Body").blank? %>
        <%= raw @message.content_for("Wide Body") %>
        <hr />
      <% end %>
      <% @lastrank = 0; @lastcomps = (@runs.length > 0 ? (@runs[0].completions || 0) : 0) + 1 %>
      <table id="instance-run-leaderboard" class="leaderboard">
        <thead>
          <tr>
            <th width="50">Rank</th>
            <th width="350">Character</th>
            <th width="350">Server</th>
            <th width="64">Completions</th>
          </tr>
        </thead>
        <tbody>
          <tr id="my-stats" style="display:none;text-align:center;" ><td colspan=4><%= link_to('Log in', sign_in_uri) %> to view your stats here.</td></tr>
          <tr><td>&#x22EE;</td><td>&#x22EE;</td><td>&#x22EE;</td><td>&#x22EE;</td></tr>
          <%= render :partial => "most_instance_runs_lb_row", :collection => @runs %>
        </tbody>
      </table>
      <%= render :partial => "last_updated", :locals => {:added_message => "with data collected May 15, 2012–present" } %>
    </div>
    <div class="bottom-decor"></div>
  </section>
</section>

<script>
  $(function(){
    GamePortal.showMyDungeonRuns('<%= @current_dungeon.clean_name %>', '<%= @board %>');
  });
</script>
