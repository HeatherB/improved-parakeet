<!DOCTYPE html>
<%= render :partial => '/refinery/html_tag' %>
  <%= render :partial => '/refinery/head' %>
  <body class="tera">
    <%= EMEGlobalAssets.snippet("eme-bar", {:create_link => "https://#{Rails.application.config.account_server}/tera/sign-up", :eme_bar => true, :games_menu => true, :alinks => true}) %>
    
    <% alert = Refinery::Page.site_wide_alert %>
    <% if alert %>
      <div class="site-alert"><%= raw alert %></div>
    <% end %>
    
    <% if is_what_is_tera? %>
      <div id="page-content" class="what-is-tera">
    <% else %>
    <div id="page-content">
    <% end %>
      <header id="header" class="row">
        <%= render :partial => '/refinery/header' -%>
      </header>

      <% if is_home? %>
      <div id="home-video">
          
        </div>
        <div class="learn">
          <p><em>TERA</em> is a stunning fantasy MMO that features fast-paced action combat, a vast, gorgeous world, and highly customizable characters. Best of all, <em>TERA</em> is FREE to play!</p>
          <div class="play-now">
            <a href="/game-guide/what-is-tera" onclick="_gaq.push(['_trackEvent', 'Accounts', 'Clicked Learn More Button', 'TERA Homepage']);">LEARN MORE</a>
          </div>
        </div>
      <% end %>

      <% if is_what_is_tera? %>
        <div id="what-is-tera">
          <div class="wrapper">
          <%= render :partial => '/what_is_tera/what-is-tera' -%>
          </div><!-- end of wrapper -->
        </div><!-- end what is tera content -->
      <% end %>

      <div id="page_container">
        <% if Refinery::Pages.cache_blacklist.include?(@page.slug) && flash[:notice] %>
          <div class="success-alert"><span class="icon"></span><%= raw flash[:notice] %></div>
        <% end %>

        <%= yield %>

        <div class="twelve columns ankle">
          <div class="row">
            <div class="four columns">
              <h5><a href="/patch-notes">Patch Notes</a></h5>
              <p>Read about the latest <em>TERA</em> developments.</p>
            </div>

            <div class="four columns">
              <h5><a href="/game-guide">Game Guide</a></h5>
              <p>Learn about the world of <em>TERA</em>.</p>
            </div>

            <div class="four columns">
              <h5><a href="http://support.enmasse.com/tera">Support</a></h5>
              <p>Tell us where it hurts.</p>
            </div>
          </div>

          <div class="row">
            <div class="four columns">
              <h5><a href="/download">DOWNLOAD <i>TERA</i></a></h5>
            </div>

            <div class="four columns">
              <h5>Follow <em>TERA</em>!</h5>
              <ul class="social-links">
                <li><a class="fb" href="https://www.facebook.com/TERAonline">Facebook</a></li>
                <li><a class="twit" href="http://twitter.com/#!/TERAonline">Twitter</a></li>
                <li><a class="yt" href="http://www.youtube.com/user/enmasseentertainment">YouTube</a></li>
                <li><a class="twitch" href="http://www.twitch.tv/enmasseentertainment">Twitch</a></li>
              </ul>
            </div>

            <div class="four columns">
              <h5><a href="/server-status">Server Status</a></h5>
              <p>View server options and availability.</p>
            </div>
          </div>
        </div>

        <%= render :partial => '/shared/footer' %>
      </div>
    </div>
    <%= render :partial => '/shared/footer_js' %>
    <!-- <%= `hostname`.strip %> -->

  </body>
</html>



