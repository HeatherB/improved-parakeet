<!DOCTYPE html>
<%= render :partial => '/refinery/html_tag' %>
  <%= render :partial => '/refinery/head' %>
  <body>
    <%#= render :partial => '/shared/splash' if show_splash_page_partial -%>
    <%= render :partial => "/shared/alert_bar" %>
    <div class="clearfix"></div>
    <div id="page-content">
      <div id="leaderboard-container">
        <header id="header">
          <%= render :partial => '/refinery/header' -%>
        </header>
        <section id="leaderboard-page">
          <%= yield %>
        </section>
      </div>
    </div>
    <div id="page_container">
    <footer>
      <%= render :partial => '/refinery/footer' -%>
    </footer>
    </div>
    <%= render :partial => '/shared/footer_js' %>
    <!-- <%= `hostname`.strip %> -->
    <span class="loadtimestamp"></span>
  </body>
</html>
