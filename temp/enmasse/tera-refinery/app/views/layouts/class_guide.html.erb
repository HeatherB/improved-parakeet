<!DOCTYPE html>
<%= render :partial => '/refinery/html_tag' %>
<%= render :partial => '/refinery/head' %>

<link href='https://fonts.googleapis.com/css?family=Abel' rel='stylesheet' type='text/css'>
<script src="https://use.typekit.net/mgj2qqw.js"></script>
<script>try{Typekit.load({ async: true });}catch(e){}</script>

<% content_for :stylesheets do %>
<!--[if IE 8]>
  <style type="text/css">
    @font-face {
    font-family: 'Abel';
    src: url('/fonts/abel-regular-webfont.eot');
    src: url('/fonts/abel-regular-webfont.eot?#iefix') format('embedded-opentype'),
         url('/fonts/abel-regular-webfont.woff2') format('woff2'),
         url('/fonts/abel-regular-webfont.woff') format('woff'),
         url('/fonts/abel-regular-webfont.ttf') format('truetype'),
         url('/fonts/abel-regular-webfont.svg#abelregular') format('svg');
    font-weight: normal;
    font-style: normal;
  }
  </style>
<![endif]-->
  <style type="text/css">
  #eme-bar {
    z-index:9999;
  }
  #eme-bar .wrapper {
      min-width: 320px;
      margin: 0 auto;
      max-width: 100%;
      width: 100%;
      height:auto;
      overflow:visible;
  }
  </style>
<% end %>
  <body class="class_guide">
    <%= EMEGlobalAssets.snippet("eme-bar", {:create_link => "https://#{Rails.application.config.account_server}/tera/sign-up", :eme_bar => true, :games_menu => true, :alinks => true}) %>
    <%#= render :partial => '/shared/simple_eme_bar' %>
       <header id="header" class="row">
          <%= render :partial => '/refinery/header' -%>
        </header>

        <div class="page-frame">
            <% if Refinery::Pages.cache_blacklist.include?(@page.slug) && flash[:notice] %>
              <div class="success-alert"><span class="icon"></span><%= raw flash[:notice] %></div>
            <% end %>

            <!-- output individual section -->
            <% if @page.content_for(:article_header) %>
              <%= raw @page.content_for(:article_header) %>
            <% end %>

            <% if @page.content_for(:wide_body) %>
              <%= raw @page.content_for(:wide_body) %>
            <% end %>

            <% if @page.content_for(:body) %>
              <%= raw @page.content_for(:body) %>
            <% end %>

            <% if @page.content_for(:side_body) %>
              <%= raw @page.content_for(:side_body) %>
            <% end %>

            <% if @page.content_for(:article_footer) %>
              <%= raw @page.content_for(:article_footer) %>
            <% end %>
            <!-- end output individual sections -->

            <%#= yield %>


            <div id="lightbox" style="display:none;">
              <div id="lightbox-container">
                <div id="lightbox-content"></div>
                <a href="javascript:;" class="lightbox-close">x</a>
              </div>
            </div>

            <div class="twelve columns ankle">
              <div class="row">
                <div class="four columns">
                  <h5><a href="/patch-notes">Patch Notes</a></h5>
                  <p>Read about the latest <em>TERA</em> developments.</p>
                </div>

                <div class="four columns">
                  <h5><a href="/game-guide">Game Guide</a></h5>
                  <p>Learn about the world of <em>TERA</em>.</p>
                </div>

                <div class="four columns">
                  <h5><a href="http://support.enmasse.com/tera">Support</a></h5>
                  <p>Tell us where it hurts.</p>
                </div>
              </div>

              <div class="row">
                <div class="four columns">
                  <h5><a href="/download">DOWNLOAD <i>TERA</i></a></h5>
                </div>

                <div class="four columns">
                  <h5>Follow <em>TERA</em>!</h5>
                  <ul class="social-links">
                    <li><a class="fb" href="https://www.facebook.com/TERAonline">Facebook</a></li>
                    <li><a class="twit" href="http://twitter.com/#!/TERAonline">Twitter</a></li>
                    <li><a class="yt" href="http://www.youtube.com/user/enmasseentertainment">YouTube</a></li>
                    <li><a class="twitch" href="http://www.twitch.tv/enmasseentertainment">Twitch</a></li>
                  </ul>
                </div>

                <div class="four columns">
                  <h5><a href="/server-status">Server Status</a></h5>
                  <p>View server options and availability.</p>
                </div>
              </div>

          </div>
        </div><!-- end of page frame -->
     <div class="footer-wrapper">
      <%#= EMEGlobalAssets.snippet(:footer, :game => "TERA") %>
      <%= render :partial => '/shared/footer' %>
      <!--<footer id="footer" class="row">
        <%#= render :partial => '/refinery/footer' -%>
      </footer>-->
    </div>
    <%= render :partial => '/shared/footer_js' %>
    <%= javascript_include_tag 'classguide-app.js' %>
  <!--  <script type="text/javascript">
      var triggerGAEvent = function(action, label) {
        // If Google Analytics is configured, trigger an event
        // used like this - triggerGAEvent('Selected Category or Item', 'Hero top of Page');
        if (_gaq) {
          if (label != ' ') {
            _gaq.push(['_trackEvent', 'AVA web Store', action, label]);
          } else {
            _gaq.push(['_trackEvent', 'AVA web Store', action]);
          }
        }
      };
    </script> -->
    <!-- <%= `hostname`.strip %> -->
  </body>
</html>



