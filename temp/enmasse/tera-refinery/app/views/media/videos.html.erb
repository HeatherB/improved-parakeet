<% content_for :title do %>Videos<% end %>

<% content_for :stylesheets do %>
  <style type="text/css">
    /***** Lightbox *****/
      #lb-blackout {
        position: fixed;
        top: 0;
        right: 0;
        left: 0;
        bottom: 0;
        z-index: 200;
        background: #000;
        background: rgba(0, 0, 0, 0.9);
      }
      #lightbox {
        position: absolute;
        left: 0;
        z-index: 9005;
        width: 100%;
        top: 150px;
      }
      #lightbox-container {
        width: 640px;
        padding: 8px;
        position: relative;
        margin: 0 auto;
      }
      #lightbox-container.video {
        background: none;
      }
      #lightbox-container.video .lightbox-close{
        top: -18px;
        right: -18px;
      }
      #lightbox-content {
        box-shadow: 0px 0px 10px 5px #ff9d34;
        border: 1px solid  #ff9d34;
      }
      .lightbox-close {
        width: 29px;
        height: 29px;
        position: absolute;
        top: 15px;
        right: 15px;
        background: url("/assets/foa/foa-lightbox-sprite.png") no-repeat -597px 0px;
      }
      .lightbox-close:hover {
        background-position: -597px -29px;
      }
      .lightbox-close:active {
        background-position: -597px -58px;
      }

    @-ms-keyframes spin {
        from { -ms-transform: rotate(0deg); }
        to { -ms-transform: rotate(360deg); }
    }
    @-moz-keyframes spin {
        from { -moz-transform: rotate(0deg); }
        to { -moz-transform: rotate(360deg); }
    }
    @-webkit-keyframes spin {
        from { -webkit-transform: rotate(0deg); }
        to { -webkit-transform: rotate(360deg); }
    }
    @keyframes spin {
        from {
            transform:rotate(0deg);
        }
        to {
            transform:rotate(360deg);
        }
    }

    .media #page_container { padding-bottom: 0; }
    .media [class*="column"] + [class*="column"]:last-child { float: left; }

    .media .video-thumb {
      position: relative;
      margin-bottom: 32px;
    }
    .media .video-thumb a {
      display: block;
      position: relative;
      width: 320px;
      height: 180px;
      margin: 10px auto 0;
    }
    .media .video-thumb a:before {
      content: "";
      position: absolute;
      top: 0; left: 0;
      width: 320px; height: 180px;
      background: black;

      opacity: 0.2;
      transition: opacity .25s ease-in-out;
      -moz-transition: opacity .25s ease-in-out;
      -webkit-transition: opacity .25s ease-in-out;
    }
    .media .video-thumb a .spinner {
      position: absolute;
      left: 50%;
      top: 50%;
      margin-left: -37px;
      margin-top: -33px;

      background: url('/assets/circle.png');
      width: 75px;
      height: 75px;

      opacity: 0.5;
      transition: opacity .25s ease-in-out;
      -moz-transition: opacity .25s ease-in-out;
      -webkit-transition: opacity .25s ease-in-out;
    }
    .media .video-thumb a .spinner:after {
      content: "";
      width: 75px;
      height: 75px;
      position: absolute;
      top: 0; left: 0;
      -webkit-animation-name: spin;
      -webkit-animation-duration: 20000ms;
      -webkit-animation-iteration-count: infinite;
      -webkit-animation-timing-function: linear;
      -moz-animation-name: spin;
      -moz-animation-duration: 20000ms;
      -moz-animation-iteration-count: infinite;
      -moz-animation-timing-function: linear;
      -ms-animation-name: spin;
      -ms-animation-duration: 20000ms;
      -ms-animation-iteration-count: infinite;
      -ms-animation-timing-function: linear;
      animation-name: spin;
      animation-duration: 20000ms;
      animation-iteration-count: infinite;
      animation-timing-function: linear;
      background: url('/assets/spinner.png');
      opacity: 0;
      transition: opacity .25s ease-in-out;
      -moz-transition: opacity .25s ease-in-out;
      -webkit-transition: opacity .25s ease-in-out;
    }
    .media .video-thumb a .play {
      position: absolute;
      left: 50%;
      top: 50%;
      margin-left: -6px;
      margin-top: -8px;
      width: 0; 
      height: 0; 
      border: solid 12px;
      border-color: transparent transparent transparent white;
      border-left: solid 20px white;
    }
    .media .video-thumb a .caption {
      position: absolute;
      bottom: -32px;
      width: 320px;
      height: 32px;
      background: black;
      border-bottom: 1px solid black;
    }
    .media .video-thumb a .caption:after {
      content: "";
      position: absolute;
      bottom: 0;
      width: 320px;
      height: 32px;
      background: url(data:image/svg+xml;base64,);
      background: -moz-linear-gradient(top,  rgba(125,185,232,0) 0%, rgba(119,162,214,0) 27%, rgba(102,100,165,0.15) 100%); /* FF3.6+ */
      background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,rgba(125,185,232,0)), color-stop(27%,rgba(119,162,214,0)), color-stop(100%,rgba(102,100,165,0.15))); /* Chrome,Safari4+ */
      background: -webkit-linear-gradient(top,  rgba(125,185,232,0) 0%,rgba(119,162,214,0) 27%,rgba(102,100,165,0.15) 100%); /* Chrome10+,Safari5.1+ */
      background: -o-linear-gradient(top,  rgba(125,185,232,0) 0%,rgba(119,162,214,0) 27%,rgba(102,100,165,0.15) 100%); /* Opera 11.10+ */
      background: -ms-linear-gradient(top,  rgba(125,185,232,0) 0%,rgba(119,162,214,0) 27%,rgba(102,100,165,0.15) 100%); /* IE10+ */
      background: linear-gradient(to bottom,  rgba(125,185,232,0) 0%,rgba(119,162,214,0) 27%,rgba(102,100,165,0.15) 100%); /* W3C */
      filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#007db9e8', endColorstr='#266664a5',GradientType=0 ); /* IE6-8 */
    }
    .media .video-thumb a .caption p {
      display: table-cell;
      vertical-align: middle;
      width: 320px;
      height: 32px;
      text-align: center;
      color: #BBBBBB;
      font-weight: bold;
      background: url("/assets/title-filigree.png") no-repeat top center;
    }
    .media .video-thumb a:hover:before { opacity: 0; }
    .media .video-thumb a:hover .spinner { opacity: 1; }
    .media .video-thumb a:hover .spinner:after { opacity: 1; }
  </style>
<% end %>


<section class="row" id="wide_body">

  <div class="twelve columns media">
    <h1 class="text-align-center">Videos</h1>

    <% @videos.each do | video | %>

      <div class="video-thumb four columns" data-video-width="<%= video["snippet"]["resourceId"]["videoId"] %>" data-video-height="">
        <a href="<%= video["snippet"]["resourceId"]["videoId"] %>">
          <img src="<%= video["snippet"]["thumbnails"]["medium"]["url"] %>">
          <div class="spinner"></div>
          <div class="play"></div>
          <div class="caption"><p><%= video["snippet"]["title"] %> (<%= video["snippet"]["duration"] %>)</p></div>
        </a>
      </div>

    <% end %>

  </div>

</section>
