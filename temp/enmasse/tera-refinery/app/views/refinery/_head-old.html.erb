<head>
  <% cache("head/#{params[:controller] || controller.controller_name}/#{params[:action] || controller.action_name}/#{params[:path] || params[:id] || params[:page] || 1}") do %>
    <%= raw @page.top_of_head_code if @page && !@page.top_of_head_code.blank? %>
    <meta charset='<%= Rails.application.config.encoding %>' />
    <!--[if IE]><meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" /><![endif]-->
    <title><%= browser_title(yield(:title)) %></title>
    <%= raw(%(<meta name="description" content="#{@meta.meta_description}" />)) if @meta.meta_description.present? -%>
    <%= raw(%(<meta name="keywords" content="#{@meta.meta_keywords}">)) if @meta.meta_keywords.present? -%>
    <%= raw(%(<link rel="canonical" content="#{@canonical}" />)) if @canonical.present? -%>
    <%#= yield :meta %>
    
    <%#= stylesheet_link_tag "application", "formatting", "theme" %>
    <link rel="shortcut icon" href="/favicon.ico">
    <%= stylesheet_link_tag "home" if home_page? %>
    <!--[if IE]><link href="/ie.css" rel="stylesheet" type="text/css" ><![endif]-->
    <%= yield :stylesheets %>
    
    <%# DEBUG: [ local_request? ] request.remote_ip is NOT 127.0.0.1 in production, but on the root page in a cache block it is. %>
    <!-- <%= request.remote_ip.inspect %> -->
    <%#= render :partial => '/refinery/google_analytics' %>
    <%= javascript_include_tag 'modernizr-min' %>
  <% end %>
  <%= csrf_meta_tags if ::Refinery::Setting.find_or_set(:authenticity_token_on_frontend, true)-%>
  <%= render :partial => '/refinery/google_analytics' %>
</head>
