<% flash.each do |key, value| %>
 <div id='flash' class="flash flash_<%= key %>">
   <%= value %>
 </div>
<% end %>
<div class="blog_post">
  <header>
    <h1><%= @post.title %></h1>
    <span class="small-text details">
      <time datetime="<%=l @post.published_at.to_date, :format => "%b %d, %Y" %>" class='posted_at'><%= t('created_at', :scope => 'refinery.blog.shared.posts', :when => l(@post.published_at.to_date, :format => "%b. %e, %Y")) %></time>
    <%= " by #{@post.author.username.capitalize}" if @post.author.present? %>
    </span>
    <% if (categories = @post.categories).any? %>
      <aside class='filed_in'>
        <%= t('filed_in', :scope => 'refinery.blog.posts.show') %>
        <% categories.each_with_index do |category, index| %>
          <%= link_to category.title, refinery.blog_category_path(category) -%><%= ',' if index < ((categories.length) - 1) %>
        <% end %>
      </aside>
    <% end %>
  </header>
  <p><%= @post.body.html_safe %></p>
  <%= render 'shared/gallery', :items => @post.images %>
  <% if Refinery::Blog::Post::ShareThis.enabled? %>
    <span class="st_sharethis" displayText="ShareThis"></span>
  <% end %>
</div>
<%= render :partial => '/refinery/draft_page_message' unless @post.nil? or @post.live? -%>
<%= render 'nav' if next_or_previous?(@post) %>
