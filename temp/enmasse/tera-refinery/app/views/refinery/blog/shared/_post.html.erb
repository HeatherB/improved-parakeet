<% if post.live? %>
  <% cache("blog_post_preview_#{post.id}") do %>
    <article class="twelve columns blog_post" id="<%= dom_id(post) %>">
      <header>
        <h2><%= link_to post.title, refinery.blog_post_path(post) %></h2>
        <span class="small-text details">
          <time datetime="<%=l post.published_at.to_date, :format => "%b %d, %Y" %>" class='posted_at'><%= t('created_at', :scope => 'refinery.blog.shared.posts', :when => l(post.published_at.to_date, :format => "%b. %e, %Y")) %></time><%= " by #{post.author.username.capitalize}" if post.author.present? %>
        </span>
      </header>
      <section>
        <% if blog_post_teaser_enabled? %>
          <%= blog_post_teaser(post) %>
        <% else %>
          <%= post.body.html_safe %>
        <% end %>
          <%= link_to(t('read_more', :scope => 'refinery.blog.shared.posts'), refinery.blog_post_path(post), :class => 'readmore-link') if blog_post_teaser_enabled?  %>
        <%= render 'shared/gallery', :items => post.images %>
      </section>
      <footer>

        <%#  Tags

          <% if (tags = post.tags).any? % >
            <span class='tagged'>
              <%= t('tagged', :scope => 'refinery.blog.posts.show') % >
              <%=raw tags.collect { |tag| link_to tag, refinery.blog_tagged_posts_path(tag.id, tag.name.parameterize) }.to_sentence % >
            </span>
          <% end % >

        Categories

        <% if (categories = post.categories).any? % > 
            <aside class='filed_in'>
              <%= t('filed_in', :scope => 'refinery.blog.posts.show') % >
              <%=raw categories.collect { |category| link_to category.title, refinery.blog_category_path(category) }.to_sentence % >
            </aside>
          <% end % >

          Comments
        
        <aside class='comment_count'>
          <% if Refinery::Blog::Post.comments_allowed? % >
            <% if post.comments.any? % >
               (<%= pluralize(post.comments.approved.count, t('singular', :scope => 'refinery.blog.shared.comments')) % >)
            <% else % >
                  (<%= t('none', :scope => 'refinery.blog.shared.comments') % >)
            <% end % >
          <% end % >

        </aside>
        %>
      </footer>
    </article>
  <% end %>
<% end %>
