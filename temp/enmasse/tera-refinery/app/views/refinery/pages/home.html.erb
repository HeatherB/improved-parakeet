<% cache("home-page") do %>
  <% if @page.content_for("Article Header") %>
    <section class="article_header row">
      <%= raw @page.content_for("Article Header") %>
    </section>
  <% end %>

  <% content_for :body_content_left do %>
    <% if @page.content_for(:body) %>
      <div class="sticky">
        <%= raw @page.content_for(:body) %>
      </div>
    <% end %>

    <% if @posts.any? %>
      <div class="blog-teasers">
        <%= render :partial => "/refinery/blog/shared/post", :collection => @posts %>
      </div>
    <% else %>
      <p><%= t('.no_blog_articles_yet') %></p>
    <% end %>
    <a href="/news" class="more-news">More News</a>
  <% end %>

  <% content_for :body_content_right_prepend do -%>
    <%= raw @page.content_for(:side_body) %>
  <% end if ::Refinery::Pages.config.default_parts.many? -%>
  <%= render :partial => '/refinery/blog/shared/body_content_right' %>

  <section class="split_body row">
    <%= render "/refinery/content_page", :sections => [{:yield => :body_content_left}, {:yield => :body_content_right}] %>
  </section>

  <div class="row">
    <div class="home-play-now play-now">
      <a href="/sign-up" onclick="_gaq.push(['_trackEvent', 'Accounts', 'Clicked Play Free Button lower', 'TERA Homepage']);">PLAY FREE</a>
    </div>
  </div>
<% end %>
