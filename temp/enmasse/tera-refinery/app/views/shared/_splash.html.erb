<% if splash_page %>
<div class="full-page-cover" id="full-splash" style="display:none">
  loading...
</div>
<% end %>

<div class="full-page-cover" id="full-age-gate" style="display:none">
  <% if age_gate_page %>
  <div id="age-gate-sheet">
  <%= raw age_gate_page.content_for(:wide_body) %>
  </div>
  <% end %>
</div>

<script>
  <% if !splash_page %>
  var showSplash = "disabled";
  <% end %>

  // syncroniuosly show the age-gate/splash pages if needed.
  $('#full-age-gate').show();
  
  <% if splash_page %>
    Splash.current = '<%= @splash_page.published_at.to_i %>';
  <% end %>
  var showAgeGate, showSplash;
  showAgeGate = (showAgeGate || Splash.showAgeGateCalc());
  showSplash = (showSplash || Splash.showSplashCalc());
  
  if(showAgeGate === 'disabled') {
    showAgeGate = false;
  }
  if(showSplash === 'disabled') {
    showSplash = false;
  }
  
  if (showSplash) {  //start loading ASYNC ASAP.
    $('#full-splash').load('/splash/splash');
    $('#full-splash a').live('click', function(){
      Splash.setSplashCookie();
    });
  }
  
  if (showAgeGate) {
    $('.age-gate-form form').submit(function (e) {
      e.preventDefault();
      Splash.checkAge($(this));
    });
    $('#age-gate-sheet').show();
  } else {
    if (showSplash) {
      Splash.showSplashPage();
    }
    $('#full-age-gate').hide();
  }
  
  $(function (){
    Splash.turnKey('splash-ready');
  });
  
  // to disable the splash, put this in top_of_head on the page.
  // [script]var showSplash = 'disabled';[/script]
  // to disable the age_gate, put this in top_of_head on the page.
  // [script]var showAgeGate = 'disabled';[/script]
</script>
