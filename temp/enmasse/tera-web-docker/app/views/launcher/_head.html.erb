<head>
<% cache("head/#{params[:controller] || controller.controller_name}/#{params[:action] || controller.action_name}/#{params[:path] || params[:id] || params[:page] || 1}") do %>
  <%= raw @page.top_of_head_code if @page && !@page.top_of_head_code.blank? %>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <title>Welcome To Tera</title>
  <link href='https://fonts.googleapis.com/css?family=Noto+Sans:400,700' rel='stylesheet' type='text/css'>
<% end %>
<% if content_for?(:custom_styles) %>
<%= yield(:custom_styles) %>
<% end %>
</head>