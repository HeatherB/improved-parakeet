<div id="class-info">
  <div id="gunner-icon"></div>
  <h2>Gunner</h2>
  <p>Role: Ranged Burst DPS. Gunners can take out enemies from anywhere on the battlefield, and have powerful alpha strikes.</p>
</div>
<% if @level <= 29 %>
  <div id="skills">
    <div class="skill">
      <span class="icon arcane-barrage"></span>
      <p>Arcane Barrage</p>
      <p>Unleash an energy pulse that damages all enemies in a line—then detonate it.</p>
    </div>
    <div class="skill">
      <span class="icon mana-missiles"></span>
      <p>Mana Missiles</p>
      <p>Shoot a pair of wildly weaving missiles that explode on contact.</p>
    </div>
    <div class="skill">
      <span class="icon replenishment"></span>
      <p>Replenishment</p>
      <p>Replenish your MP and Willpower.</p>
    </div>
    <div class="skill">
      <span class="icon burst-fire"></span>
      <p>Burst Fire</p>
      <p>Fire a penetrating bolt affecting up to three enemies in a row. You can also fire continuously...if you have enough Willpower.</p>
    </div>
  </div>
<% else %>
  <div id="crystals">
    <div class="pve">
      <h3>PvE Crystals</h3>
      <ul>
        <li class="red-crystal">Swift, savage, carving</li>
        <li class="blue-crystal">Hardy</li>
        <li class="green-crystal">Carving, Powerful</li>
      </ul>
    </div>
    <div class="pvp">
      <h3>PvP Crystals</h3>
      <ul>
        <li class="red-crystal">Savage, forceful, salivating, carving</li>
        <li class="blue-crystal">Relentless</li>
        <li class="green-crystal">Griefing, carving, Powerful</li>
      </ul>
    </div>
  </div>
<% end %>