<div id="class-info">
  <div id="mystic-icon"></div>
  <h2>Mystic</h2>
  <p>Role: Support healer. Mystics use a combination of skills, buffs, and auras, as well as summoned thralls.</p>
</div>
<% if @level <= 29 %>
  <div id="skills">
    <div class="skill">
      <span class="icon mana-infusion"></span>
      <p>Mana Infusion</p>
      <p>Replenishes your mana for several seconds.</p>
    </div>
    <div class="skill">
      <span class="icon thrall-of-protection"></span>
      <p>Thrall of Protection</p>
      <p>Summon a Thrall of Protection that draws aggro from monsters and makes melee attacks.</p>
    </div>
    <div class="skill">
      <span class="icon teleport-jaunt"></span>
      <p>Teleport Jaunt</p>
      <p>Teleport a short distance in the direction the camera faces.</p>
    </div>
    <div class="skill">
      <span class="icon Thrall-of-life"></span>
      <p>Thrall of Life</p>
      <p>Summon a Thrall of Life that heals you and removes harmful effects.</p>
    </div>
  </div>
<% else %>
  <div id="crystals">
    <div class="pve">
      <h3>PvE Crystals</h3>
      <ul>
        <li class="red-crystal">Swift, brilliant, carving</li>
        <li class="blue-crystal">Hardy, poised</li>
        <li class="green-crystal">Succoring, grounding</li>
      </ul>
    </div>
    <div class="pvp">
      <h3>PvP Crystals</h3>
      <ul>
        <li class="red-crystal">Swift, brilliant, carving</li>
        <li class="blue-crystal">Relentless, grieving</li>
        <li class="green-crystal">Indomitable</li>
      </ul>
    </div>
  </div>
<% end %>