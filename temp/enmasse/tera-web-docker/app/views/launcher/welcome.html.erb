<% content_for :custom_styles do %>
<style type="text/css">
  body, h1, em, span {
    padding: 0;
    margin: 0;
    font-style: normal;
    font-family: 'Noto Sans', sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1em;
  }
  body {
    background: #000 url(https://eme04.enmasse-game.com/images/tera/welcome/welcome_bg-2.jpg) no-repeat -4px -35px;
    color: #fff;
    font-size: 14px;
  }
  a {
    color: #0297ff;
    position: relative;
  }

  #welcome {
    width: 968px;
    height: 540px;
    overflow: hidden;
    position: relative;
  }
  #guides li {
    width: 500px;
    clear:left;
    height: 48px;
    padding-left: 35px;
    position: relative;
    display: table;

  }
  #guides li.half {
    height:20px;
  }
  #guides li span {
    display: table-cell;
    vertical-align: middle;
    padding-left: 10px;
    text-align: left;
    width: 452px;
    line-height: 1.4em;
  }
  #guides li em {
    font-style: italic;
  }
  #guides {
    list-style: none;
    margin: 25px 0 0 3px;
  }
  #guides li:before {
    background: url(https://eme04.enmasse-game.com/images/tera/welcome/tera_welcome_sprite_3.png) no-repeat 0 0;
    display: inline-block;
    width: 48px;
    height: 48px;
    content: "";
  }
  #guides li.alliance:before {
    background-position: -96px 0px;
    display: none;
  }
  #guides li.nexus:before {
    background-position: -48px 0px;
  }
  #guides li.guide:before {
    background-position: 0px 0px;
  }
  #guides li.half:before {
    display: none;
  }
  h1 {
    padding: 5px 0 0 84px;
    font-size: 28px;
    color: #dfa013;
    
    line-height: 1.1em;
  }
  h1 strong {
    background: -webkit-linear-gradient(#fff, #fff, #a5a5a5);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: 28px;
    z-index: 1;
  }
  h1 strong:before {
    content: attr(charName);
     color: #000;
     text-shadow: 0 2px rgba(0, 0, 0, 0.6);
     position: absolute;
     z-index: -1;
  }
  h1 span {
    display: block;
    font-size: 21px;
    color: #dfa013;
  }
  h1 span, h1 em {
    text-shadow: 0 2px rgba(0, 0, 0, 0.6);
  }
  h1 em {
    padding-left: 2px;
  }
  #gumballs {
    margin: 10px 30px 0 30px;
    position: absolute;
    bottom: 20px;
    width: 940px;
  }
  #gumballs div {
    display: inline-block;
  }
  #gumballs .gumball-left,
  #gumballs .gumball-center {
    border: 2px solid #3d3d3d;
    margin-right: 4px;
    height: 244px;
  }

  .gumball-elite {
    position: absolute;
    bottom: -1px;
    right: -1px;
  }
  #gumballs img {
    background: #000;
    padding: 1px;
  }
  #gumballs .gumball-elite img {
    background: transparent;
    position: absolute;
    bottom: 0;
    right: 0;
  }
  #class-info {
    position: relative;
    margin: 55px 0px 0px 79px;
    width: 540px;
  }
  #class-info h2 {
    font-size: 36px;
    background: -webkit-linear-gradient(#fff, #fff, #a5a5a5);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 36px;
    margin: 0px 0px 0px 0px;
    padding: 0px 0px 0px 0px;
  }
  #class-info p {
    line-height: 1.3em;
    margin: 7px 0px 0px 3px;
  }
  /* Class Icons */
    #gunner-icon, 
    #lancer-icon, 
    #berserker-icon, 
    #warrior-icon, 
    #slayer-icon, 
    #archer-icon, 
    #sorcerer-icon, 
    #reaper-icon, 
    #priest-icon, 
    #mystic-icon, 
    #brawler-icon,
    #ninja-icon,
    #valkyrie-icon {
      position: absolute;
      background: url(https://eme04.enmasse-game.com/images/tera/welcome/tera_welcome_sprite_3.png) no-repeat -150px 0;
      top: 0px;
      left: -72px;
      width: 69px;
      height: 69px;
    }
    #gunner-icon {background-position: -150px 0}
    #lancer-icon {background-position: -219px 0;width: 72px;height: 70px;left: -76px;}
    #berserker-icon {background-position: -293px 0;width: 65px;height: 70px;top: 3px;left: -70px;}
    #warrior-icon {background-position: -365px 0;width: 71px;height: 72px;left: -75px;top: 5px;}
    #slayer-icon {background-position: -436px 0;width: 64px;height: 72px;left: -70px;top: 0px;}
    #archer-icon {background-position: -500px 0;width: 65px;height: 69px;left: -70px;top: 3px;}
    #sorcerer-icon {background-position: -565px 0;width: 72px;height: 72px;left: -74px;top: 3px;}
    #reaper-icon {background-position: -637px 0;width: 76px;height: 72px;left: -76px;top: 3px;}
    #priest-icon {background-position: -713px 0;width: 66px;height: 75px;left: -72px;top: 0px;}
    #mystic-icon {background-position: -780px 0;width: 63px;height: 69px;left: -70px;top: 0px;}
    #brawler-icon {background-position: -848px 0;width: 63px;height: 69px;left: -70px;top: 0px;}
    #ninja-icon {background-position: -914px 0;width: 70px;height: 69px;left: -70px;top: 0px;}
    #valkyrie-icon {background-position: -978px 0;width: 70px;height: 70px;left: -70px;top: -4px;}
  /* Crystal */
    #crystals {
      padding-top: 1px;
      width: 100%;
      margin: 2px 0px 0px 82px;
    }
    #crystals h3 {
      font-size: 20px;
      font-weight: normal;
    }
    #crystals ul, #crystals li {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    #crystals li {
      font-size: 12px;
      font-style: italic;
      height: 38px;
      padding-left: 32px;
      padding-top: 10px;
      position: relative;
    }

    #crystals li:before {
      position: absolute;
      z-index: 2;
      left: -4px;
      top: 0px;
      content: "";
      background: url(https://eme04.enmasse-game.com/images/tera/welcome/tera_welcome_sprite_3.png) no-repeat 0 -72px;
      width: 33px;
      height: 37px;
    }
    #crystals li.blue-crystal:before { background-position: -33px -72px; }
    #crystals li.green-crystal:before { background-position: -66px -72px; }
    #crystals .pve {
      width: 245px;
      display: inline-block;
    }
    #crystals .pvp {
      width: 245px;
      display: inline-block;
    }
  /* Skills */
    #skills {
      padding-top: 1px;
      margin: 25px 0px 0px 82px;
      width: 560px;
    }
    #skills .skill {
      position: relative;
      padding: 0 5px 0 50px;
      width: 225px;
      height: 90px;
      float: left;
    }
    #skills p { margin: 0 0 0.5em; }
    #skills .icon {
      position: absolute;
      left: 0;
      display: block;
      width: 42px;
      height: 42px;
      background: url(https://eme04.enmasse-game.com/images/tera/welcome/tera_welcome_sprite_3.png) no-repeat 0 -109px;
    }
    /* Gunner */
    #skills .icon.arcane-barrage { background-position: 0 -109px }
    #skills .icon.mana-missiles { background-position: -42px -109px }
    #skills .icon.replenishment { background-position: -84px -109px }
    #skills .icon.burst-fire { background-position: -126px -109px }
    /* Lancer */
    #skills .icon.stand-fast { background-position: -168px -109px }
    #skills .icon.shield-barrage { background-position: -210px -109px }
    #skills .icon.spring-attack { background-position: -252px -109px }
    #skills .icon.leash { background-position: -294px -109px }
    /* Slayer */
    #skills .icon.evasive-roll { background-position: -336px -109px }
    #skills .icon.whirlwind { background-position: -378px -109px }
    #skills .icon.knockdown-strike { background-position: -420px -109px }
    #skills .icon.overhand-strike { background-position: -462px -109px }
    /* Sorcerer */
    #skills .icon.magma-bomb { background-position: -504px -109px }
    #skills .icon.time-gyre { background-position: -546px -109px }
    #skills .icon.teleport-jaunt { background-position: -588px -109px }
    #skills .icon.fireblast { background-position: -630px -109px }
    /* Priest */
    #skills .icon.backstep { background-position: -672px -109px }
    #skills .icon.focus-heal { background-position: -714px -109px }
    #skills .icon.purifying-circle { background-position: -756px -109px }
    #skills .icon.healing-circle { background-position: -798px -109px }
    /* Berserker */
    #skills .icon.axe-block { background-position: 0 -153px }
    #skills .icon.cyclone { background-position: -42px -153px }
    #skills .icon.thunder-strike { background-position: -84px -153px }
    #skills .icon.vampiric-blow { background-position: -126px -153px }
    /* Warrior */
    #skills .icon.rain-of-blows { background-position: -168px -153px }
    #skills .icon.combative-strike { background-position: -210px -153px }
    #skills .icon.traverse-cut { background-position: -252px -153px }
    /* Archer */
    #skills .icon.penetrating-arrow { background-position: -294px -153px }
    #skills .icon.radiant-arrow { background-position: -336px -153px }
    #skills .icon.stunning-trap { background-position: -378px -153px }
    /* Mystic */
    #skills .icon.mana-infusion { background-position: -420px -153px }
    #skills .icon.thrall-of-protection { background-position: -462px -153px }
    #skills .icon.thrall-of-life { background-position: -504 -153px }
    /* Brawler */
    #skills .icon.punch-counter { background-position: -546px -153px }
    #skills .icon.haymaker { background-position: -588px -153px }
    #skills .icon.bull-rush { background-position: -630px -153px }
    #skills .icon.rampage { background-position: -672px -153px }
    /* Ninja */
    #skills .icon.decoy-jutsu {background-position: -714px -153px}
    #skills .icon.jagged-path {background-position: -756px -153px}
    #skills .icon.one-thousand-cuts {background-position: -798px -153px}
    #skills .icon.circle-of-steel {background-position: -840px -153px}
    /* Valkyrie */
    #skills .icon.leaping-slash {background-position: -839px -109px}
    #skills .icon.glaive-strike {background-position: -882px -109px;}
    #skills .icon.dream-slash {background-position: -882px -153px;}
</style>
<% end %>

