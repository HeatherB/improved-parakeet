<div id="welcome">
  <div id="player-info">
    <h1><span>Welcome,</span> <strong><%= (@character && @character["character"]) ? @character["character"]["name"] : "Player" %></strong><em>!</em></h1>
  </div>
  <ul id="guides">
    <!--<li class="alliance"><span></span></li>-->
    <li class="half"><span></span></li>
    <li class="guide">
      <span>
        <% @level = @character["character"]["level"].to_i if (@character && @character["character"]) %>
        <% if @level && @level > 1 %>
          You've reached level <%= @level %>!<br>
          <% if @level >= 2 && @level <= 19 %>
            Get started with the basic game guides at <b>tera.enmasse.com</b>.
          <% elsif @level >= 20 && @level <= 24 %>
            Remember to select glyphs in the skill window!
          <% elsif @level >= 25 && @level <= 29 %>
            Sinestral Manor has a new Lord and Lady&mdash;or more accurately, some very old ones!
          <% elsif @level >= 30 && @level <= 34 %>
            Check out the Iron Battleground!
          <% elsif @level >= 35 && @level <= 40 %>
            Bhaozurbas is waiting for you in the Cultist&#8217;s Refuge.
          <% elsif @level >= 41 && @level <= 45 %>
            Dig up the secrets of the Necromancer&#8217;s Tomb.
          <% elsif @level >= 46 && @level <= 47 %>
            Unlock a hidden conspiracy in Dagon&#8217;s Temple.
          <% elsif @level >= 48 && @level <= 49 %>
            Explore the jungles of Serpentis Isle!
          <% elsif @level >= 51 && @level <= 52 %>
            New challenges await you in Darkquaver Woods.
          <% elsif @level >= 53 && @level <= 58 %>
            Check out Saleron&#8217;s Sky Garden and its wonderful view of deadly dragons.
          <% elsif @level == 59 %>
            Shandra Manaya and her argon legions have invaded Northern Shara!
          <% elsif @level >= 60 && @level <= 62 %>
            New adventures wait for you in Northern Arun!
          <% elsif @level >= 63 && @level <= 64 %>
            Are you bold enough to enter the Macellarius Catacombs?
          <% elsif @level >= 65 %>
            Check out our featured dungeons, battlegrounds, and guild PvP events!
          <% end %>
        <% else %>
          Welcome to <em>TERA</em>!
        <% end %>
      </span>
    </li>
    <li class="half"><span></span></li>
  </ul>

  <%= render :partial => "/launcher/classes/#{@character["character"]["class"].downcase}" if @character && @character["character"] && @character["character"]["class"] %>

  <div id="gumballs">
    <% if @elite_status %>
      <div class="gumball-elite">
        <a><img src="https://eme04.enmasse-game.com/images/tera/welcome/elite_perks_default.png" width="358" height="521" /></a>
      </div>
    <% else %>
      <div class="gumball-elite">
        <a><img src="https://eme04.enmasse-game.com/images/tera/welcome/elite_upsell.png" width="358" height="521" /></a>
      </div>
    <% end %>
  </div>

</div>
<script type="text/javascript">
  function loadLink(id) {
      try {
        _tera_client_proxy_;
      }
      catch(err) {
        _tera_client_proxy_ = null;
      }
      if (_tera_client_proxy_) {
        var date = new Date();
        date.setTime(date.getTime()+(10*1000));
        var expires = date.toGMTString();
        document.cookie = "current_url" + "=" + window.location + "; expires=" + expires + "; domain=enmasse.com; path=/";

        _tera_client_proxy_.invoke_menu(id);
      }
  }

  var WelcomeWindow = (function() {
    var serverDate = new Date(<%= Time.now.to_i %> * 1000);
    var currserver = <%= @server_id ? @server_id : 4025 %>;
    var nexusUTC = [
      [3, 10, 20],
      [3, 20],
      [3],
      [3, 20],
      [3],
      [3, 20],
      [3, 10, 20]
    ];
    var pveServers = [4004, 4009, 4024, 4025, 4031];
    var alliancePVP = [
      [0, 1, 2, 3, 4, 5, 6, 12, 13, 16, 17, 23 ],
      [0, 1, 2, 3, 4, 5, 6, 12, 13, 16, 17, 23 ],
      [0, 1, 5, 6, 12, 13, 16, 17, 20, 21, 23 ],
      [0, 1, 5, 6, 12, 13, 16, 17, 20, 21, 23 ],
      [0, 1, 2, 3, 4, 5, 6, 12, 13, 16, 17, 20, 21, 23 ],
      [0, 1, 2, 3, 4, 5, 6, 12, 13, 16, 17, 23 ],
      [0, 1, 2, 3, 4, 5, 6, 12, 13, 16, 17, 23 ]
    ];
    var alliancePVE = [
      [0, 1, 4, 5, 12, 13, 15, 16, 19, 23],
      [0, 1, 4, 5, 12, 13, 15, 16, 19, 23],
      [0, 1, 4, 5, 12, 13, 15, 16, 19, 20, 23],
      [0, 1, 4, 5, 12, 13, 15, 16, 19, 20, 23],
      [0, 1, 4, 5, 12, 13, 15, 16, 19, 20, 23],
      [0, 1, 4, 5, 12, 13, 15, 16, 19, 23],
      [0, 1, 4, 5, 12, 13, 15, 16, 19, 23]
    ];

    function addTextShadow() {
      var elements = document.querySelectorAll('h1 strong');
      Array.prototype.forEach.call(elements, function(el, i){
        el.setAttribute('charName', el.innerHTML);
      });
    };

    function getNextAlliance() {
      // allianceTimeTest();
      var hour = getCurrentHour();
      var day = getCurrentDay();
      var nextAlliance = hoursToAlliance(day, hour, currserver);
      var minutesTo = nextAlliance * 60 - getCurrentMinutes();

      // if event is happening now
      if (nextAlliance == 0) {
        return "The alliance territory PvP is in effect!";
      }
      // if the event is happening in a few minutes
      else if (nextAlliance == 1) {
        return "The alliance territory PvP is imminent! You have <b>" + getMinutesLabel(minutesTo) + "</b> to prepare!";
      }
      else {
        var msg = "The next alliance territory PvP starts in <b>" + getHoursLabel(Math.floor(minutesTo/60))
        if (getMinutesLabel(minutesTo % 60) != "") {
          msg += ", " + getMinutesLabel(minutesTo % 60);
        }
        msg += "</b>.";
        return msg;
      }
    }

    function getNextNexus() {
      // Nexus events happen at 2, 9 and 19 UTC
      nexusTimeTests();
      var hour = getCurrentHour();
      var day = getCurrentDay();
      var nextNexus = hoursToNexus(day, hour);
      var minutesTo = nextNexus * 60 - getCurrentMinutes();

      // if event is happening now
      if (nextNexus == 0) {
        return "The nexus invasion is in effect!";
      }
      // if the event is happening in a few minutes
      else if (nextNexus == 1) {
        return "The nexus invasion is imminent! You have <b>" + getMinutesLabel(minutesTo) + "</b> to prepare!";
      }
      else if (nextNexus < 24 ) {
        var msg = "The nexus invasion begins in <b>" + getHoursLabel(Math.floor(minutesTo/60))
        if (getMinutesLabel(minutesTo % 60) != "") {
          msg += ", " + getMinutesLabel(minutesTo % 60);
        }
        msg += "</b>.";
        return msg;
      } else {
        return "The nexus invasion begins in <b>" + getDaysLabel(nextNexus) + "</b>.";
      }


      // return "Getting nexus stuff: " + nexus;
    };

    function nexusTimeTests() {
      // Test should be zero hours
      console.log(hoursToNexus(0, 2)); // 0 hours
      console.log(hoursToNexus(0, 1)); // 1 hour
      console.log(hoursToNexus(0, 6)); // 3 hours
      console.log(hoursToNexus(0, 12)); // 7 hours
      console.log(hoursToNexus(0, 20)); // 6 hours
      console.log(hoursToNexus(1, 5));  // 14 hours
      console.log(hoursToNexus(3, 3));  // 47 hours
      console.log(hoursToNexus(6, 20)); // 6 hours
    };

    function allianceTimeTest() {
      console.log(hoursToAlliance(0, 0, 4025)); // 0 hours;
      console.log(hoursToAlliance(0, 1, 4025)); // 2 hours;
      console.log(hoursToAlliance(0, 1, 4021)); // 0 hours;
      console.log(hoursToAlliance(0, 6)); // 5 hours;
    }

    function getHoursLabel(hours) {
      if (hours > 1) {
        return hours + " hours";
      } if (hours == 1) {
        return hours + " hour";
      } else {
        return "";
      }
    };

    function getMinutesLabel(minutes) {
      if (minutes > 1) {
        return minutes + " minutes";
      } else if (minutes == 1) {
        return minutes + " minute";
      } else {
        return "";
      }
    };

    function getDaysLabel(hours) {
      var days = Math.floor(hours/24);
      hours = hours % 24;
      if (hours == 0) {
        return days + "day";
      }
      return days + "day, " + getHoursLabel(hours);
    }

    function getCurrentHour() {
      return serverDate.getUTCHours();
    };

    function getCurrentMinutes() {
      return serverDate.getUTCMinutes();
    };

    function getCurrentDay() {
      return serverDate.getUTCDay();
    };

    function hoursToNexus(day, hour) {
      var times = nexusUTC[day];
      var hourOffset = 0;
      if (times.length > 0) {
        for (var i = 0; i < times.length; i++ ) {
          if (hour <= times[i]) {
            return times[i] - hour;
          }
        }
      }
      hourOffset = 24 - hour;
      day += 1;
      if (day > 6) {
        day = 0;
      }
      if (nexusUTC[day].length == 0) {
        day += 1;
        hourOffset += 24;
      }
      return nexusUTC[day][0] + hourOffset;
    };

    function hoursToAlliance(day, hour, server) {
      var schedule = getAllianceShedule(server);
      var times = schedule[day];
      var hourOffset = 0;
      if (times.length > 0) {
        for (var i = 0; i < times.length; i++ ) {
          //console.log("time: " + times[i]);
          if (hour <= times[i]) {
            //console.log("Diff: " + (times[i] - hour));
            return times[i] - hour;
          }
        }
      }
      hourOffset = 24 - hour;
      day += 1;
      if (day > 6) {
        day = 0;
      }
      if (schedule[day].length == 0) {
        day += 1;
        hourOffset += 24;
      }
      return schedule[day][0] + hourOffset;
    };

    function getAllianceShedule(server) {
      if (pveServers.indexOf(server) > 0) {
        return alliancePVE;
      }
      return alliancePVP;
    };

    function setAllianceTime(next) {
      var el = document.querySelectorAll('.alliance span');
      el[0].innerHTML = next;
    };

    function setNexusTime(next) {
      var el = document.querySelectorAll('.nexus span');
      el[0].innerHTML = next;
    };

    function resizeWindow() {
      try {
        _tera_client_proxy_;
      }
      catch(err) {
        _tera_client_proxy_ = null;
      }
      if (_tera_client_proxy_) {
        _tera_client_proxy_.resize_to(968,540);
      }
    };

    return {
      // Adds a text shadow to the 
      init: function() {
        resizeWindow();
        addTextShadow();
        //setAllianceTime(getNextAlliance());
        // setNexusTime(getNextNexus());
      }
    }
  }());
  window.onload = function() {
    WelcomeWindow.init();
  }
</script>