<div id="race_hero_wrapper">
<% if @page && @racePageChildren %>
    <% @racePageChildren.each_with_index do |racePageChild, index| %>
      <% if racePageChild["slug"] == @page.slug %>
        <% if @racePageChildren[index-1] != nil %>
          <% previous_item = @racePageChildren[index-1] %>
        <% else %>
          <% 
            current_count = @racePageChildren.count
            previous_item = @racePageChildren[current_count]  
          %>
        <% end %>

        <% if @racePageChildren[index+1]  != nil %>
          <% next_item = @racePageChildren[index+1] %>
        <% else %>
          <% next_item = @racePageChildren[0] %>
        <% end %>

        <div id="raceSubNav">
          <% if previous_item["link_url"] != "" %>

            <% if previous_item.translations %>
              <% previous_item.translations.each do |ptrans| %>
                <% if Globalize.locale.to_s == ptrans.locale.to_s %>
                <a href="/<%= ptrans.locale.to_s %>/game/races/<%= previous_item["link_url"] %>" id="prevRaceBTN">
                  <span>Prev Race:</span>
                  <span class="raceName"><%= previous_item["slug"].titleize.gsub('Page', '') %></span>
                </a>
                <% end %>
              <% end %>
            <% else %>
              <a href="/game/races/<%= previous_item["link_url"] %>" id="prevRaceBTN">
                <span>Prev Race:</span>
                <span class="raceName"><%= previous_item["slug"].titleize.gsub('Page', '') %></span>
              </a>
            <% end %>

          <% else %>

            <% if previous_item.translations %>
              <% previous_item.translations.each do |ptrans| %>
                <% if Globalize.locale.to_s == ptrans.locale.to_s %>
                <a href="/<%= ptrans.locale.to_s %>/game/races/<%= previous_item["slug"] %>" id="prevRaceBTN">
                  <span>Prev Race:</span>
                  <span class="raceName"><%= previous_item["slug"].titleize.gsub('Page', '') %></span>
                </a>
                <% end %>
              <% end %>
            <% else %>
              <a href="/game/races/<%= previous_item["slug"] %>" id="prevRaceBTN">
                <span>Prev Race:</span>
                <span class="raceName"><%= previous_item["slug"].titleize.gsub('Page', '') %></span>
              </a>
            <% end %>

          <% end %>
          
         <!-- <%# if previous_item["link_url"] != "" %>
            <a href="/game/races/<%#= previous_item["link_url"] %>" id="prevRaceBTN">
          <%# else %>
            <a href="/game/races/<%#= previous_item["slug"] %>" id="prevRaceBTN">
          <%# end %>
            <span>Prev Race:</span>
            <span class="raceName"><%#= previous_item["slug"].titleize.gsub('Page', '') %></span>
          </a>-->

          <!--<%# if next_item["link_url"] != "" %>
            <a href="/game/races/<%#= next_item["slug"] %>" id="nextRaceBTN">
          <%# else %>
            <a href="/game/races/<%#= next_item["slug"] %>" id="nextRaceBTN">
          <%# end %>
            <span>Next Race:</span>
            <span class="raceName"><%#= next_item["slug"].titleize.gsub('Page', '') %></span>
          </a>-->



          <!-- new part -->
          <% if next_item["link_url"] != "" %>

            <% if next_item.translations %>
              <% next_item.translations.each do |ptrans| %>
                <% if Globalize.locale.to_s == ptrans.locale.to_s %>
                <a href="/<%= ptrans.locale.to_s %>/game/races/<%= next_item["link_url"] %>" id="nextRaceBTN">
                  <span>Next Race:</span>
                  <span class="raceName"><%= next_item["slug"].titleize.gsub('Page', '') %></span>
                </a>
                <% end %>
              <% end %>
            <% else %>
              <a href="/game/races/<%= next_item["link_url"] %>" id="nextRaceBTN">
                <span>Next Race:</span>
                <span class="raceName"><%= next_item["slug"].titleize.gsub('Page', '') %></span>
              </a>
            <% end %>

          <% else %>

            <% if next_item.translations %>
              <% next_item.translations.each do |ptrans| %>
                <% if Globalize.locale.to_s == ptrans.locale.to_s %>
                <a href="/<%= ptrans.locale.to_s %>/game/races/<%= next_item["slug"] %>" id="nextRaceBTN">
                  <span>Next Race:</span>
                  <span class="raceName"><%= next_item["slug"].titleize.gsub('Page', '') %></span>
                </a>
                <% end %>
              <% end %>
            <% else %>
              <a href="/game/races/<%= next_item["slug"] %>" id="nextRaceBTN">
                <span>Next Race:</span>
                <span class="raceName"><%= next_item["slug"].titleize.gsub('Page', '') %></span>
              </a>
            <% end %>

          <% end %>
          <!-- end new part -->

        </div>
      <% end %>
    <% end %>
<% else %>
    <div id="raceSubNav">
      <a href="/game/races" id="prevRaceBTN">
        <span>Return to all Races</span>
      </a>
    </div>
<% end %>
  </div><!-- end wrapper -->         
