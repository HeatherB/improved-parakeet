<nav id='locale'>
  <% ::Refinery::I18n.frontend_locales.each do |locale| %>
    <% if Globalize.locale.to_s == locale.to_s %>
      <span class="<%= locale %> selected">
        <%= link_to_if Globalize.locale.to_s != locale.to_s, t(locale), {:locale => locale} %>
      </span>
    <% end %>
  <% end %>

    <div class="wrap">

      <% if is_newscats? %>
        <% ::Refinery::I18n.frontend_locales.each do |locale| %>
          <% if Globalize.locale.to_s != locale.to_s %>
            <span class="<%= locale %>">
              <a href="/<%= locale %>/news/categories/<%= @current_platform_filter %>"><%= t(locale) %></a>
            </span>
          <% end %>
        <% end %>
      <% end %>

      
     <!-- <%# if is_newsposts? %>
        <%# ::Refinery::I18n.frontend_locales.each do |locale| %>
          <%# if Globalize.locale.to_s != locale.to_s %>
            <span class="<%#= locale %>">
              <a href="/<%#= locale %>/news/posts/<%#= @post.id %>"><%#= t(locale) %></a>
            </span>
          <%# end %>
        <%# end %>
      <%# end %>-->


      <% if is_newsposts? %>
        <% if @available_locale_this_post %>
          <% @available_locale_this_post.each do |locale| %>
              <% if Globalize.locale.to_s != locale.locale.to_s %>
                <span class="<%= locale.locale.to_s %>">
                  <a href="/<%= locale.locale.to_s %>/news/posts/<%= @post.id %>"><%= t(locale.locale.to_s) %></a>
                </span>
              <% end %>
          <% end %>
        <% end %>
      <% end %>
       
    </div>

</nav>
