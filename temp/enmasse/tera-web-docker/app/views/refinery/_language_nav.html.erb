<nav id='locale'>
  <% ::Refinery::I18n.frontend_locales.each do |locale| %>
    <% if Globalize.locale.to_s == locale.to_s %>
      <span class="<%= locale %> selected">
        <%= link_to_if Globalize.locale.to_s != locale.to_s, t(locale), {:locale => locale} %>
      </span>
    <% end %>
  <% end %>
  <div class="wrap">
    <% ::Refinery::I18n.frontend_locales.each do |locale| %>
    <% if Globalize.locale.to_s != locale.to_s %>
      <span class="<%= locale %>">
        <%= link_to_if Globalize.locale.to_s != locale.to_s, t(locale), {:locale => locale} %>
      </span>
    <% end %>
  <% end %>
  </div>
</nav>