<section id="twitch_section">

  <div class="inner_wrapper">
	  <h3>Live <span>Stream</span></h3>
		  <article class="stream_area">
		    <div class="inner2">
		      
		      <div class="stream_view_area" id="twitch_main">
		        <div class="vedio_area videoWrapper">
		          <div id="screen"></div>
		        </div>
		        <div class="stream_info">
		        </div>
		      </div>

		      <div class="stream_list_area" id="twitch_sidebar">
		        <div class="tab_area">
		          <button type="button" class="partners on" onclick="changeStreamTab(this);"><span class="sp_sub">PARTNERS</span></button>
		          <button type="button" class="streamers" onclick="changeStreamTab(this);"><span class="sp_sub">STREAMERS</span></button>
		        </div>
		        <div class="stream_list scrollbar-inner">
		          
		          <ul id="partnerStreams"></ul>
		          <ul id="streams" style="display:none;"></ul>
		        </div>
		        <a href="https://go.twitch.tv/directory/game/TERA" class="btn_live_view" style="display:none;" target="_blank" title="Opened in new window"><span class="count" id="totalStreams">0</span><span class="sp_sub">LIVE</span></a>
		      </div>
		    </div>
        <div class="twitch_banner">
          <a href="/">
            <img src="/assets/twitch_btn.png" alt="EnMasse on Twitch" />
          </a>
        </div>
		  </article>
</section>
<script id="streamTemplate" type="text/x-jquery-tmpl">
  <li>
    <a class="img_wrap" onclick="playTwitch('${channel_name}', '${video_id}', '${clip_id}', 640, 360, true)">
      <img src="${preview_img_url}" class="img_wrap">
      {{if type == 'stream'}}
        <strong class="label sp_sub">LIVE</strong>
      {{/if}}
    </a>
    <div class="img_caption">
      <h4 class="stream_title"><a onclick="playTwitch('${channel_name}', '${video_id}', '${clip_id}', 640, 360, true)">{{html title}}</a></h4>
      <p class="channel_name">${channel_name}</p>
      <p class="viewer">
        {{if viewers}}
          <span class="view_count">${viewers}</span>
        {{else}}
          <span class="view_count">${views}</span>
        {{/if}}
      </p>
      <div class="">
        {{if partner}}
          <span>Level : ${partner.level}</span>
          <span>EME master account : ${partner.eme_master_account}</span>
        {{/if}}
      </div>
    </div>
  </li>
</script>
<script id="streamInfoTemplate" type="text/x-jquery-tmpl">
  <a href="#" class="img_wrap" target="_blank" title="Opened in new window"><img src="${channel_logo}" style="height: 100%; width: 100%; object-fit: contain;" alt=""></a>
  <div class="img_caption">
    <strong class="stream_title">{{html title}}</strong>
    <p class="channel_name">${channel_name}</p>
    {{if viewers}}
      <p class="viewer">Viewer<span class="view_count">${viewers}</span></p>
    {{else}}
      <p class="viewer">Views<span class="view_count">${views}</span></p>
    {{/if}}
    <div class="share_area">
      {{if partner}}
        <span>Level : ${partner.level}</span>
        <br>
        <span>EME master account : ${partner.eme_master_account}</span>
      {{/if}}
    </div>
  </div>
</script>