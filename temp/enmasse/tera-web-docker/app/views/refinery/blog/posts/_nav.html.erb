  <nav id="blog_nav">
    
      <div class="post_tab">
        <%# if @post.prev.present? && @post.prev.live? -%>
          <%#= link_to raw(@post.prev.title).truncate(20),
                      refinery.blog_post_path(@post.prev),
                      :class => 'previous' %>
        <%# end %>
        <% if @available_locale_previous_post %>
          <% @available_locale_previous_post.each do |locale| %>
              <% if Globalize.locale.to_s == locale.locale.to_s %>
                <% if @post_previous.live? %>
                <a href="/<%= locale.locale.to_s %>/news/posts/<%= @post_previous.id %>"><%= raw(@post_previous.title).truncate(20) %></a>
                <% end %>
              <% end %>
          <% end %>
        <% end %>
      </div>
    
    
    <div class="post_tab">
      <%= link_to t('blog_home', :scope => 'refinery.blog.posts.show'),
                    refinery.blog_root_path(),
                    :class => 'blog_home' %>
    </div>

    

      <div class="post_tab">
        <%# if @post.next.present? && @post.next.live? -%>
          <%#= link_to raw(@post.next.title).truncate(20),
                      refinery.blog_post_path(@post.next),
                      :class => 'nextpost' %>
        <%# end %>
        <% if @available_locale_next_post %>
          <% @available_locale_next_post.each do |locale| %>
              <% if Globalize.locale.to_s == locale.locale.to_s %>
                <% if @post_next.live? %>
                <a href="/<%= locale.locale.to_s %>/news/posts/<%= @post_next.id %>"><%= raw(@post_next.title).truncate(20) %></a>
                <% end %>
              <% end %>
          <% end %>
        <% end %>
      </div>
    
  </nav><!-- /next_prev_article -->

