 <section id="filter-bar">
  <div class="inner_wrapper">
    
    <%= render :partial => "/refinery/fake_language_nav" %>
  </div><!-- end of inner wrapper -->
</section>

<section id="content_article_header">
  <div class="byline">
    <% if @post.categories.any? %>
    <div class="blog_cats_area">
      <% @post.categories.each do |cat| %>
      <span class="blog_cat_wrapper <%= cat.title.downcase %>">
        <span class="blog_cat"><%= cat.title %></span>
      </span>
      <% end %>
    </div>
    <% end %>

    <span class="details">
      <time datetime="Feb 02, 2018" class="posted_at">Posted on <%=l @post.published_at.to_date, :format => "%b %d, %Y" %></time> by <%= @post.author %>
    </span>
  </div>

    <h1><%= raw @post.title %></h1>

  <% if @post.news_hero_field.present? %>
    <% postVisual = @post['news_hero_field']
       if postVisual.include? "https://www.youtube.com/embed/" %>
        <div class="videoWrapper">
          <iframe src="<%= @post.news_hero_field %>" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
        </div>
    <% else %>
        <%= image_tag(@post.news_hero_field) %>
    <% end %>
  <% end %>

    <%# if @post.news_hero_field.present? %>
      <%# if @post.news_hero_field.is_image? %>
        <%#= image_tag(@post.news_hero_field) %>
      <%# elsif @post.news_hero_field.is_video? %>
        <!--<div class="videoWrapper">
          <iframe src="<%#= @post.news_hero_field %>" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
        </div>-->
      <%# end %>
    <%# else %>
    <%# end %>

</section>

<div id="main-wrapper">
  <!--<section id="content_side_body">
    <div id="posts_sidebar">
      <h4>Recent Posts</h4>
      <div class="article_wrapper">
        <%#= render :partial => "/refinery/blog/shared/post_sidebar", :collection => @posts_trunc %>
      </div>
    </div>
  </section>-->


  <section id="content_wide_body">
  

   <!-- <span class="newsWrapper"><a id="news-button" href="/news">Back to News</a></span>-->
    
    <div class="blog-post"> 
      <div class="inner"> 
        
             
       
          <div class="content"><%= @post.body.html_safe %></div>

          <!--<div class="post-socials">
          <h4>Share</h4>
          <%#= request.original_url %>
          <ul>
            <li class="share-facebook"><a href="https://www.facebook.com/sharer/sharer.php?u=https://tera.enmasse.com/" id="share-facebook" target="_blank"></a></li>
           
            <li class="share-twitter"><a href="https://twitter.com/share" class="twitter-share-button" data-show-count="false" target="_blank"></a></li>
          </ul>
        </div>-->



        <%= render 'nav' if next_or_previous?(@post) %>
       

        
      </div>
    </div>
    <%= render '/refinery/draft_page_message' unless @post.nil? or @post.live? -%>
  </section>
</div><!-- end of main wrapper -->
  <% content_for :twittercard do %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@TERA">
    <meta name="twitter:title" content="<%= @post.title %>">
    <meta name="twitter:description" content="<%= strip_tags(blog_post_teaser(@post)) %>">

    <% if @post.teaser_img_field.present? %>
      <meta name="twitter:image" content="<%= @post.teaser_img_field %>">
    <% else %>
      <meta name="twitter:image" content="https://eme04.enmasse-game.com/images/tera/share/tera.jpg">
    <% end %>
  <% end %>

  <% content_for :facebookcard do %>
     <meta property="og:title" content="<%= @post.title %>" />
     <meta property="og:site_name" content="TERA"/> 
     <meta property="og:url" content="<%= request.original_url %>" /> 
     <meta property="og:description" content="<%= strip_tags(blog_post_teaser(@post)) %>" />
   
     <% if @post.teaser_img_field.present? %>
       <meta property="og:image" content="<%= @post.teaser_img_field %>" />
     <% else %>
       <meta property="og:image" content="https://eme04.enmasse-game.com/images/tera/share/tera.jpg" />
     <% end %>
  <% end %>