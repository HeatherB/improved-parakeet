<% if @categories != nil and @categories.any? %>
<nav class="category_nav" id="filter-platform">
  <div id='categories'>
    <!--<span data-platform="all">
      <%#= link_to "All", refinery.blog_root_path(), :selected_category_filter => "all" %>
    </span>-->
    <% @categories.order(:id).reverse.each do |category| %>
    <%#= @category.inspect %>
    <% if(category.title.downcase == 'featured') %>
    <%# elsif(category.title.downcase == 'all') %>
    <% else %>
      <span data-platform="<%= category.title.downcase %>" <%= " class=selected " if @category.present? and @category.id == category.id %>>
        <%#= link_to "#{category.title}", refinery.blog_category_path(category), :selected_category_filter => category.title.downcase  %>
        <%= link_to t('platform_' + category.title.downcase), refinery.blog_category_path(category), :selected_category_filter => category.title.downcase  %>
        </span>
      <% end %>
    <% end %>
  </div>
 </nav>
<% end %>