<% content_for :currPageCallout do %>
  <body class="home">
<% end %>

<div id="home-content">
  <section id="content_article_header">
    <% if @page.content_for(:article_header) %>
      <%= render :partial => "/refinery/blog/shared/home_slide.html.erb" %>
    <% else %>
      <!-- no home slides -->
    <% end %>
  </section>

  <section id="navigation">
    <%= Refinery::Pages::MenuPresenter.new(refinery_menu_pages, self).to_html %>
  </section>

<section id="filter-bar">
    <div class="inner_wrapper">
      <%#= render :partial => "/refinery/blog/shared/categories" %>
      <div id="filter-platform">
        <span data-platform="all" class="filter-all homefilter"><%=t :platform_all %></span>
        <span data-platform="windows" class="filter-windows homefilter"><%=t :platform_windows %></span>
        <span data-platform="playstation" class="filter-playstation homefilter"><%=t :platform_playstation %></span>
        <span data-platform="xbox" class="filter-xbox homefilter"><%=t :platform_xbox %></span>
      </div>
      <hr />
      <!-- language selection -->
      <%= render :partial => "/refinery/language_nav" %>
    </div><!-- end of inner wrapper -->
  </section>
  
  <section id="content_wide_body">
    <div class="inner_wrapper" id="featured-posts">
        <% if @posts_featured && @posts_featured.any? %>
          <%= render :partial => "/refinery/blog/shared/post_featured", :collection => @posts_featured %>
        <% end %>
    </div><!-- end of inner wrapper -->
  </section>


  <div id="content_wrap">
    <section id="content_body">
      <div id="news-posts">
        <% if @home_posts && @home_posts.any? %>
          <%#= render :partial => "/refinery/blog/shared/categories" %>
            <%= render :partial => "/refinery/blog/shared/post", :collection => @home_posts %>
            <%#= will_paginate @homeposts %>
        <% else %>
          <p class="alone"><%=t :no_blog_articles_yet %></p>
        <% end %>
      </div><!-- end of news posts -->
      <%= link_to "#{t "btn_allnews"}", ('/' + locale.to_s + '/news'), :class => "more-btn" %>
    </section>
   
    <section id="content_side_body">
      <!-- twitter widget goes here -->
      <div class="twitter_feed">
        <h3><img src="/assets/icons/tera-logo-small.png" alt="TERA" /> <span><img src="/assets/icons/official-twitter-label.png" alt="Official Twitter" /></span></h3>
        <a class="twitter-timeline" href="https://twitter.com/TERAonline?ref_src=twsrc%5Etfw"><!--Tweets by TERAonline--></a> <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
        <a href="https://twitter.com/TERAonline" target="_blank" class="more-btn"><%=t :btn_readmore %></a>
      </div><!-- end of twitter feed -->
        <%= raw @page.content_for(:side_body) || yield(:side_body) %>
        <a href="https://discordapp.com/invite/EME" class="discordBTN"><img src="/assets/icons/discordBTN.png" alt="Join Us on Discord" /></a>
    </section>
  </div><!-- end of cotnent_wraper -->

  <section id="content_article_footer">
    <div class="inner_wrapper">
    <%= raw @page.content_for(:article_footer) || yield(:article_footer) %>
    </div><!-- end of inner wrapper -->
  </section>

<!-- twicth widget -->
  <%#= render :partial => "refinery/twitch" %>
</div>

<div id="locale_listing"><%= I18n.locale %></div>

<% content_for :bodyscripts do %>
<script>

</script>
<% end %>