<% if @servers['PC'].length > 0 %>
<div class="server_stat_block pc" data-filter-platform="windows">
  <span class="server_plat"></span>
  <span class="server_stat">
    <h3>PC Server Status</h3>
    <table>
      <thead>
        <tr>
          <th>Status</th>
          <th>Server</th>
          <th>Type</th>
          <th>Population</th>
        </tr>
      </thead>
      <tbody>

      <% @servers['PC'].each do |server| %>
        <tr>
          <td>
          <% if server['maintenance'] %>
            <div class="maint">
              <span class="dot"></span> 
              Under Maintenance
            </div>
          <% else %>
            <div class="status_standing <%= server['running'] ? 'up' : 'down' %>">
              <span class="dot"></span> 
              <%= server['running'] ? 'UP' : 'DOWN' %>
            </div>
          <% end %>
          </td>
          <td><%= server['name'] %></td>
          <td><%= server['category'] %></td>
          <% 
            if server['current_ccu_threshold_key'] === nil
              ccu_threshold = "low"
            else
              ccu_threshold_key = server['current_ccu_threshold_key'].to_s
              ccu_threshold = ccu_threshold_key.gsub(/ccu_threshold_/, '')
            end
          %>
          <td>
            <% if server['maintenance'] %>
            <% else %>
              <%= ccu_threshold %>
            <% end %>
          </td>
        </tr>
      <% end %>
      
      </tbody>
    </table>
  </span>
</div>
<% end %>

