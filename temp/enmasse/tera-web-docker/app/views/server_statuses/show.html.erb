<section id="navigation" class="serverstatuses">
  <%= Refinery::Pages::MenuPresenter.new(refinery_menu_pages, self).to_html %>
</section>

<section id="filter-bar" class="serverstatuses">
  <div class="inner_wrapper">
    <div id="filter-platform">
      <span data-platform="all" class="filter-all interiorfilter"><%=t :platform_all %></span>
      <span data-platform="windows" class="filter-windows interiorfilter"><%=t :platform_windows %></span>
      <span data-platform="playstation" class="filter-playstation interiorfilter"><%=t :platform_playstation %></span>
      <span data-platform="xbox" class="filter-xbox interiorfilter"><%=t :platform_xbox %></span>
    </div>

    <!-- language selection -->
    <%= render :partial => "/refinery/language_nav" %>
  </div><!-- end of inner wrapper -->
</section>

