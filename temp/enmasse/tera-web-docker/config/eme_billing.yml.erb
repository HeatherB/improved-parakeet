eme_billing:
  url: "<%= "#{fetch(:billing_adapter_service_url)}:#{fetch(:billing_adapter_service_port)}" %>"
  ssl: <%= fetch(:billing_adapter_use_ssl) %>
  name: "<%= "#{fetch(:billing_adapter_name)}" %>"
  use_memcache: <%= fetch(:billing_adapter_use_memcache) %>
  memcache_hosts:
  <% fetch(:billing_adapter_memcached_servers).each do |ms| %>
    - "<%= ms %>:<%= fetch(:billing_adapter_memcached_port) %>"
  <% end %>
  cache_prefix: "<%= "#{fetch(:billing_adapter_cache_prefix)}" %>"
  type: <%= fetch(:billing_adapter_type) %>
  purchase_item_url: "<%= "#{fetch(:billing_adapter_root_url)}/#{fetch(:billing_adapter_purchase_item_url)}" %>"
  purchase_url: "<%= "#{fetch(:billing_adapter_root_url)}/#{fetch(:billing_adapter_purchase_url)}" %>"
