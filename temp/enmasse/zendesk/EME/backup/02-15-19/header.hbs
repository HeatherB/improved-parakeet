<header class="header">
  <div class="inner">
    <div class="leftCol">
      <div class="logo">
        {{#link 'help_center'}}
          <img src="{{settings.logo}}" alt="{{t 'home_page' name=help_center.name}}">
        {{/link}}
      </div>
    
      <div id="games">
        <a href="#" onclick="return false" class="trigger"><span>Games</span></a>
        <ul class="eme-menu">
          <li class="games-link tera"><a href="http://tera.enmasse.com"><span>Windows / XBOX ONE / PS4</span></a></li>
          <li class="games-link kritika"><a href="http://www.playkritika.com"><span>Windows</span></a></li>
          <li class="games-link closers"><a href="http://closers.enmasse.com"><span>Windows</span></a></li>
          <li class="games-link breach"><a href="http://enmasse.com/games/breach"><span>Windows</span></a></li>
        </ul>
      </div>
    </div>
  
    <div class="rightCol">  
      <div class="nav-wrapper">
        <span class="icon-menu" tabindex="0" role="button" aria-controls="user-nav" aria-expanded="false" aria-label="{{t 'toggle_navigation'}}"></span>
        <nav class="user-nav" id="user-nav">
          {{link 'community'}}
          {{link 'new_request' class='submit-a-request'}}
        </nav>
        {{user_info}}
      </div>
    </div>
  </div>
</header>
